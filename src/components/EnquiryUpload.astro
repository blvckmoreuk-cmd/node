---
// Optional files group for the enquiry forms: Route A (direct upload, chunked into Netlify Blobs)
// and Route B (share link for bigger files). The file input has no name, so the file never
// goes through Netlify Forms. The hidden `upload_link` and `upload_name` fields carry the
// stored file's link. Inputs render statically so Netlify detects them at deploy time. Validation: src/scripts/enquiry-upload.ts
interface Props {
  class?: string;
  columns?: 'one' | 'two';
}
const { class: className = '', columns = 'one' } = Astro.props;
const gridCols = columns === 'two' ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1';
---

<div class:list={['grid grid-cols-1 gap-5', className]} data-enquiry-upload>
  <input type="hidden" name="upload_link" value="" />
  <input type="hidden" name="upload_name" value="" />
  <div>
    <span class="field-label">Your track</span>
    <p class="font-body text-base leading-relaxed text-fg-dim max-w-2xl">Upload your track here, or paste a link to your stems or session. Add both if you like.</p>
  </div>

  <div class:list={['grid gap-5', gridCols]}>
    <fieldset class="border border-line-strong p-4 min-w-0">
      <legend class="px-1 font-body text-sm font-medium text-fg-muted">Upload a file</legend>
      <label for="attachment" class="field-label">Audio file</label>
      <input type="file" id="attachment" accept=".wav,.aif,.aiff,.flac,.mp3,.zip,audio/*,application/zip" class="field" aria-describedby="attachment-help attachment-status attachment-error" />
      <p id="attachment-help" class="mt-2.5 font-body text-base leading-relaxed text-fg-dim">One WAV, AIFF, FLAC, MP3 or ZIP file, up to 500 MB. For a full session or stems, zip them first. The file uploads when you send the form, so please keep this page open until it finishes.</p>
      <p id="attachment-status" aria-live="polite" class="mt-2.5 font-body text-base text-fg-muted break-words empty:hidden"></p>
      <button type="button" id="attachment-clear" class="key mt-3" hidden>Remove file</button>
      <p id="attachment-error" role="alert" hidden class="mt-3 text-fg font-body text-base border-l-2 border-fg pl-3"></p>
    </fieldset>

    <fieldset class="border border-line-strong p-4 min-w-0">
      <legend class="px-1 font-body text-sm font-medium text-fg-muted">Share a link for bigger files</legend>
      <label for="project_link" class="field-label">Link to your files</label>
      <input type="url" id="project_link" name="project_link" inputmode="url" autocomplete="off" spellcheck="false" class="field" aria-describedby="project_link-help project_link-error" />
      <p id="project_link-help" class="mt-2.5 font-body text-base leading-relaxed text-fg-dim">Paste a WeTransfer, Google Drive or Dropbox link if your files are bigger than 500 MB or already shared. Set sharing to &ldquo;anyone with the link&rdquo; so we can open it.</p>
      <p id="project_link-error" role="alert" hidden class="mt-3 text-fg font-body text-base border-l-2 border-fg pl-3"></p>
    </fieldset>
  </div>
</div>

<style is:global>
  input[type="file"].field::file-selector-button {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-fg);
    background: var(--color-raised);
    border: 1px solid var(--color-line-strong);
    border-radius: 0;
    padding: 0.4rem 0.75rem;
    margin-right: 0.75rem;
    cursor: pointer;
  }
  input[type="file"].field::file-selector-button:hover { border-color: var(--color-fg); }
  .field[aria-invalid="true"] { border-color: var(--color-fg); }
  .field[aria-invalid="true"]:focus { border-color: var(--color-accent); }
</style>

<script>
  import { initEnquiryUpload } from '../scripts/enquiry-upload';
  document.querySelectorAll<HTMLElement>('[data-enquiry-upload]').forEach((el) => {
    const form = el.closest('form');
    if (form) initEnquiryUpload(form);
  });
</script>
