---
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Shop', href: '/shop' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Contact', href: '/contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const leftItems = navItems.slice(0, 3);
const rightItems = navItems.slice(3);
---

<header class="w-full px-3 sm:px-6 md:px-10 py-3 sm:py-4 font-mono border-b border-line">
  <div class="max-w-4xl mx-auto relative flex items-center justify-between gap-2 sm:gap-4">

    <a href="/" class="absolute left-1/2 -translate-x-1/2 flex items-center no-underline">
      <span class="text-[1rem] sm:text-xl md:text-2xl font-display font-bold tracking-[0.18em] text-fg uppercase">Node</span>
      <span class="absolute left-full ml-2.5 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_6px_rgba(47,111,237,0.8)]"></span>
    </a>

    <nav aria-label="Site navigation" class="flex items-center justify-start gap-3 sm:gap-6 md:gap-9">
      {leftItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a href={item.href} class="group flex flex-col items-center gap-1.5 no-underline">
            <span class={`relative w-9 h-4 rounded-full border flex items-center px-0.5 transition-colors duration-200 ${isActive ? 'border-accent/50 bg-[#12233f]' : 'border-[#2a2f37] bg-[#14181d] group-hover:border-[#3d4550]'}`}>
              <span class={`block w-3 h-3 rounded-full transition-all duration-200 ${isActive
                ? 'translate-x-4.5 bg-accent shadow-[0_0_6px_rgba(47,111,237,0.7)]'
                : 'translate-x-0 bg-[#5a6472] group-hover:translate-x-4.5 group-hover:bg-accent group-hover:shadow-[0_0_6px_rgba(47,111,237,0.7)]'}`}></span>
            </span>
            <span class={`text-[7px] sm:text-[9px] font-medium uppercase tracking-wider sm:tracking-[0.25em] whitespace-nowrap transition-colors duration-200 ${isActive ? 'text-fg' : 'text-fg-faint group-hover:text-fg'}`}>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <nav aria-label="Site navigation" class="flex items-center justify-end gap-3 sm:gap-6 md:gap-9">
      {rightItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a href={item.href} class="group flex flex-col items-center gap-1.5 no-underline">
            <span class={`relative w-9 h-4 rounded-full border flex items-center px-0.5 transition-colors duration-200 ${isActive ? 'border-accent/50 bg-[#12233f]' : 'border-[#2a2f37] bg-[#14181d] group-hover:border-[#3d4550]'}`}>
              <span class={`block w-3 h-3 rounded-full transition-all duration-200 ${isActive
                ? 'translate-x-4.5 bg-accent shadow-[0_0_6px_rgba(47,111,237,0.7)]'
                : 'translate-x-0 bg-[#5a6472] group-hover:translate-x-4.5 group-hover:bg-accent group-hover:shadow-[0_0_6px_rgba(47,111,237,0.7)]'}`}></span>
            </span>
            <span class={`text-[7px] sm:text-[9px] font-medium uppercase tracking-wider sm:tracking-[0.25em] whitespace-nowrap transition-colors duration-200 ${isActive ? 'text-fg' : 'text-fg-faint group-hover:text-fg'}`}>{item.label}</span>
          </a>
        );
      })}
    </nav>

  </div>
</header>