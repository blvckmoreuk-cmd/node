---
import Logo from './Logo.astro';

const navItems = [
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Prices', href: '/prices/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Contact', href: '/contact/' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const leftItems = navItems.slice(0, 3);
const rightItems = navItems.slice(3);
const groups = [
  { items: leftItems, align: 'sm:justify-end', col: 'sm:col-start-1 sm:row-start-1' },
  { items: rightItems, align: 'sm:justify-start', col: 'sm:col-start-3 sm:row-start-1' },
];
---

<header class="w-full px-3 sm:px-6 md:px-10 py-3 sm:py-4 font-body border-b border-line-strong bg-page">
  <div class="max-w-4xl mx-auto grid grid-cols-6 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-x-1 gap-y-3 sm:gap-4 md:gap-6">

    <a href="/" class="col-span-6 sm:col-span-1 sm:col-start-2 row-start-1 justify-self-center flex items-center gap-2 sm:gap-3 shrink-0 no-underline" aria-label="Node Production, home">
      <Logo variant="mark" class="w-7 h-7 sm:w-8 sm:h-8 shrink-0" />
      <Logo />
    </a>

    {groups.map((group) => (
      <nav aria-label="Site navigation" class={`${group.col} ${group.align} contents sm:grid sm:grid-flow-col sm:auto-cols-[5rem] lg:auto-cols-[6rem] sm:items-center`}>
        {group.items.map((item) => {
          const isActive = currentPath === item.href.replace(/\/$/, '');
          return (
            <a href={item.href} aria-current={isActive ? 'page' : undefined} class="group flex flex-col items-center gap-1.5 min-w-0 no-underline">
              <span class={`relative w-10 h-4 sm:h-5 border flex items-center px-0.5 transition-colors duration-200 ${isActive ? 'border-accent bg-raised' : 'border-line-strong bg-inset group-hover:border-cell-line'}`}>
                <span class={`block w-3 h-3 sm:w-4 sm:h-4 transition-all duration-200 ${isActive
                  ? 'translate-x-5.5 sm:translate-x-4.5 bg-accent'
                  : 'translate-x-0 bg-cell-grey group-hover:translate-x-5.5 sm:group-hover:translate-x-4.5 group-hover:bg-accent'}`}></span>
              </span>
              <span class={`text-sm font-medium whitespace-nowrap underline-offset-4 group-hover:underline group-focus-visible:underline transition-colors duration-200 ${isActive ? 'text-fg' : 'text-fg-dim group-hover:text-fg'}`}>{item.label}</span>
            </a>
          );
        })}
      </nav>
    ))}

  </div>
</header>
