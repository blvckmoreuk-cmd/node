---
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Contact', href: '/contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const leftItems = navItems.slice(0, 2);
const rightItems = navItems.slice(2);
---

<header class="w-full px-3 sm:px-6 md:px-10 py-3 sm:py-4 font-mono border-b border-[#14171c]">
  <div class="max-w-4xl mx-auto relative flex items-center justify-between gap-2 sm:gap-4">

    <a href="/" class="absolute left-1/2 -translate-x-1/2 flex items-center no-underline">
      <span class="text-base sm:text-xl md:text-2xl font-bold tracking-[0.18em] text-[#e7e7ea] uppercase">Node</span>
      <span class="absolute left-full ml-2.5 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
    </a>

    <nav aria-label="Site navigation" class="flex items-center justify-start gap-3 sm:gap-6 md:gap-9">
      {leftItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a href={item.href} class="group flex flex-col items-center gap-1.5 no-underline">
            <span class={`relative w-9 h-4 rounded-full border flex items-center px-0.5 transition-colors duration-200 ${isActive ? 'border-[#10b981]/50 bg-[#0d1411]' : 'border-[#23272e] bg-[#0c0e11] group-hover:border-[#3a4049]'}`}>
              <span class={`block w-3 h-3 rounded-full transition-all duration-200 ${isActive
                ? 'translate-x-4.5 bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.7)]'
                : 'translate-x-0 bg-[#3a4049] group-hover:translate-x-4.5 group-hover:bg-[#10b981] group-hover:shadow-[0_0_6px_rgba(16,185,129,0.7)]'}`}></span>
            </span>
            <span class={`text-[7px] sm:text-[9px] font-medium uppercase tracking-wider sm:tracking-[0.25em] whitespace-nowrap transition-colors duration-200 ${isActive ? 'text-[#e7e7ea]' : 'text-[#52555c] group-hover:text-[#e7e7ea]'}`}>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <nav aria-label="Site navigation" class="flex items-center justify-end gap-3 sm:gap-6 md:gap-9">
      {rightItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a href={item.href} class="group flex flex-col items-center gap-1.5 no-underline">
            <span class={`relative w-9 h-4 rounded-full border flex items-center px-0.5 transition-colors duration-200 ${isActive ? 'border-[#10b981]/50 bg-[#0d1411]' : 'border-[#23272e] bg-[#0c0e11] group-hover:border-[#3a4049]'}`}>
              <span class={`block w-3 h-3 rounded-full transition-all duration-200 ${isActive
                ? 'translate-x-4.5 bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.7)]'
                : 'translate-x-0 bg-[#3a4049] group-hover:translate-x-4.5 group-hover:bg-[#10b981] group-hover:shadow-[0_0_6px_rgba(16,185,129,0.7)]'}`}></span>
            </span>
            <span class={`text-[7px] sm:text-[9px] font-medium uppercase tracking-wider sm:tracking-[0.25em] whitespace-nowrap transition-colors duration-200 ${isActive ? 'text-[#e7e7ea]' : 'text-[#52555c] group-hover:text-[#e7e7ea]'}`}>{item.label}</span>
          </a>
        );
      })}
    </nav>

  </div>
</header>