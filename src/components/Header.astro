---
import Logo from './Logo.astro';

const navItems = [
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Contact', href: '/contact/' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const leftItems = navItems.slice(0, 3);
const rightItems = navItems.slice(3);
const groups = [
  { items: leftItems, align: 'justify-start' },
  { items: rightItems, align: 'justify-end' },
];
---

<header class="w-full px-3 sm:px-6 md:px-10 py-3 sm:py-4 font-mono border-b border-line-strong bg-page">
  <div class="max-w-4xl mx-auto relative flex items-center justify-between gap-2 sm:gap-4">

    <a href="/" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-3 no-underline" aria-label="Node Production, home">
      <Logo variant="mark" class="w-7 h-7 sm:w-8 sm:h-8 shrink-0" />
      <Logo class="hidden sm:inline-flex" />
    </a>

    {groups.map((group) => (
      <nav aria-label="Site navigation" class={`flex items-center ${group.align} gap-3 sm:gap-6 md:gap-9`}>
        {group.items.map((item) => {
          const isActive = currentPath === item.href.replace(/\/$/, '');
          return (
            <a href={item.href} aria-current={isActive ? 'page' : undefined} class="group flex flex-col items-center gap-1.5 no-underline">
              <span class={`relative w-10 h-4 sm:h-5 border flex items-center px-0.5 transition-colors duration-200 ${isActive ? 'border-accent bg-raised' : 'border-line-strong bg-inset group-hover:border-cell-line'}`}>
                <span class={`block w-3 h-3 sm:w-4 sm:h-4 transition-all duration-200 ${isActive
                  ? 'translate-x-5.5 sm:translate-x-4.5 bg-accent'
                  : 'translate-x-0 bg-cell-grey group-hover:translate-x-5.5 sm:group-hover:translate-x-4.5 group-hover:bg-accent'}`}></span>
              </span>
              <span class={`text-[9px] sm:text-[11px] font-medium uppercase tracking-wider sm:tracking-[0.25em] whitespace-nowrap transition-colors duration-200 ${isActive ? 'text-fg' : 'text-fg-faint group-hover:text-fg'}`}>{item.label}</span>
            </a>
          );
        })}
      </nav>
    ))}

  </div>
</header>
