---
// Shared page masthead: a sentence-case Archivo headline in cream, optional
// intro copy, and a 2×16 step grid whose armed step is the single orange
// element in the region.
import StepGrid from './StepGrid.astro';
---
<header class="border-b border-line-strong">
  <div class="px-4 md:px-8 pt-10 md:pt-16 pb-6 md:pb-8">
    <h1 class="t-display text-4xl md:text-[3.5rem]"><slot name="title" /></h1>
    <div class="mt-4 md:mt-5 max-w-xl font-body text-base md:text-lg leading-relaxed text-fg-muted"><slot /></div>
  </div>
  <div class="px-4 md:px-8 pb-6 md:pb-8">
    <StepGrid fluid class="max-w-[520px]" />
  </div>
</header>
