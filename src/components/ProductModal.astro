---
// Shared product detail panel. Drop <ProductModal /> on any page whose cards
// carry the data-* attributes below and a `.product-card` class; the script
// wires every matching button to open this dialog. The Buy button is inert for
// now — Stripe Checkout gets wired to `#modal-buy` later.
---

<div id="product-modal" class="fixed inset-0 z-50 hidden items-center justify-center px-4 py-8 font-mono" role="dialog" aria-modal="true" aria-labelledby="pmodal-title">
  <div id="pmodal-backdrop" class="absolute inset-0" style="background: rgba(16,16,14,0.86)"></div>

  <div class="relative z-10 w-full max-w-lg bg-base border border-line-strong max-h-full overflow-y-auto">
    <div class="flex items-center justify-between px-5 py-3 border-b border-line-strong bg-panel">
      <div class="flex items-center gap-3">
        <span id="pmodal-num" class="font-mono text-[11px] font-semibold tracking-[0.18em] text-fg">01</span>
        <span class="w-px h-3 bg-line-strong" aria-hidden="true"></span>
        <span class="font-mono text-[10px] font-medium uppercase tracking-[0.32em] text-fg-dim">Product Detail</span>
      </div>
      <button id="pmodal-close" type="button" aria-label="Close" class="w-8 h-8 flex items-center justify-center border border-line-strong text-fg-dim hover:text-fg hover:border-fg text-sm leading-none">&times;</button>
    </div>

    <div class="p-6 md:p-8 flex flex-col gap-6">
      <div class="flex items-start gap-3">
        <span id="pmodal-dot" class="w-3 h-3 mt-1.5 shrink-0 border border-fg-dim"></span>
        <div>
          <h2 id="pmodal-title" class="font-display text-3xl font-extrabold uppercase tracking-[-0.03em] text-fg leading-[0.9]">Nodegen</h2>
          <p id="pmodal-tagline" class="mt-2 font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim">Chord Generator / Stab Sequencer</p>
        </div>
      </div>

      <div id="pmodal-cover" class="aspect-[16/10] w-full bg-inset border border-line dot-matrix relative overflow-hidden flex items-center justify-center">
        <img id="pmodal-image" src="" alt="" class="w-full h-full object-contain hidden" />
        <span id="pmodal-cover-label" class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-faint">Cover art</span>
      </div>

      <div id="pmodal-preview" class="hidden flex-col gap-3">
        <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-fg-dim block">Preview</span>
        <iframe id="pmodal-preview-frame" title="Audio preview" src="" width="100%" height="152" style="border-radius:0" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
      </div>

      <p id="pmodal-detail" class="font-body text-sm leading-relaxed text-fg-muted"></p>

      <div class="flex items-end justify-between gap-4 border-t border-line pt-5">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim block mb-1">Price</span>
          <span id="pmodal-price" class="font-display text-4xl font-extrabold tracking-[-0.02em] text-fg leading-none">£15</span>
        </div>
        <span id="pmodal-note" class="font-mono text-[10px] uppercase tracking-[0.12em] text-fg-dim text-right max-w-[55%]"></span>
      </div>

      <div class="border-t border-line pt-5">
        <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-fg-dim block mb-3">What's inside</span>
        <ul id="pmodal-features" class="flex flex-col gap-2.5"></ul>
      </div>

      <div class="border-t border-line pt-5">
        <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-fg-dim block mb-3">Specs</span>
        <ul id="pmodal-meta" class="flex flex-col gap-2"></ul>
      </div>

      <button id="pmodal-buy" type="button" disabled class="key w-full py-4 text-center">
        Buy &mdash; Coming Soon
      </button>
      <a href="/contact" class="w-full text-center font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim hover:text-fg no-underline">
        Questions? Get in touch &rarr;
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('product-modal');
    const modalBackdrop = document.getElementById('pmodal-backdrop');
    const modalClose = document.getElementById('pmodal-close');
    if (!modal) return;

    const setText = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    let lastFocused: HTMLElement | null = null;

    function openModal(card: HTMLElement) {
      if (!modal) return;
      const d = card.dataset;
      setText('pmodal-num', d.num || '');
      setText('pmodal-title', d.title || '');
      setText('pmodal-tagline', d.tagline || '');
      setText('pmodal-detail', d.detail || '');
      setText('pmodal-price', d.price || '');
      setText('pmodal-note', d.note || '');

      // Category colour shows as a filled square cell (no glow).
      const dot = document.getElementById('pmodal-dot');
      if (dot && d.hex) {
        dot.style.background = d.hex;
        dot.style.borderColor = d.hex;
      }

      const img = document.getElementById('pmodal-image') as HTMLImageElement | null;
      const coverLabel = document.getElementById('pmodal-cover-label');
      if (img && coverLabel) {
        if (d.image) {
          img.src = d.image;
          img.alt = d.title || '';
          img.classList.remove('hidden');
          coverLabel.classList.add('hidden');
        } else {
          img.src = '';
          img.classList.add('hidden');
          coverLabel.classList.remove('hidden');
        }
      }

      const preview = document.getElementById('pmodal-preview');
      const previewFrame = document.getElementById('pmodal-preview-frame') as HTMLIFrameElement | null;
      if (preview && previewFrame) {
        if (d.preview) {
          previewFrame.src = d.preview;
          preview.classList.remove('hidden');
          preview.classList.add('flex');
        } else {
          previewFrame.src = '';
          preview.classList.add('hidden');
          preview.classList.remove('flex');
        }
      }

      const featureList = document.getElementById('pmodal-features');
      if (featureList) {
        featureList.innerHTML = '';
        let features: string[] = [];
        try { features = JSON.parse(d.features || '[]'); } catch { features = []; }
        for (const feature of features) {
          const li = document.createElement('li');
          li.className = 'flex gap-2.5 font-body text-[13px] leading-snug text-fg-muted';
          const mark = document.createElement('span');
          mark.className = 'text-fg-dim shrink-0 mt-px font-mono';
          mark.textContent = '+';
          const text = document.createElement('span');
          text.textContent = feature;
          li.append(mark, text);
          featureList.appendChild(li);
        }
      }

      const metaList = document.getElementById('pmodal-meta');
      if (metaList) {
        metaList.innerHTML = '';
        let meta: { label: string; value: string }[] = [];
        try { meta = JSON.parse(d.meta || '[]'); } catch { meta = []; }
        for (const row of meta) {
          const li = document.createElement('li');
          li.className = 'flex justify-between gap-4 border-b border-line pb-2 font-mono text-[11px] uppercase tracking-[0.1em] text-fg-muted';
          const label = document.createElement('span');
          label.className = 'text-fg-dim';
          label.textContent = row.label;
          const value = document.createElement('span');
          value.className = 'font-semibold text-fg text-right';
          value.textContent = row.value;
          li.append(label, value);
          metaList.appendChild(li);
        }
      }

      lastFocused = card;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      modalClose?.focus();
    }

    function closeModal() {
      if (!modal) return;
      const previewFrame = document.getElementById('pmodal-preview-frame') as HTMLIFrameElement | null;
      if (previewFrame) previewFrame.src = ''; // stop playback on close
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    document.querySelectorAll<HTMLElement>('.product-card').forEach((card) => {
      card.addEventListener('click', () => openModal(card));
    });
    modalBackdrop?.addEventListener('click', closeModal);
    modalClose?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  });
</script>
