---
import SectionHeader from './SectionHeader.astro';
import { testimonials } from '../data/testimonials';
---

<section class="reviews-carousel border-b border-line-strong">
  <SectionHeader label="Reviews / What Clients Say">
    <span slot="meta" data-count class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.12em]">{testimonials.length} reviews</span>
  </SectionHeader>

  <div class="relative">
    <!-- Slides -->
    <div class="overflow-hidden">
      <div data-track class="flex transition-transform duration-500 ease-out">
        {testimonials.map((t) => (
          <figure data-slide class="w-full shrink-0 px-14 md:px-24 py-10 md:py-12 flex flex-col items-start gap-5">
            <div class="flex gap-1" aria-label={`${t.rating} out of 5`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <span class={`block w-3 h-3 border ${s < t.rating ? 'bg-fg border-fg' : 'border-cell-line'}`}></span>
              ))}
            </div>
            <blockquote class={`font-body text-fg leading-relaxed max-w-2xl ${t.quote.length > 200 ? 'text-sm md:text-[0.95rem]' : 'text-base md:text-lg'}`}>&ldquo;{t.quote}&rdquo;</blockquote>
            <figcaption class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim">
              {t.author} <span class="text-fg-faint">&middot; via {t.source}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- Prev / next -->
    <button data-prev type="button" aria-label="Previous review"
      class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center border border-line-strong bg-ground text-fg-dim hover:text-fg hover:border-fg font-mono">&larr;</button>
    <button data-next type="button" aria-label="Next review"
      class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center border border-line-strong bg-ground text-fg-dim hover:text-fg hover:border-fg font-mono">&rarr;</button>
  </div>

  <!-- Pager: square step cells; the current review is the armed step -->
  <div data-dots class="flex flex-wrap items-center justify-center gap-1.5 border-t border-line px-4 py-4">
    {testimonials.map((_, i) => (
      <button data-dot type="button" aria-label={`Go to review ${i + 1}`}
        class="w-3 h-3 border border-cell-line"></button>
    ))}
  </div>
</section>

<script>
  interface PublicReview { quote: string; author: string; source: string; rating: number; }

  // Build a slide <figure> matching the server-rendered markup so appended
  // approved reviews look identical to the hardcoded seed ones.
  function buildSlide(r: PublicReview): HTMLElement {
    const fig = document.createElement('figure');
    fig.setAttribute('data-slide', '');
    fig.className = 'w-full shrink-0 px-14 md:px-24 py-10 md:py-12 flex flex-col items-start gap-5';

    const stars = document.createElement('div');
    stars.className = 'flex gap-1';
    stars.setAttribute('aria-label', `${r.rating} out of 5`);
    for (let s = 0; s < 5; s++) {
      const cell = document.createElement('span');
      cell.className = 'block w-3 h-3 border ' + (s < r.rating ? 'bg-fg border-fg' : 'border-cell-line');
      stars.appendChild(cell);
    }

    const quote = document.createElement('blockquote');
    quote.className = 'font-body text-fg leading-relaxed max-w-2xl ' +
      (r.quote.length > 200 ? 'text-sm md:text-[0.95rem]' : 'text-base md:text-lg');
    quote.textContent = `“${r.quote}”`;

    const cap = document.createElement('figcaption');
    cap.className = 'font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim';
    cap.textContent = r.author + ' ';
    const via = document.createElement('span');
    via.className = 'text-fg-faint';
    via.textContent = `· via ${r.source}`;
    cap.appendChild(via);

    fig.append(stars, quote, cap);
    return fig;
  }

  function buildDot(index: number): HTMLElement {
    const dot = document.createElement('button');
    dot.setAttribute('data-dot', '');
    dot.type = 'button';
    dot.setAttribute('aria-label', `Go to review ${index + 1}`);
    dot.className = 'w-3 h-3 border border-cell-line';
    return dot;
  }

  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = root.querySelectorAll('[data-slide]');
    const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const n = slides.length;
    if (!track || n === 0) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function go(k: number) {
      i = (k + n) % n;
      track!.style.transform = `translateX(-${i * 100}%)`;
      dots.forEach((d, di) => {
        d.classList.toggle('bg-fg', di === i);
        d.classList.toggle('border-fg', di === i);
        d.classList.toggle('border-cell-line', di !== i);
      });
    }
    function restart() {
      if (reduce || n < 2) return;
      clearInterval(timer);
      timer = setInterval(() => go(i + 1), 6000);
    }

    prev?.addEventListener('click', () => { go(i - 1); restart(); });
    next?.addEventListener('click', () => { go(i + 1); restart(); });
    dots.forEach((d, di) => d.addEventListener('click', () => { go(di); restart(); }));
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', restart);
    root.addEventListener('focusin', () => clearInterval(timer));
    root.addEventListener('focusout', restart);

    go(0);
    restart();
  }

  async function setup(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-dots]');
    // Fetch approved reviews and append them to the seed set before init.
    // On any failure, fall back to the server-rendered seed reviews.
    if (track && dotsWrap) {
      try {
        const res = await fetch('/api/get-reviews');
        if (res.ok) {
          const { reviews } = (await res.json()) as { reviews: PublicReview[] };
          const seedCount = track.querySelectorAll('[data-slide]').length;
          reviews.forEach((r, idx) => {
            track.appendChild(buildSlide(r));
            dotsWrap.appendChild(buildDot(seedCount + idx));
          });
          if (reviews.length) {
            const countEl = root.querySelector<HTMLElement>('[data-count]');
            if (countEl) countEl.textContent = `${seedCount + reviews.length} reviews`;
          }
        }
      } catch {
        /* keep seed reviews only */
      }
    }
    initCarousel(root);
  }

  document.querySelectorAll<HTMLElement>('.reviews-carousel').forEach(setup);
</script>
