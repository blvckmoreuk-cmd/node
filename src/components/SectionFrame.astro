---
// The shared panel shell. One hairline-outlined, square frame that every page
// lives inside, so the whole site reads as one printed hardware panel.
interface Props {
  max?: string;
  class?: string;
  id?: string;
}
const { max = 'max-w-5xl', class: cls = '', id } = Astro.props;
---
<div id={id} class:list={["w-full border border-line-strong bg-base relative z-10 crop-marks", max, cls]}>
  <slot />
</div>
