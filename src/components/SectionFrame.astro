---
// The shared page shell: a plain width-constrained wrapper that every page
// lives inside. Section dividers inside it provide the structure.
interface Props {
  max?: string;
  class?: string;
  id?: string;
}
const { max = 'max-w-5xl', class: cls = '', id } = Astro.props;
---
<div id={id} data-reveal="children" class:list={["w-full relative z-10", max, cls]}>
  <slot />
</div>
