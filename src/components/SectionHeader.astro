---
// The label bar that sits on top of every section. `num` is optional; use it
// only when the sections form a real sequence. Number is cream, never orange
// (one orange element per region).
interface Props {
  num?: string;
  label: string;
}
const { num, label } = Astro.props;
---
<div class="flex items-center justify-between gap-3 px-4 md:px-6 py-3 border-b border-line-strong bg-panel">
  <div class="flex items-center gap-3 min-w-0">
    {num && <span class="font-mono text-[11px] font-semibold text-fg tracking-[0.18em]">{num}</span>}
    {num && <span class="w-px h-3 bg-line-strong" aria-hidden="true"></span>}
    <span class="font-mono text-[10px] font-medium uppercase tracking-[0.32em] text-fg-dim truncate">{label}</span>
  </div>
  <slot name="meta" />
</div>
