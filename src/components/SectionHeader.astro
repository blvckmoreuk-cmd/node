---
// The header bar that sits on top of every module. Mirrors the homepage's
// numbered section headers exactly so nothing drifts. `num` is optional; use it
// only when the sections form a real sequence.
interface Props {
  num?: string;
  label: string;
}
const { num, label } = Astro.props;
---
<div class="flex items-center justify-between gap-3 px-4 md:px-5 py-3 border-b border-line-strong bg-panel">
  <div class="flex items-center gap-3">
    {num && <span class="text-accent font-mono text-xs font-bold">{num}</span>}
    <span class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.35em]">{label}</span>
  </div>
  <slot name="meta" />
</div>
