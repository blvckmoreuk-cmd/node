---
// The label bar that sits on top of every section.
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="flex flex-col items-start gap-1.5 md:flex-row md:items-center md:justify-between md:gap-3 px-4 md:px-6 py-3 border-b border-line-strong bg-panel">
  <div class="flex items-center gap-3 min-w-0">
    <span class="font-body text-base font-medium text-fg whitespace-normal leading-snug">{label}</span>
  </div>
  <slot name="meta" />
</div>
