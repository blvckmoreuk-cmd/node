---
// Shared service card. Used by the homepage grid (compact) and the services
// page (full, with the detail line). Carries the data-* attributes the shared
// ServiceModal reads, plus the `.service-card` hook its script binds to.
// Sequencer styling: flat square cell, hairline edge, a small channel-coloured
// square beside the index, and a 2px channel rule that draws across the base on
// hover. No lifts, glows or shadows.
import type { Service } from '../data/services';

interface Props {
  service: Service;
  compact?: boolean; // homepage: hide the detail line, shorter card
}
const { service, compact = false } = Astro.props;
---

<button
  type="button"
  class:list={["service-card svc group", { compact }]}
  style={`--ch:${service.hex}`}
  data-num={service.num}
  data-title={service.title}
  data-tagline={service.tagline}
  data-detail={service.detail}
  data-price={service.price}
  data-note={service.note}
  data-revisions={service.revisions}
  data-hex={service.hex}
  data-reqs={JSON.stringify(service.reqs)}
  data-reqs-label={service.reqsLabel}
  data-shop={service.shopHref}
  aria-haspopup="dialog"
>
  <div class="flex items-start justify-between gap-3">
    <span class="flex items-center gap-2.5">
      <span class="svc-chip" aria-hidden="true"></span>
      <span class="svc-num">{service.num}</span>
    </span>
    <span class="svc-open">Open &rarr;</span>
  </div>

  <div class="svc-body">
    <h3 class="svc-title">{service.title}</h3>
    <p class="svc-tagline">{service.tagline}</p>
    <p class="svc-detail">{service.detail}</p>
  </div>

  <div class="svc-foot">
    {service.revisions
      ? <span class="svc-rev">&#8635; {service.revisions}</span>
      : <span aria-hidden="true"></span>}
    <span class="svc-price">{service.price}</span>
  </div>

  <span class="svc-rule" aria-hidden="true"></span>
</button>

<style>
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    padding: 1.5rem;
    background: var(--color-ground);
    border: 1px solid var(--color-line-strong);
    text-align: left;
    cursor: pointer;
    outline: none;
    border-radius: 0;
    transition: background-color 0s steps(1), border-color 0s steps(1);
  }
  .svc.compact { min-height: 14rem; }
  .svc.compact .svc-detail { display: none; }

  .svc:hover,
  .svc:focus-visible {
    background: var(--color-panel);
    border-color: var(--color-fg-dim);
  }
  .svc:active { transform: translateY(1px); }
  .svc:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 3px; }

  /* channel chip: a hollow square that fills on hover, like an armed step */
  .svc-chip {
    display: block;
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    border: 1px solid var(--ch);
    background: transparent;
  }
  .svc:hover .svc-chip,
  .svc:focus-visible .svc-chip { background: var(--ch); }

  .svc-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    color: var(--color-fg);
  }

  .svc-open {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-fg-faint);
  }
  .svc:hover .svc-open,
  .svc:focus-visible .svc-open { color: var(--color-fg); }

  /* body sits low so the index gets breathing room above it */
  .svc-body { margin-top: auto; padding-top: 1.75rem; }

  .svc-title {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display, -0.03em);
    line-height: 1.15;
    font-size: 1.125rem;
    color: var(--color-fg);
  }
  .svc-tagline {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-fg-dim);
  }
  .svc-detail {
    margin-top: 0.85rem;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .svc-foot {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .svc-rev {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caption);
    color: var(--color-fg-dim);
  }
  /* prices are cream, not orange */
  .svc-price {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-fg);
    white-space: nowrap;
  }

  /* 2px channel rule that draws across the base on hover */
  .svc-rule {
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -1px;
    height: 2px;
    background: var(--ch);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s steps(4);
  }
  .svc:hover .svc-rule,
  .svc:focus-visible .svc-rule { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .svc-rule { transition: none; }
  }
</style>
