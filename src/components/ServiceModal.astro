---
// Shared service detail panel. Drop <ServiceModal /> on any page whose cards
// carry the data-* attributes below and a `.service-card` class; the script
// wires every matching button to open this dialog.
---

<div id="service-modal" class="fixed inset-0 z-50 hidden items-center justify-center px-4 py-8 font-mono" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div id="modal-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

  <div class="relative z-10 w-full max-w-lg bg-base border border-line-strong shadow-[0_20px_60px_rgba(0,0,0,0.7)] max-h-full overflow-y-auto">
    <div class="flex items-center justify-between px-5 py-3 border-b border-line-strong bg-panel">
      <div class="flex items-center gap-3">
        <span id="modal-num" class="text-accent font-mono text-xs font-bold">01</span>
        <span class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.35em]">Service Detail</span>
      </div>
      <button id="modal-close" type="button" aria-label="Close" class="w-7 h-7 flex items-center justify-center border border-line-strong text-fg-faint hover:text-accent hover:border-accent transition-colors text-sm leading-none">&times;</button>
    </div>

    <div class="p-6 md:p-8 flex flex-col gap-5">
      <div class="flex items-center gap-3">
        <span id="modal-dot" class="w-3 h-3 rounded-full shrink-0"></span>
        <div>
          <h2 id="modal-title" class="font-display text-2xl font-bold uppercase tracking-tight text-fg leading-none">Mastering</h2>
          <p id="modal-tagline" class="mt-1.5 font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">Loudness / Translation</p>
        </div>
      </div>

      <p id="modal-detail" class="font-body text-sm leading-relaxed text-fg-muted"></p>

      <div class="flex items-end justify-between border-t border-line pt-4">
        <div>
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint block">From</span>
          <span id="modal-price" class="font-display text-3xl font-bold text-accent leading-none">£20</span>
        </div>
        <span id="modal-note" class="font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint text-right max-w-[50%]"></span>
      </div>

      <p id="modal-offer" class="hidden font-mono text-[10px] uppercase tracking-[0.2em] text-accent">50% off your first order.</p>

      <div id="modal-revisions-row" class="hidden items-center gap-2.5 border-t border-line pt-4">
        <span class="text-accent leading-none">&#8635;</span>
        <span id="modal-revisions" class="font-mono text-[11px] uppercase tracking-[0.15em] text-fg-muted"></span>
      </div>

      <div id="modal-reqs-section" class="border-t border-line pt-4">
        <span id="modal-reqs-label" class="font-mono text-[9px] uppercase tracking-[0.3em] text-accent block mb-3">What to send</span>
        <ul id="modal-reqs" class="flex flex-col gap-2.5"></ul>
      </div>

      <a id="modal-cta" href="/contact" class="w-full text-center py-4 bg-accent-dim text-white font-mono font-black text-[12px] uppercase tracking-[0.3em] hover:bg-accent active:translate-y-px transition-all">
        Book This Service &rarr;
      </a>
      <a href="/prices" class="w-full text-center font-mono text-[10px] uppercase tracking-[0.25em] text-fg-faint hover:text-accent transition-colors">
        View full price list &rarr;
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('service-modal');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalClose = document.getElementById('modal-close');
    if (!modal) return;

    const setText = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    let lastFocused: HTMLElement | null = null;

    function openModal(card: HTMLElement) {
      if (!modal) return;
      const d = card.dataset;
      setText('modal-num', d.num || '');
      setText('modal-title', d.title || '');
      setText('modal-tagline', d.tagline || '');
      setText('modal-detail', d.detail || '');
      setText('modal-price', d.price || '');
      setText('modal-note', d.note || '');
      const revRow = document.getElementById('modal-revisions-row');
      if (revRow) {
        if (d.revisions) {
          setText('modal-revisions', d.revisions);
          revRow.classList.remove('hidden');
          revRow.classList.add('flex');
        } else {
          revRow.classList.add('hidden');
          revRow.classList.remove('flex');
        }
      }
      const offerLine = document.getElementById('modal-offer');
      if (offerLine) {
        offerLine.classList.toggle('hidden', d.offer !== '1');
      }
      const dot = document.getElementById('modal-dot');
      if (dot && d.hex) {
        dot.style.background = d.hex;
        dot.style.boxShadow = `0 0 8px ${d.hex}`;
      }
      const cta = document.getElementById('modal-cta') as HTMLAnchorElement | null;
      if (cta) {
        if (d.shop) {
          cta.href = d.shop;
          cta.innerHTML = 'Shop These &rarr;';
        } else {
          cta.href = '/contact';
          cta.innerHTML = 'Book This Service &rarr;';
        }
      }
      setText('modal-reqs-label', d.reqsLabel || 'What to send');
      const reqList = document.getElementById('modal-reqs');
      if (reqList) {
        reqList.innerHTML = '';
        let reqs: string[] = [];
        try { reqs = JSON.parse(d.reqs || '[]'); } catch { reqs = []; }
        // No bullet points: drop the gap under the heading so it doesn't float.
        reqList.classList.toggle('mt-0', reqs.length === 0);
        for (const req of reqs) {
          const li = document.createElement('li');
          li.className = 'flex gap-2.5 font-body text-[12px] leading-snug text-fg-muted';
          const mark = document.createElement('span');
          mark.className = 'text-accent shrink-0 mt-px';
          mark.textContent = '+';
          const text = document.createElement('span');
          text.textContent = req;
          li.append(mark, text);
          reqList.appendChild(li);
        }
      }
      lastFocused = card;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      modalClose?.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    document.querySelectorAll<HTMLElement>('.service-card').forEach((card) => {
      card.addEventListener('click', () => openModal(card));
    });
    modalBackdrop?.addEventListener('click', closeModal);
    modalClose?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  });
</script>
