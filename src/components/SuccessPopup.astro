---
// Shows a "Message Sent" popup after a Netlify Forms submission redirects back
// with ?success=true. Drop <SuccessPopup /> on any page whose form action ends
// in ?success=true. The script strips the param so a refresh won't re-open it.
// Sequencer styling: the confirmation is a row of cells that arm one by one.
---

<div id="success-popup" class="fixed inset-0 z-[60] hidden items-center justify-center px-4 py-8 font-body" role="dialog" aria-modal="true" aria-labelledby="success-title">
  <div id="success-backdrop" class="absolute inset-0 anim-backdrop" style="background: rgba(16,16,14,0.86)"></div>

  <div class="anim-panel relative z-10 w-full max-w-sm bg-ground border border-line-strong">
    <div class="flex items-center justify-end px-5 py-3 border-b border-line-strong bg-panel">
      <button id="success-close" type="button" aria-label="Close" class="w-8 h-8 flex items-center justify-center border border-line-strong text-fg-dim hover:text-fg hover:border-fg text-sm leading-none">&times;</button>
    </div>

    <div class="p-6 md:p-8 flex flex-col gap-6">
      <div class="seq seq-arm" style="--steps:8; --cell:18px" aria-hidden="true">
        <span class="seq-cell is-step"></span><span class="seq-cell is-cream"></span><span class="seq-cell is-cream"></span><span class="seq-cell is-cream"></span>
        <span class="seq-cell is-grey"></span><span class="seq-cell is-grey"></span><span class="seq-cell is-grey"></span><span class="seq-cell is-grey"></span>
      </div>
      <div>
        <h2 id="success-title" class="font-display text-[1.75rem] font-bold tracking-[-0.015em] text-fg leading-[1.15]">Message sent</h2>
        <p class="mt-3 font-body text-base leading-relaxed text-fg-muted">Thanks for reaching out. We'll reply the same day. Check your inbox, and your spam folder, for our reply.</p>
      </div>
      <button id="success-ok" type="button" class="key key-primary w-full py-4">
        Done
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('success-popup');
    if (!popup) return;
    const url = new URL(window.location.href);
    if (url.searchParams.get('success') !== 'true') return;

    // Strip the flag so a refresh or back-nav won't re-open the popup.
    url.searchParams.delete('success');
    history.replaceState(null, '', url.pathname + url.search + url.hash);

    const open = () => {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      document.body.style.overflow = 'hidden';
      document.getElementById('success-ok')?.focus();
    };
    const close = () => {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
      document.body.style.overflow = '';
    };

    document.getElementById('success-close')?.addEventListener('click', close);
    document.getElementById('success-ok')?.addEventListener('click', close);
    document.getElementById('success-backdrop')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    open();
  });
</script>
