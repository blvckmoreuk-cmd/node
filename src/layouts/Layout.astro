---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Node | Audio Engineering</title>

    <!-- Font roles: display (Space Grotesk), mono (JetBrains Mono), body (Inter).
         Registered in astro.config.mjs; preload the two above-the-fold faces. -->
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>

  <body class="min-h-screen flex flex-col relative">

    <!-- Grain overlay: subtle texture across the whole page, sits behind everything.
         Same noise recipe used inside the card on the homepage, so the grain matches
         site-wide instead of using an external asset. -->
    <div class="page-grain fixed inset-0 pointer-events-none z-0" aria-hidden="true"></div>

    <Header />

    <!-- Main Content: z-10 keeps it above the grain overlay -->
    <main class="w-full grow flex flex-col items-center z-10 relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full py-8 mt-12 text-center text-[10px] font-mono tracking-[0.3em] uppercase text-fg-faint border-t border-line-strong z-10 relative">
      &copy; {new Date().getFullYear()} Node Leeds. All Rights Reserved.
    </footer>

  </body>
</html>