---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Node | Audio Engineering</title>
  </head>
  <body class="bg-[#e6e1d9] min-h-screen flex flex-col font-sans text-[#5c554a]">
    
    <header class="w-full p-6">
      <nav class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/" class="text-xl font-bold tracking-[0.2em] uppercase text-[#4a453d]">Node</a>
        <div class="space-x-8 text-sm uppercase tracking-widest">
          <a href="/services" class="hover:text-copper transition-colors">Services</a>
          <a href="/work" class="hover:text-copper transition-colors">Work</a>
          <a href="/contact" class="hover:text-copper transition-colors">Contact</a>
        </div>
      </nav>
    </header>

    <main class="grow flex flex-col items-center justify-center">
      <slot />
    </main>

    <footer class="w-full py-8 text-center text-xs tracking-widest uppercase">
      &copy; {new Date().getFullYear()} Node Leeds. All Rights Reserved.
    </footer>

  </body>
</html>