---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Node Leeds | Audio Engineering</title>
  </head>
  <body class="bg-wood-900 bg-noise text-wood-100 font-sans antialiased min-h-screen flex flex-col">
    <header class="w-full border-b border-wood-800">
      <nav class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center w-full">
        <a href="/" class="text-xl font-bold tracking-[0.2em] uppercase text-wood-100 hover:text-copper transition-colors">
          Node
        </a>
        <div class="space-x-8 text-sm font-medium tracking-wide text-wood-400">
          <a href="/services" class="hover:text-wood-100 transition-colors duration-200">Services</a>
          <a href="/work" class="hover:text-wood-100 transition-colors duration-200">Work</a>
          <a href="/contact" class="hover:text-wood-100 transition-colors duration-200">Contact</a>
        </div>
      </nav>
    </header>

    <main class="grow flex flex-col items-center">
      <slot />
    </main>

    <footer class="w-full py-8 text-center border-t border-wood-800 text-wood-400 text-xs tracking-wider">
      &copy; {new Date().getFullYear()} NODE LEEDS. ALL RIGHTS RESERVED.
    </footer>
  </body>
</html>