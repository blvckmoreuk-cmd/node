---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Node | Audio Engineering</title>
  </head>
  
  <body class="bg-[#e4c0fb98] min-h-screen flex flex-col font-sans text-[#5c554a]"> 
    //"header"
    
    <header class="w-full flex items-center justify-between px-12 py-8 max-w-5xl mx-auto">
      <nav class="flex gap-8 font-bold text-[#5c554a] uppercase tracking-widest text-sm">
        <a href="/about" class="hover:text-[#d7793b] transition-colors">About</a>
        <a href="/services" class="hover:text-[#d7793b] transition-colors">Services</a>
      </nav>

      <a href="/" class="text-3xl font-black tracking-[0.2em] text-[#4a453d]">NODE</a>

      <nav class="flex gap-8 font-bold text-[#5c554a] uppercase tracking-widest text-sm">
        <a href="/portfolio" class="hover:text-[#d7793b] transition-colors">Portfolio</a>
        <a href="/contact" class="hover:text-[#d7793b] transition-colors">Contact</a>
      </nav>
    </header>

    <main class="grow flex flex-col items-center">
      <slot />
    </main>

    <footer class="w-full py-8 text-center text-xs tracking-widest uppercase">
      &copy; {new Date().getFullYear()} Node Leeds. All Rights Reserved.
    </footer>

  </body>
</html>