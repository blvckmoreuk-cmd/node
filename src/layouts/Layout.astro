---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import StepGrid from '../components/StepGrid.astro';

// Per-page SEO. Every page passes its own title + description; the rest fall
// back to sensible site-wide defaults so no page ships bare.
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Node Production | Dance Music Mixing & Mastering, Leeds',
  description = 'Mix, master and ghost production for dance music. Leeds studio working worldwide. Same-day reply.',
  image = '/og.jpg',
  noindex = false,
} = Astro.props;

// Canonical + absolute OG image, resolved against the `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// LocalBusiness structured data — one studio, Leeds, so search engines can
// surface hours-independent rich results and local-pack eligibility.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Node Production',
  description,
  url: Astro.site?.href,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Leeds',
    addressCountry: 'GB',
  },
  areaServed: 'Worldwide',
  genre: 'Dance Music',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, Instagram) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Node Production" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <meta name="theme-color" content="#1c1c1a" />

    <!-- Font roles (Sequencer): display (Archivo 800), mono (IBM Plex Mono), body (IBM Plex Sans).
         Registered in astro.config.mjs; preload the above-the-fold faces. -->
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-plex-mono" preload />
    <Font cssVariable="--font-plex-sans" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body class="min-h-screen flex flex-col relative">

    <Header />

    <main class="w-full grow flex flex-col items-center z-10 relative">
      <slot />
    </main>

    <footer class="w-full mt-12 border-t border-line-strong bg-page z-10 relative">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="flex flex-col gap-4">
          <Logo sub />
          <!-- Quiet sign-off: same pattern, step 1 cream (the hero grid carries the one armed step) -->
          <StepGrid rows={['C...C.....C.C...', '..G...G.G..C..G.']} />
        </div>
        <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] uppercase tracking-[0.18em]">
          <a href="/about" class="text-fg-dim hover:text-fg no-underline">About</a>
          <a href="/services" class="text-fg-dim hover:text-fg no-underline">Services</a>
          <a href="/prices" class="text-fg-dim hover:text-fg no-underline">Rates</a>
          <a href="/shop" class="text-fg-dim hover:text-fg no-underline">Shop</a>
          <a href="/portfolio" class="text-fg-dim hover:text-fg no-underline">Portfolio</a>
          <a href="/contact" class="text-fg-dim hover:text-fg no-underline">Contact</a>
        </nav>
      </div>
      <div class="border-t border-line">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-1 sm:flex-row sm:justify-between font-mono text-[10px] uppercase tracking-[0.12em] text-fg-faint">
          <span>&copy; {new Date().getFullYear()} Node Leeds. All Rights Reserved.</span>
          <span>53.80 N&nbsp;&nbsp;1.55 W</span>
        </div>
      </div>
    </footer>

  </body>
</html>
