---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<Layout>
  <main class="w-full min-h-screen bg-[#050608] flex flex-col items-center px-4 pt-8 pb-16 font-mono text-[#94a3b8]">
    
    <div class="w-full max-w-2xl">

      <section class="pt-10 pb-12 border-b border-[#14171c]">
        <div class="flex items-center gap-2 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
          <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-[#52555c]">About</span>
        </div>

        <p class="text-sm md:text-base text-[#94a3b8] leading-relaxed">
          Node Production are Dance Music Specialists based in Leeds.
          <br/>
          <br/>
          Bridging the gap between amateur and professional music production is not easy (or cheap!). We founded Node to make professional sound accessible to everyone. We offer affordable services to artists of all levels and treat every track like one of our own. Our engineers have worked on tracks for UKF, Motive, 3000 Bass, Gold Digger, All Ways Dance and many more.
          <br/>
          <br/>
          Supported by BBC Radio 1, BBC Radio 1Xtra, Shiba San, MPH, Oppidan and countless others.
        </p>
      </section>

      <section class="pt-10">
        <div class="flex items-center gap-2 mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
          <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-[#52555c]">How It Works</span>
        </div>
        
        <ol class="space-y-6 text-sm text-[#94a3b8] font-mono">
          <li class="flex gap-4">
            <span class="text-[#10b981] font-black">01.</span>
            <span>Select your service.</span>
          </li>
          <li class="flex gap-4">
            <span class="text-[#10b981] font-black">02.</span>
            <span>View our <a href="/prices" class="underline hover:text-[#10b981] transition-colors">pricing list</a> to confirm your requirements.</span>
          </li>
          <li class="flex gap-4">
            <span class="text-[#10b981] font-black">03.</span>
            <span>Send us an email with your request. We guarantee a same-day response.</span>
          </li>
          <li class="flex gap-4">
            <span class="text-[#10b981] font-black">04.</span>
            <span>Once confirmed, pay a 50% deposit.</span>
          </li>
          <li class="flex gap-4">
            <span class="text-[#10b981] font-black">05.</span>
            <span>Receive your project back within the agreed timeframe!</span>
          </li>
        </ol>
      </section>

      <ContactCTA />
    </div>

  </main>
</Layout>