---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';

const steps = [
  { num: '01', title: 'Send', detail: 'Email your request. Same-day reply, guaranteed.' },
  { num: '02', title: 'Confirm', detail: 'We lock the scope, rate and timeframe for your project.' },
  { num: '03', title: 'Upload', detail: 'Get a link to upload your files, plus a 50% deposit payment link.' },
  { num: '04', title: 'Deliver', detail: 'Once files are uploaded and the deposit is paid, your project lands within the agreed timeframe.' },
];

const supporters = ['BBC Radio 1', 'BBC Radio 1Xtra', 'Shiba San', 'MPH', 'Oppidan'];
---

<Layout
  title="About | Node Production — Leeds Dance Music Studio"
  description="Node Production are Leeds-based dance music specialists. Work supported by BBC Radio 1, 1Xtra and Shiba San."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame max="max-w-4xl">

      <!-- Masthead -->
      <header class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line">
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Studio Profile</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Leeds, UK</span>
        </div>
        <div class="px-4 md:px-8 py-8 md:py-11">
          <h1 class="font-display font-bold uppercase leading-[0.9] tracking-tight text-fg text-[11vw] md:text-[3.75rem]">
            Every track,<br /><span class="text-accent">treated as ours.</span>
          </h1>
        </div>
      </header>

      <!-- Who we are -->
      <section class="border-b border-line-strong">
        <SectionHeader num="01" label="Who We Are" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line-strong">
          <div class="md:col-span-3 bg-base p-6 md:p-8">
            <p class="font-body text-sm md:text-[1rem] text-fg-muted leading-relaxed max-w-2xl">
              Node Production are dance music specialists based in Leeds. Bridging the gap between
              amateur and professional production is not easy or cheap, so we built Node to make a
              professional sound reachable for artists at any level. We treat every record like one
              of our own. Our engineers have worked on releases for UKF, Motive, 3000 Bass, Gold
              Digger, All Ways Dance and many more.
            </p>
          </div>
          <div class="bg-panel p-6 flex flex-col justify-center gap-1">
            <span class="font-display text-2xl font-bold text-accent leading-none">Leeds, UK</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Studio base</span>
          </div>
          <div class="bg-panel p-6 flex flex-col justify-center gap-1">
            <span class="font-display text-2xl font-bold text-accent leading-none">Same-day</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Reply, guaranteed</span>
          </div>
          <div class="bg-panel p-6 flex flex-col justify-center gap-1">
            <span class="font-display text-2xl font-bold text-accent leading-none">Worldwide</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Working remotely</span>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="border-b border-line-strong">
        <SectionHeader num="02" label="How It Works / Signal Chain" />
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-px bg-line-strong">
          {steps.map((step) => (
            <div class="bg-panel p-5 flex flex-col gap-3 min-h-40">
              <span class="font-display text-4xl font-bold text-fg-faint/30 leading-none">{step.num}</span>
              <div>
                <h3 class="font-display text-sm font-bold uppercase tracking-tight text-fg">{step.title}</h3>
                <p class="mt-1.5 font-body text-[12px] leading-relaxed text-fg-muted">{step.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Supported by -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Supported By" />
        <div class="flex flex-wrap gap-3 px-4 md:px-6 py-6">
          {supporters.map((name) => (
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-fg-muted border border-line-strong px-4 py-2">{name}</span>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="flex flex-col sm:flex-row items-stretch">
        <a href="/prices" class="flex-1 text-center px-6 py-5 bg-panel border-b sm:border-b-0 sm:border-r border-line-strong text-fg-muted font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:text-accent hover:border-accent transition-colors">
          View Rates
        </a>
        <a href="/contact" class="flex-1 text-center px-6 py-5 bg-accent-dim text-white font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-accent transition-colors">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>
</Layout>
