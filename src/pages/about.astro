---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';

const steps = [
  { num: '01', title: 'Send', detail: 'Email your request. Same-day reply, guaranteed.' },
  { num: '02', title: 'Confirm', detail: 'We lock the scope, rate and timeframe for your project.' },
  { num: '03', title: 'Upload', detail: 'Get a link to upload your files, plus a 50% deposit payment link.' },
  { num: '04', title: 'Deliver', detail: 'Once files are uploaded and the deposit is paid, your project lands within the agreed timeframe.' },
];

const supporters = ['BBC Radio 1', 'BBC Radio 1Xtra', 'Shiba San', 'MPH', 'Oppidan'];
---

<Layout
  title="About | Node Production — Leeds Dance Music Studio"
  description="Node Production are Leeds-based dance music specialists. Work supported by BBC Radio 1, 1Xtra and Shiba San."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame>

      <PageHero left="Node // Studio Profile" right="Leeds, UK">
        <Fragment slot="title">Every track,<br />treated as ours.</Fragment>
      </PageHero>

      <!-- Who we are -->
      <section class="border-b border-line-strong">
        <SectionHeader num="01" label="Who We Are" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line-strong">
          <div class="md:col-span-3 bg-base p-6 md:p-10">
            <p class="font-body text-base md:text-lg text-fg-muted leading-relaxed max-w-3xl">
              Node Production are dance music specialists based in Leeds. Bridging the gap between
              amateur and professional production is not easy or cheap, so we built Node to make a
              professional sound reachable for artists at any level. We treat every record like one
              of our own. Our engineers have worked on releases for UKF, Motive, 3000 Bass, Gold
              Digger, All Ways Dance and many more.
            </p>
          </div>
          <div class="bg-base p-6 md:p-8 flex flex-col justify-center gap-2">
            <span class="font-display text-3xl font-extrabold uppercase tracking-[-0.03em] text-fg leading-none">Leeds, UK</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim">Studio base</span>
          </div>
          <div class="bg-base p-6 md:p-8 flex flex-col justify-center gap-2">
            <span class="font-display text-3xl font-extrabold uppercase tracking-[-0.03em] text-fg leading-none">Same-day</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim">Reply, guaranteed</span>
          </div>
          <div class="bg-base p-6 md:p-8 flex flex-col justify-center gap-2">
            <span class="font-display text-3xl font-extrabold uppercase tracking-[-0.03em] text-fg leading-none">Worldwide</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim">Working remotely</span>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="border-b border-line-strong">
        <SectionHeader num="02" label="How It Works / Signal Chain" />
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-px bg-line-strong">
          {steps.map((step) => (
            <div class="bg-base p-6 flex flex-col gap-6 min-h-52">
              <span class="seq" style="--steps:4; --cell:12px" aria-hidden="true">
                {[1, 2, 3, 4].map((n) => <span class={`seq-cell ${n === Number(step.num) ? 'is-cream' : ''}`}></span>)}
              </span>
              <div class="mt-auto">
                <span class="font-mono text-[11px] font-semibold tracking-[0.18em] text-fg-dim">{step.num}</span>
                <h3 class="mt-1 font-display text-2xl font-extrabold uppercase tracking-[-0.03em] text-fg leading-[0.95]">{step.title}</h3>
                <p class="mt-3 font-body text-[13px] leading-relaxed text-fg-muted">{step.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Supported by -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Supported By" />
        <div class="flex flex-wrap gap-3 px-4 md:px-6 py-6 md:py-8">
          {supporters.map((name) => (
            <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-fg-muted border border-line-strong px-4 py-2.5">{name}</span>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="flex flex-col sm:flex-row items-stretch gap-px bg-line-strong">
        <a href="/prices" class="key flex-1 py-5 !border-0 bg-base hover:bg-panel">
          View Rates
        </a>
        <a href="/contact" class="key key-primary flex-1 py-5 !border-0">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>
</Layout>
