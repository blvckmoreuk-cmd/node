---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import SuccessPopup from '../components/SuccessPopup.astro';
import PriceReadout from '../components/PriceReadout.astro';
import EnquiryUpload from '../components/EnquiryUpload.astro';
---

<Layout
  title="Upload your track | Contact — Node Production"
  description="Upload your dance music track. Mastering is £30 with a 48-hour turnaround. Mixing is quoted per project, ghost production from £250, track finishing from £120."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-body">
    <SectionFrame>

      <PageHero>
        <Fragment slot="title">Upload<br />your track.</Fragment>
        Add your track, pick a service and see the price as you choose. We reply the same day.
      </PageHero>

      <!-- Form + info -->
      <section>
        <SectionHeader label="Ask a question" />
        <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-px bg-line-strong">

          <!-- Form -->
          <form id="contact-form" name="contact" method="POST" enctype="multipart/form-data" data-netlify="true" data-netlify-honeypot="bot-field" action="/contact/?success=true" class="bg-ground p-6 md:p-8 grid grid-cols-1 gap-5">
            <!-- Netlify Forms: hidden name field + honeypot (bots fill it, humans don't) -->
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="field-label">Name or artist</label>
                <input type="text" id="name" name="name" required class="field" />
              </div>
              <div>
                <label for="email" class="field-label">Email</label>
                <input type="email" id="email" name="email" required class="field" />
              </div>
            </div>

            <div>
              <label for="service" class="field-label">Service</label>
              <select id="service" name="service" required class="field">
                <option value="" disabled selected>Select a service</option>
                <option value="mastering">Mastering</option>
                <option value="mixing-mastering">Mixing &amp; mastering</option>
                <option value="production">Ghost production</option>
                <option value="finishing">Finish your track</option>
                <option value="education">Consultation &amp; education</option>
                <option value="sound-design">Sound design</option>
                <option value="other">Other or not sure</option>
              </select>
            </div>

            <PriceReadout />

            <div>
              <label for="message" class="field-label">Project details</label>
              <textarea id="message" name="message" rows="6" required class="field resize-y"></textarea>
            </div>

            <EnquiryUpload columns="one" />

            <p class="font-body text-base font-medium text-fg">This is an enquiry, not an order. Nothing is booked or charged until we confirm.</p>

            <button type="submit" id="contact-submit" class="key key-primary key-sending w-full py-4">
              <span data-label>Send your track</span>
            </button>
          </form>

          <!-- Info -->
          <aside class="bg-ground p-6 md:p-8 flex flex-col gap-7">
            <div>
              <span class="font-body text-sm font-medium text-fg-muted block mb-2">Response</span>
              <span class="t-h3">Same-day</span>
            </div>
            <div>
              <span class="font-body text-sm font-medium text-fg-muted block mb-2">Based in</span>
              <span class="t-h3">Leeds, UK</span>
              <p class="mt-2 t-note">Working worldwide</p>
            </div>
          </aside>

        </div>
      </section>

    </SectionFrame>
  </div>

  <SuccessPopup />
</Layout>

<script>
  // Submit feedback only: the native Netlify POST is untouched. The submit event
  // fires after browser validation passes, so invalid forms never show "Sending".
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const setLabel = (text: string) => {
    const label = btn?.querySelector('[data-label]');
    if (label) label.textContent = text;
  };
  form?.addEventListener('submit', (e) => {
    if (e.defaultPrevented) return;
    if (!btn || btn.classList.contains('is-sending')) return;
    setLabel('Sending…');
    btn.classList.add('is-sending');
    btn.setAttribute('aria-busy', 'true');
  });
  // Back/forward cache restore: reset the button.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted || !btn) return;
    btn.classList.remove('is-sending');
    btn.removeAttribute('aria-busy');
    setLabel('Send your track');
  });
</script>
