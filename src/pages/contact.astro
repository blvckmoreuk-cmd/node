---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame max="max-w-4xl">

      <!-- Masthead -->
      <header class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line">
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Enquire</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Same-day reply</span>
        </div>
        <div class="px-4 md:px-8 py-8 md:py-11">
          <h1 class="font-display font-bold uppercase leading-[0.9] tracking-tight text-fg text-[11vw] md:text-[3.75rem]">
            Initiate a<br /><span class="text-accent">project.</span>
          </h1>
          <p class="mt-5 font-body text-sm text-fg-muted max-w-md leading-relaxed">
            Send your project details, questions and turnaround. We guarantee a same-day response.
          </p>
        </div>
      </header>

      <!-- Form + info -->
      <section>
        <SectionHeader num="03" label="Enquire / There Are No Stupid Questions" />
        <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-px bg-line-strong">

          <!-- Form -->
          <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" enctype="multipart/form-data" class="bg-panel p-6 md:p-7 grid grid-cols-1 gap-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-2">
                <label for="name" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Name / Artist</label>
                <input type="text" id="name" name="name" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors" />
              </div>
              <div class="flex flex-col gap-2">
                <label for="email" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Email</label>
                <input type="email" id="email" name="email" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors" />
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label for="service" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Service Required</label>
              <select id="service" name="service" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs uppercase tracking-wider outline-none focus:border-accent transition-colors appearance-none cursor-pointer">
                <option value="" disabled selected>Select a service...</option>
                <option value="mastering">Mastering</option>
                <option value="mixing-mastering">Mixing &amp; Mastering</option>
                <option value="production">Ghost Production</option>
                <option value="finishing">Finish Your Track</option>
                <option value="education">Consultation &amp; Education</option>
                <option value="sound-design">Sound Design</option>
                <option value="other">Other / Not sure</option>
              </select>
            </div>

            <div class="flex flex-col gap-2">
              <label for="message" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Project Details</label>
              <textarea id="message" name="message" rows="6" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors resize-y"></textarea>
            </div>

            <div class="flex flex-col gap-2">
              <label for="attachment" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Attachments / Audio</label>
              <input type="file" id="attachment" name="attachment" multiple accept="audio/*,.wav,.mp3,.aiff,.aif,.flac,.zip" class="w-full bg-base border border-line-strong px-4 py-3 text-fg-muted font-mono text-[11px] tracking-wider outline-none focus:border-accent transition-colors cursor-pointer file:mr-4 file:py-1.5 file:px-3 file:border-0 file:bg-accent file:text-base file:font-mono file:font-bold file:text-[10px] file:uppercase file:tracking-widest file:cursor-pointer" />
              <p class="font-mono text-[8px] uppercase tracking-[0.2em] text-fg-faint">WAV / MP3 / FLAC / ZIP. For large sessions, paste a download link above.</p>
            </div>

            <button type="submit" class="w-full py-4 bg-accent text-base font-mono font-black text-[12px] uppercase tracking-[0.3em] hover:bg-accent-bright active:translate-y-px transition-all">
              Send Enquiry
            </button>
          </form>

          <!-- Info -->
          <aside class="bg-base p-6 md:p-7 flex flex-col gap-6">
            <div>
              <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint block mb-1.5">Response</span>
              <span class="font-display text-xl font-bold text-accent leading-none">Same-day</span>
            </div>
            <div>
              <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint block mb-1.5">Based in</span>
              <span class="font-display text-xl font-bold text-fg leading-none">Leeds, UK</span>
              <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">Working worldwide</p>
            </div>
            <div class="mt-auto pt-6 border-t border-line">
              <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint block mb-3">How it works</span>
              <ol class="space-y-2 font-body text-[12px] text-fg-muted leading-snug">
                <li><span class="text-accent font-mono mr-2">01</span>Send your request.</li>
                <li><span class="text-accent font-mono mr-2">02</span>Confirm scope and rate.</li>
                <li><span class="text-accent font-mono mr-2">03</span>Pay a 50% deposit.</li>
                <li><span class="text-accent font-mono mr-2">04</span>Receive your project.</li>
              </ol>
            </div>
          </aside>

        </div>
      </section>

    </SectionFrame>
  </div>
</Layout>
