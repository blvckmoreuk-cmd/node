---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import SuccessPopup from '../components/SuccessPopup.astro';
---

<Layout
  title="Contact | Start a Project — Node Production"
  description="Send your dance music project details for a same-day reply. Mixing, mastering and production enquiries welcome."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame>

      <PageHero left="Node // Enquire" right="Same-day reply">
        <Fragment slot="title">Initiate a<br />project.</Fragment>
        Send your project details, questions and turnaround. We guarantee a same-day response.
      </PageHero>

      <!-- Form + info -->
      <section>
        <SectionHeader num="03" label="Enquire / There Are No Stupid Questions" />
        <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-px bg-line-strong">

          <!-- Form -->
          <form name="contact" method="POST" enctype="multipart/form-data" data-netlify="true" data-netlify-honeypot="bot-field" action="/contact?success=true" class="bg-ground p-6 md:p-8 grid grid-cols-1 gap-5">
            <!-- Netlify Forms: hidden name field + honeypot (bots fill it, humans don't) -->
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="field-label">Name / Artist</label>
                <input type="text" id="name" name="name" required class="field" />
              </div>
              <div>
                <label for="email" class="field-label">Email</label>
                <input type="email" id="email" name="email" required class="field" />
              </div>
            </div>

            <div>
              <label for="service" class="field-label">Service Required</label>
              <select id="service" name="service" required class="field">
                <option value="" disabled selected>Select a service...</option>
                <option value="mastering">Mastering</option>
                <option value="mixing-mastering">Mixing &amp; Mastering</option>
                <option value="production">Ghost Production</option>
                <option value="finishing">Finish Your Track</option>
                <option value="education">Consultation &amp; Education</option>
                <option value="sound-design">Sound Design</option>
                <option value="other">Other / Not sure</option>
              </select>
            </div>

            <div>
              <label for="message" class="field-label">Project Details</label>
              <textarea id="message" name="message" rows="6" required class="field resize-y"></textarea>
              <p class="mt-2.5 font-mono text-[10px] leading-relaxed text-fg-dim">Feel free to attach any rough mix files here. We don&rsquo;t need your stems yet &mdash; you&rsquo;ll be sent a link to upload these when you receive your confirmation email.</p>
            </div>

            <button type="submit" class="key key-primary w-full py-4 text-[12px]">
              Send Enquiry
            </button>
          </form>

          <!-- Info -->
          <aside class="bg-ground p-6 md:p-8 flex flex-col gap-7">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim block mb-2">Response</span>
              <span class="font-display text-2xl font-extrabold uppercase tracking-[-0.025em] text-fg leading-none">Same-day</span>
            </div>
            <div>
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim block mb-2">Based in</span>
              <span class="font-display text-2xl font-extrabold uppercase tracking-[-0.025em] text-fg leading-none">Leeds, UK</span>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-faint">Working worldwide &middot; 53.80 N&nbsp;&nbsp;1.55 W</p>
            </div>
            <div class="mt-auto pt-6 border-t border-line">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim block mb-4">How it works</span>
              <ol class="space-y-3 font-body text-[13px] text-fg-muted leading-snug">
                <li class="flex gap-3"><span class="text-fg-dim font-mono text-[11px] font-semibold shrink-0">01</span><span>Send your request.</span></li>
                <li class="flex gap-3"><span class="text-fg-dim font-mono text-[11px] font-semibold shrink-0">02</span><span>We confirm scope, rate and timeframe.</span></li>
                <li class="flex gap-3"><span class="text-fg-dim font-mono text-[11px] font-semibold shrink-0">03</span><span>Get a link to upload your files and pay a 50% deposit.</span></li>
                <li class="flex gap-3"><span class="text-fg-dim font-mono text-[11px] font-semibold shrink-0">04</span><span>Files uploaded and deposit paid &mdash; project delivered within the agreed timeframe.</span></li>
              </ol>
            </div>
          </aside>

        </div>
      </section>

    </SectionFrame>
  </div>

  <SuccessPopup />
</Layout>
