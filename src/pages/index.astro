---
import Layout from '../layouts/Layout.astro';
import ServiceModal from '../components/ServiceModal.astro';
import { services } from '../data/services';

// Clients scroll continuously under the masthead. Shuffled at build time so the
// order reads as unranked rather than a leaderboard.
const clientNames = [
  'Casmalia', 'Solara', 'Morry', 'Akonite', 'Covert', 'HiFeelings', 'Dankstreet',
  'Denno', 'Slink', 'UKF', 'Unique Vibes', 'Motive', 'Teks LV', 'Joe Allen',
  'TerryBoy', 'Sohl', 'ElTacoFiesta', 'Gold Digger', '3000 Bass',
];
const clients = [...clientNames].sort(() => Math.random() - 0.5);
---

<Layout>
  <main class="w-full min-h-screen bg-page flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono relative overflow-hidden">

    <div id="home-frame" class="w-full max-w-5xl border border-line-strong bg-base relative z-10">

      <!-- ===================== MASTHEAD ===================== -->
      <header class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line">
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Audio Engineering</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Leeds, UK</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-end px-4 md:px-8 py-8 md:py-12">
          <h1 class="font-display font-bold uppercase leading-[0.9] tracking-tight text-fg text-[14vw] md:text-[5.5rem]">
            Dance Music<br /><span class="text-accent">Engineering.</span>
          </h1>
          <div class="flex flex-col gap-5 md:items-end">
            <p class="font-body text-sm text-fg-muted max-w-xs md:text-right leading-relaxed">
              Mix, master and ghost production for dance music. Based in Leeds, working worldwide.
            </p>
            <div class="flex">
              <a href="/contact" class="px-6 py-3 bg-accent text-base font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-accent-bright transition-colors">Start a Project</a>
              <a href="/prices" class="px-6 py-3 bg-panel border border-line-strong border-l-0 text-fg-muted font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:text-accent hover:border-accent transition-colors">Rates</a>
            </div>
          </div>
        </div>
      </header>

      <!-- ===================== CLIENTS MARQUEE ===================== -->
      <div class="border-b border-line-strong bg-base overflow-hidden relative" aria-label="Clients">
        <div class="absolute inset-y-0 left-0 w-12 md:w-20 z-10 bg-linear-to-r from-base to-transparent pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-12 md:w-20 z-10 bg-linear-to-l from-base to-transparent pointer-events-none"></div>
        <div class="marquee-track py-3">
          {[...clients, ...clients].map((client) => (
            <span class="flex items-center whitespace-nowrap px-5 md:px-7 font-mono text-[11px] uppercase tracking-[0.25em] text-fg-muted">
              <span class="w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_6px_rgba(47,111,237,0.7)] mr-5 md:mr-7"></span>
              {client}
            </span>
          ))}
        </div>
      </div>

      <!-- ===================== 01 // VISUALISER ===================== -->
      <section class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-3 border-b border-line-strong bg-panel">
          <div class="flex items-center gap-3">
            <span class="text-accent font-mono text-xs font-bold">01</span>
            <span class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.35em]">Visualiser / Listen</span>
          </div>
          <label class="flex items-center gap-2 cursor-pointer">
            <span class="text-[9px] font-mono tracking-[0.2em] uppercase text-fg-faint">Particle</span>
            <input id="particle-color" type="color" value="#2f6fed" class="w-5 h-5 bg-transparent cursor-pointer" />
          </label>
        </div>

        <div class="p-4 md:p-5 flex flex-col gap-4">

          <!-- Visualiser: full module width, transport controls overlaid on screen -->
          <div id="canvas-container" class="w-full h-72 bg-[#030605] border border-black overflow-hidden relative">
            <div class="absolute inset-0 bg-[radial-gradient(120%_100%_at_50%_0%,rgba(47,111,237,0.07)_0%,transparent_55%)] pointer-events-none z-10"></div>
            <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0)_50%,rgba(0,0,0,0.35)_50%)] bg-size-[100%_3px] pointer-events-none z-10 opacity-70"></div>
            <div class="absolute top-2 left-2 font-mono text-[8px] uppercase tracking-[0.3em] text-accent/70 z-10">RT / Spectrum</div>

            <!-- Track selector: compact, sits on top of the screen -->
            <div class="absolute top-3 left-3 right-3 sm:left-auto z-20 pointer-events-auto">
              <div class="relative w-full sm:w-80">
                <select id="track-selector" class="w-full bg-black/65 backdrop-blur-sm border border-accent text-accent pl-3 pr-7 py-2 text-[10px] font-mono font-bold uppercase tracking-wider cursor-pointer outline-none appearance-none rounded-sm shadow-[0_4px_14px_rgba(0,0,0,0.55)]">
                  <option value="/audio/Wanna Feel.mp3">Track 01: Wanna Feel // Mix/Master</option>
                  <option value="/audio/BE OK.mp3">Track 02: BE OK // Full Production</option>
                  <option value="/audio/Sure Thing.mp3">Track 03: Sure Thing // Master</option>
                  <option value="/audio/2HOT.mp3">Track 04: 2HOT // Master</option>
                  <option value="/audio/wet-morry.mp3">Track 05: WET // Master</option>
                  <option value="/audio/tellmehowtorave-casmalia.mp3">Track 06: Tell Me How To Rave // Mix/Master</option>
                </select>
                <div class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-accent text-[8px]">&#9660;</div>
              </div>
            </div>

            <!-- Overlay controls: sit on top of the visualiser screen -->
            <div class="absolute bottom-3 left-3 right-3 z-20 flex items-end justify-between gap-3 pointer-events-none">

              <!-- Volume knob -->
              <div class="flex items-center gap-2 bg-black/45 backdrop-blur-sm border border-line-strong/70 px-2.5 py-1.5 pointer-events-auto">
                <span class="text-[8px] font-mono uppercase tracking-[0.2em] text-fg-faint">Vol</span>
                <div class="relative flex items-center justify-center w-10 h-10 shrink-0">
                  <div id="knob-glow-core" class="absolute w-full h-full rounded-full pointer-events-none opacity-50 mix-blend-screen z-2"></div>
                  <div class="absolute w-9 h-9 rounded-full bg-[#090b0d] shadow-[0_4px_10px_rgba(0,0,0,0.6)] z-1"></div>
                  <div id="knob-volume" class="w-8 h-8 rounded-full cursor-ns-resize relative z-10 shadow-[inset_0_2px_2px_rgba(255,255,255,0.2),inset_0_-3px_8px_rgba(0,0,0,0.9)] border border-[#0a0a0a]" style="background: radial-gradient(circle at 50% 10%, #2a313c, #0a0c0f 80%);">
                    <div class="knob-knurl absolute inset-0 rounded-full opacity-25 mix-blend-overlay"></div>
                    <div class="absolute inset-1 rounded-full bg-linear-to-b from-[#1c222b] to-[#0a0c0f] shadow-[inset_0_1px_2px_rgba(255,255,255,0.1)] border border-[#050505]"></div>
                    <div class="knob-rotation-wrapper w-full h-full absolute top-0 left-0 pointer-events-none rounded-full">
                      <div class="knob-indicator w-0.5 h-3 mx-auto mt-1 rounded-full bg-linear-to-b from-[#f1f5f9] to-[#94a3b8] shadow-[inset_0_1px_2px_rgba(255,255,255,1),inset_0_-1px_2px_rgba(0,0,0,0.5)]"></div>
                    </div>
                    <div id="knob-hit-area" class="absolute inset-0 z-20 rounded-full cursor-grab active:cursor-grabbing"></div>
                  </div>
                </div>
              </div>

              <!-- Play / pause -->
              <button id="play-btn" class="pointer-events-auto px-5 py-2.5 bg-accent text-base font-mono font-black text-[11px] uppercase tracking-[0.2em] border border-accent-dim active:translate-y-px transition-transform shadow-[0_4px_12px_rgba(0,0,0,0.5)]">
                <span class="relative z-10">Play/Pause</span>
              </button>
            </div>
          </div>

          <!-- Scrub bar -->
          <div class="p-2.5 bg-[#050505] border border-black">
            <div id="scrub-container" class="w-full h-2 bg-black cursor-pointer relative overflow-hidden">
              <div id="scrub-progress" class="h-full bg-accent w-0 shadow-[0_0_10px_rgba(47,111,237,0.7)] relative"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== 02 // SERVICES ===================== -->
      <section class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-3 border-b border-line-strong bg-panel">
          <div class="flex items-center gap-3">
            <span class="text-accent font-mono text-xs font-bold">02</span>
            <span class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.35em]">Services / Signal Chain</span>
          </div>
          <span class="text-fg-faint font-mono text-[9px] uppercase tracking-[0.2em]">Tap a card</span>
        </div>

        <div id="services" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-line-strong">
          {services.map((service) => (
            <button
              type="button"
              class="service-card service-plate group h-56 text-left cursor-pointer relative overflow-hidden p-5 flex flex-col justify-between outline-none focus-visible:ring-1 focus-visible:ring-accent"
              data-num={service.num}
              data-title={service.title}
              data-tagline={service.tagline}
              data-detail={service.detail}
              data-price={service.price}
              data-note={service.note}
              data-revisions={service.revisions}
              data-hex={service.hex}
              data-reqs={JSON.stringify(service.reqs)}
              aria-haspopup="dialog"
            >
              <span class="plate-screw absolute top-2.5 left-2.5"></span>
              <span class="plate-screw absolute top-2.5 right-2.5"></span>
              <span class="plate-screw absolute bottom-2.5 left-2.5"></span>
              <span class="plate-screw absolute bottom-2.5 right-2.5"></span>

              <div class="flex items-start justify-between relative z-10">
                <span class="font-display text-5xl font-bold leading-none text-transparent [-webkit-text-stroke:1px_rgba(47,111,237,0.4)] group-hover:[-webkit-text-stroke:1px_rgba(47,111,237,0.7)] transition-all">{service.num}</span>
                <div class="w-4 h-4 rounded-full bg-black border border-line-strong flex items-center justify-center shadow-[inset_0_1px_2px_rgba(0,0,0,0.9)]">
                  <div class={`w-1.5 h-1.5 rounded-full ${service.wire} ${service.glow}`}></div>
                </div>
              </div>
              <div class="relative z-10">
                <h3 class="font-display text-lg font-bold uppercase tracking-tight text-fg leading-none plate-engrave">{service.title}</h3>
                <p class="mt-2 font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">{service.tagline}</p>
                {service.revisions && (
                  <p class="mt-2 font-mono text-[8px] uppercase tracking-[0.15em] text-accent">&#8635; {service.revisions}</p>
                )}
              </div>
              <div class="flex items-end justify-between border-t border-white/5 pt-3 relative z-10">
                <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint group-hover:text-accent transition-colors">Details &rarr;</span>
                <span class="font-display text-xl font-bold text-accent leading-none plate-engrave">{service.price}</span>
              </div>
            </button>
          ))}
        </div>
      </section>

      <!-- ===================== 03 // ENQUIRE ===================== -->
      <section class="border-b border-line-strong">
        <div class="flex items-center gap-3 px-4 md:px-5 py-3 border-b border-line-strong bg-panel">
          <span class="text-accent font-mono text-xs font-bold">03</span>
          <span class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.35em]">Enquire / There Are No Stupid Questions</span>
        </div>

        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-px bg-line-strong">
          <div class="bg-panel p-5">
            <label for="name" class="block font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint mb-2">Name / Artist</label>
            <input type="text" id="name" name="name" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors" />
          </div>
          <div class="bg-panel p-5">
            <label for="email" class="block font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors" />
          </div>
          <div class="bg-panel p-5 md:col-span-2">
            <label for="message" class="block font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint mb-2">Project Details</label>
            <textarea id="message" name="message" rows="5" required class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors"></textarea>
          </div>
          <div class="bg-panel p-5 md:col-span-2">
            <label for="attachment" class="block font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint mb-2">Attachments / Audio</label>
            <input type="file" id="attachment" name="attachment" multiple accept="audio/*,.wav,.mp3,.aiff,.aif,.flac,.zip" class="w-full bg-base border border-line-strong px-4 py-3 text-fg-muted font-mono text-[11px] tracking-wider outline-none focus:border-accent transition-colors cursor-pointer file:mr-4 file:py-1.5 file:px-3 file:border-0 file:bg-accent file:text-base file:font-mono file:font-bold file:text-[10px] file:uppercase file:tracking-widest file:cursor-pointer" />
            <p class="mt-2 font-mono text-[8px] uppercase tracking-[0.2em] text-fg-faint">WAV / MP3 / FLAC / ZIP. For large sessions, paste a download link in the details.</p>
          </div>
          <button type="submit" class="md:col-span-2 w-full py-4 bg-accent text-base font-mono font-black text-[13px] uppercase tracking-[0.3em] hover:bg-accent-bright active:translate-y-px transition-all">
            Send Enquiry
          </button>
        </form>
      </section>

      <!-- ===================== TRUSTED BY ===================== -->
      <section>
        <div class="flex items-center gap-3 px-4 md:px-5 py-3 border-b border-line-strong bg-panel">
          <span class="text-fg-faint font-mono text-[10px] uppercase tracking-[0.35em]">Trusted By</span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-10 p-6 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500">
          <img src="/logos/3000.jpg" class="h-7" alt="3000" />
          <img src="/logos/awd.jpg" class="h-7" alt="AWD" />
          <img src="/logos/ukf.jpg" class="h-7" alt="UKF" />
          <img src="/logos/gs.jpg" class="h-7" alt="GS" />
          <img src="/logos/gd.jpg" class="h-7" alt="GD" />
          <img src="/logos/uv.jpg" class="h-7" alt="UV" />
          <img src="/logos/motive.jpg" class="h-7" alt="Motive" />
        </div>
      </section>

    </div>
  </main>

  <ServiceModal />
</Layout>


<script>
  import { Howl, Howler } from 'howler';
  import * as THREE from 'three';
  import { gsap } from "gsap";
  import { Draggable } from "gsap/Draggable";

  gsap.registerPlugin(Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    // Service card click-to-open modal is handled by the shared ServiceModal component.

    let sound = new Howl({ src: ['/audio/Wanna Feel.mp3'], html5: false, volume: 0.5 });
    let analyser: AnalyserNode | null = null;
    let dataArray: Uint8Array<ArrayBuffer> | null = null;
    let bassEnvelope = 0; // smoothed low-end energy: fast attack, slow decay — see renderLoop

    const playBtn = document.getElementById('play-btn');
    const scrubContainer = document.getElementById('scrub-container');
    const progressBar = document.getElementById('scrub-progress');
    const trackSelector = document.getElementById('track-selector') as HTMLSelectElement;
    const knobHitArea = document.getElementById('knob-hit-area');
    const wrapper = document.querySelector('.knob-rotation-wrapper');
    const glowCore = document.getElementById('knob-glow-core');

    if (!playBtn || !scrubContainer || !knobHitArea) return;

    const container = document.getElementById('canvas-container');
    if (container) {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, container.clientWidth / 288, 0.1, 1000);
      camera.position.z = 6.5; // pulled back so the shape keeps clear of the box edges even on bass peaks
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, 288);
      renderer.domElement.style.display = 'block';
      container.appendChild(renderer.domElement);

      // Keep the canvas locked to the container width so the shape stays
      // horizontally centred and the visualiser reflows with the module.
      const resizeViz = () => {
        const w = container.clientWidth;
        renderer.setSize(w, 288);
        camera.aspect = w / 288;
        camera.updateProjectionMatrix();
      };
      new ResizeObserver(resizeViz).observe(container);

      // ---- Particle shapes ------------------------------------------------
      // Every shape below is generated with the exact same point count, in
      // the same index order, so point #412 in the sphere and point #412 in
      // the torus are "the same particle" — that's what lets them slide
      // smoothly from one form into the next instead of popping/scattering.
      const PARTICLE_COUNT = 4200;

      function sphereShape(count: number, radius: number) {
        const pts = new Float32Array(count * 3);
        const goldenAngle = Math.PI * (3 - Math.sqrt(5));
        for (let i = 0; i < count; i++) {
          const y = 1 - (i / (count - 1)) * 2;
          const r = Math.sqrt(Math.max(0, 1 - y * y));
          const theta = goldenAngle * i;
          pts[i * 3] = Math.cos(theta) * r * radius;
          pts[i * 3 + 1] = y * radius;
          pts[i * 3 + 2] = Math.sin(theta) * r * radius;
        }
        return pts;
      }

      // Rotates a point set around the X axis by a fixed angle. Used to tilt
      // shapes (like the torus) that would otherwise sit perfectly aligned
      // with a rotation axis and look like a flat 2D ring/face instead of a
      // tumbling 3D object.
      function tiltX(pts: Float32Array, angle: number) {
        const cos = Math.cos(angle), sin = Math.sin(angle);
        for (let i = 0; i < pts.length; i += 3) {
          const y = pts[i + 1], z = pts[i + 2];
          pts[i + 1] = y * cos - z * sin;
          pts[i + 2] = y * sin + z * cos;
        }
        return pts;
      }

      function torusShape(count: number, R: number, r: number) {
        const pts = new Float32Array(count * 3);
        const a = Math.PI * (3 - Math.sqrt(5));
        const b = Math.PI * 2 * 0.6180339887;
        for (let i = 0; i < count; i++) {
          const u = i * a;
          const v = i * b;
          pts[i * 3] = (R + r * Math.cos(v)) * Math.cos(u);
          pts[i * 3 + 1] = r * Math.sin(v);
          pts[i * 3 + 2] = (R + r * Math.cos(v)) * Math.sin(u);
        }
        return pts;
      }

      function cubeShape(count: number, size: number) {
        const pts = new Float32Array(count * 3);
        for (let i = 0; i < count; i++) {
          const face = i % 6;
          const u = (((i * 12.9898) % 1) * 2 - 1) * size;
          const v = (((i * 78.233) % 1) * 2 - 1) * size;
          let x = 0, y = 0, z = 0;
          if (face === 0) { x = size; y = u; z = v; }
          else if (face === 1) { x = -size; y = u; z = v; }
          else if (face === 2) { y = size; x = u; z = v; }
          else if (face === 3) { y = -size; x = u; z = v; }
          else if (face === 4) { z = size; x = u; y = v; }
          else { z = -size; x = u; y = v; }
          pts[i * 3] = x;
          pts[i * 3 + 1] = y;
          pts[i * 3 + 2] = z;
        }
        return pts;
      }

      function helixShape(count: number, radius: number, turns: number, height: number) {
        const pts = new Float32Array(count * 3);
        const half = Math.floor(count / 2);
        for (let i = 0; i < count; i++) {
          const onSecondStrand = i >= half;
          const idx = onSecondStrand ? i - half : i;
          const n = onSecondStrand ? count - half : half;
          const t = idx / n;
          const angle = t * Math.PI * 2 * turns + (onSecondStrand ? Math.PI : 0);
          pts[i * 3] = Math.cos(angle) * radius;
          pts[i * 3 + 1] = (t - 0.5) * height;
          pts[i * 3 + 2] = Math.sin(angle) * radius;
        }
        return pts;
      }

      const shapePositions = [
        sphereShape(PARTICLE_COUNT, 2),
        tiltX(torusShape(PARTICLE_COUNT, 1.5, 0.6), 0.95),
        tiltX(cubeShape(PARTICLE_COUNT, 1.6), 0.5),
        helixShape(PARTICLE_COUNT, 1.4, 2.5, 3.4),
      ];

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(shapePositions[0].slice(), 3));
      const material = new THREE.PointsMaterial({ size: 0.055, color: 0x2f6fed, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending });
      const points = new THREE.Points(geometry, material);
      points.position.y = 0; // centred in the screen; transport controls overlay the bottom
      scene.add(points);

      // ---- Particle colour: picked manually, audio reactivity still
      // modulates brightness/hue around whatever base colour is chosen here.
      const colorInput = document.getElementById('particle-color') as HTMLInputElement | null;
      const hslTarget = { h: 0, s: 0, l: 0 };
      new THREE.Color(colorInput?.value || '#2f6fed').getHSL(hslTarget);
      let baseHue = hslTarget.h;
      let baseSaturation = hslTarget.s;

      colorInput?.addEventListener('input', () => {
        new THREE.Color(colorInput.value).getHSL(hslTarget);
        baseHue = hslTarget.h;
        baseSaturation = hslTarget.s;
      });

      // ---- Morph scheduling ------------------------------------------------
      const HOLD_MS = 5200;     // how long a shape sits still before morphing on
      const MORPH_MS = 2200;    // how long the morph transition itself takes
      let shapeIndex = 0;
      let morphFrom = shapePositions[0];
      let morphTo = shapePositions[0];
      let morphProgress = 1;
      let phase: 'hold' | 'morphing' = 'hold';
      let phaseStart = performance.now();

      function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function startNextMorph(now: number) {
        const nextIndex = (shapeIndex + 1) % shapePositions.length;
        morphFrom = shapePositions[shapeIndex];
        morphTo = shapePositions[nextIndex];
        shapeIndex = nextIndex;
        phaseStart = now;
        morphProgress = 0;
      }

      function renderLoop() {
        requestAnimationFrame(renderLoop);
        const now = performance.now();
        const t = now * 0.001;

        if (phase === 'hold' && now - phaseStart > HOLD_MS) {
          startNextMorph(now);
          phase = 'morphing';
        } else if (phase === 'morphing') {
          morphProgress = Math.min(1, (now - phaseStart) / MORPH_MS);
          if (morphProgress >= 1) {
            phase = 'hold';
            phaseStart = now;
          }
        }
        const eased = easeInOutCubic(morphProgress);

        let vol = 0;
        if (sound.playing() && analyser && dataArray) {
          analyser.getByteFrequencyData(dataArray);
          vol = (dataArray.reduce((a: any, b: any) => a + b, 0) / dataArray.length) / 128;

          // Isolate roughly the bottom ~200Hz as "bass" rather than averaging
          // the whole spectrum together — that's what was drowning it out before.
          const nyquist = (Howler.ctx?.sampleRate || 44100) / 2;
          const binHz = nyquist / dataArray.length;
          const bassBinCount = Math.max(2, Math.round(200 / binHz));
          let bassSum = 0;
          for (let b = 0; b < bassBinCount; b++) bassSum += dataArray[b];
          const bassRaw = (bassSum / bassBinCount) / 255;

          // Fast attack so kicks/bass hits snap in immediately, slower decay
          // so they trail off instead of flickering — a punchier feel than
          // smoothing both directions equally.
          const attack = 0.55, decay = 0.07;
          bassEnvelope += (bassRaw - bassEnvelope) * (bassRaw > bassEnvelope ? attack : decay);
        } else {
          bassEnvelope += (0 - bassEnvelope) * 0.05; // ease back to rest when paused
        }
        const bass = bassEnvelope;

        const positions = geometry.attributes.position.array as Float32Array;
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          const i3 = i * 3;
          const bx = morphFrom[i3] + (morphTo[i3] - morphFrom[i3]) * eased;
          const by = morphFrom[i3 + 1] + (morphTo[i3 + 1] - morphFrom[i3 + 1]) * eased;
          const bz = morphFrom[i3 + 2] + (morphTo[i3 + 2] - morphFrom[i3 + 2]) * eased;

          const dist = Math.sqrt(bx * bx + by * by + bz * bz) || 1;
          const pattern = Math.sin(bx * 3 + t * 1.4) * Math.cos(by * 3 + t * 1.4);
          const ambientDrift = 0.05 * Math.sin(t * 0.8 + i * 0.0015); // keeps things alive even with no audio playing
          const push = pattern * (vol * 0.6 + bass * 1.4) + ambientDrift;

          positions[i3] = bx + (bx / dist) * push;
          positions[i3 + 1] = by + (by / dist) * push;
          positions[i3 + 2] = bz + (bz / dist) * push;
        }
        geometry.attributes.position.needsUpdate = true;

        // Bass pulls the whole cloud slightly tighter (denser-looking) while
        // growing and brightening each point — together it reads as a "thump"
        // rather than a generic wobble.
        points.scale.setScalar(1 - bass * 0.12);
        material.size = 0.05 + bass * 0.09;

        points.rotation.y += 0.0022 + vol * 0.003 + bass * 0.004;
        points.rotation.x += 0.0013 + bass * 0.0018;
        points.rotation.z += 0.0008 + vol * 0.0012;
        points.material.color.setHSL(baseHue, baseSaturation, 0.42 + bass * 0.22 + vol * 0.06);

        renderer.render(scene, camera);
      }
      renderLoop();
    }

    playBtn.addEventListener('click', () => {
      if (!analyser && Howler.ctx) {
        analyser = Howler.ctx.createAnalyser();
        analyser.fftSize = 1024;
        Howler.masterGain.connect(analyser);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
      }
      if (Howler.ctx?.state === 'suspended') Howler.ctx.resume();

      const btnSpan = playBtn.querySelector('span');
      if (sound.playing()) {
        sound.pause();
        if(btnSpan) btnSpan.textContent = 'Play';
      } else {
        sound.play();
        if(btnSpan) btnSpan.textContent = 'Pause';
      }
    });

    scrubContainer.addEventListener('click', (e: any) => {
      const rect = scrubContainer.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      sound.seek(pct * sound.duration());
    });

    setInterval(() => {
      if (sound.playing() && sound.duration() > 0 && progressBar) {
        progressBar.style.width = ((sound.seek() as number) / sound.duration() * 100) + '%';
      }
    }, 100);

    function updateKnobVisual(rotation: number) {
      if (wrapper) {
        (wrapper as HTMLElement).style.transform = `rotate(${rotation - 135}deg)`;
      }
      if (glowCore) {
        (glowCore as HTMLElement).style.background = `conic-gradient(from -135deg, rgba(47,111,237,0.35) 0deg ${rotation}deg, transparent 0deg)`;
      }
    }

    gsap.set(knobHitArea, { rotation: 135 });
    updateKnobVisual(135); // paint the halo/indicator immediately, matching the starting volume

    Draggable.create(knobHitArea, {
      type: "rotation",
      bounds: { minRotation: 0, maxRotation: 270 },
      onDrag: function() {
        updateKnobVisual(this.rotation);
        sound.volume(this.rotation / 270);
      }
    });

    trackSelector?.addEventListener('change', () => {
      sound.unload();
      sound = new Howl({ src: [trackSelector.value], html5: false, volume: sound.volume() });
      sound.play();
      const btnSpan = playBtn.querySelector('span');
      if(btnSpan) btnSpan.textContent = 'Pause';
    });
  });
</script>
