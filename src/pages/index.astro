---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="relative z-10 grow flex flex-col items-center justify-center p-8 w-full">
    
    <div class="max-w-3xl w-full text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-wood-100 mb-4 tracking-tight">
        Specialist Dance Music Mastering House
      </h1>
      <p class="text-sm md:text-base font-medium uppercase tracking-[0.25em] text-copper mb-8">
        Refining audio from the north
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-black/80 backdrop-blur-md border border-white/10 p-6 rounded-lg">
          <h3 class="text-white font-bold mb-2">Mastering</h3>
        </div>
        <div class="bg-black/80 backdrop-blur-md border border-white/10 p-6 rounded-lg">
          <h3 class="text-white font-bold mb-2">Mixing</h3>
        </div>
        <div class="bg-black/80 backdrop-blur-md border border-white/10 p-6 rounded-lg">
          <h3 class="text-white font-bold mb-2">Consultancy</h3>
        </div>
      </div>

      <div 
        id="canvas-container" 
        class="w-full h-75 bg-black rounded-lg shadow-2xl mb-8 overflow-hidden border border-neutral-800 relative"
      >
        </div>

      <button 
        id="play-btn" 
        class="px-8 py-3 bg-white text-black font-semibold rounded-full hover:bg-neutral-200 transition-colors duration-200"
      >
        Play Test Audio
      </button>
    </div>
  </main>
</Layout>

<script>
  import { Howl } from 'howler';
  import * as THREE from 'three';

  // --- AUDIO SETUP ---
  const sound = new Howl({
    src: ['https://actions.google.com/sounds/v1/science_fiction/alien_beacon.ogg'],
    html5: true,
    volume: 0.5
  });

  const button = document.getElementById('play-btn');
  button?.addEventListener('click', () => {
    if (!sound.playing()) {
      sound.play();
      button.textContent = 'Pause Audio';
    } else {
      sound.pause();
      button.textContent = 'Play Test Audio';
    }
  });

  // --- 3D SETUP ---
  const container = document.getElementById('canvas-container');
  if (container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.z = 5;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    const geometry = new THREE.IcosahedronGeometry(2, 0);
    const material = new THREE.MeshBasicMaterial({ 
      color: 0xd97736, // Your Copper accent
      wireframe: true,
      transparent: true,
      opacity: 0.5
    });
    const shape = new THREE.Mesh(geometry, material);
    scene.add(shape);

    function animate() {
      requestAnimationFrame(animate);
      shape.rotation.x += 0.005;
      shape.rotation.y += 0.005;
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }
</script>