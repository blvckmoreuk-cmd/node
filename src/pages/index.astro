---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="w-full min-h-screen bg-[#050608] flex flex-col items-center px-4 py-8 md:py-16 font-mono relative overflow-hidden">

    <div class="w-full max-w-4xl flex flex-col gap-8 md:gap-10 z-10">

      <section class="w-full px-1 md:px-2 flex flex-col items-center text-center">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
          <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-[#52555c]">About</span>
        </div>
        <div class="flex items-center gap-4 mb-12">
  <a href="/prices" 
     class="px-8 py-3 bg-[#171c22] border border-[#252c36] text-[#64748b] font-black text-[10px] uppercase tracking-[0.25em] rounded-sm hover:border-[#10b981] hover:text-[#10b981] transition-all">
     Price List
  </a>
  
  <a href="/contact" 
     class="px-8 py-3 bg-[#10b981] text-[#050608] font-black text-[10px] uppercase tracking-[0.25em] rounded-sm border border-[#064e3b] shadow-[0_4px_12px_rgba(16,185,129,0.3)] hover:bg-[#059669] transition-all">
     Get Started
  </a>
</div>
        <p class="text-sm md:text-base text-[#94a3b8] leading-relaxed max-w-2xl">
  Node Production are Dance Music Specialists based in Leeds<br/>
  <br/>
  Check out our work on the visualiser below or click <a href="/about" class="text-[#10b981] underline hover:text-[#34d399] transition-colors">here</a> to learn more.
</p>
      </section>

      <section class="w-full bg-[#0a0c0f] border border-[#14171c] rounded-lg p-6 md:p-8 relative">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
            <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-[#52555c]">Visualiser // Listen To Our Work</span>
          </div>

          <label class="flex items-center gap-2 cursor-pointer">
            <span class="text-[9px] tracking-[0.2em] uppercase text-[#52555c]">Particle Colour</span>
            <input id="particle-color" type="color" value="#10b981" class="w-6 h-6 rounded-sm bg-transparent cursor-pointer" />
          </label>
        </div>

        <div class="flex flex-col md:flex-row gap-10 items-start justify-between">

          <div class="flex-1 w-full flex flex-col gap-6">
            <div class="p-4 bg-[#0d1014] rounded-xl shadow-[0_8px_20px_rgba(0,0,0,0.5)] border-b border-r border-b-[#252c36] border-r-[#252c36] border-t-2 border-l-2 border-t-[#050608] border-l-[#050608] isolate">
              <div id="canvas-container" class="w-full h-64 bg-[#030605] rounded shadow-[inset_0_0_40px_rgba(0,0,0,0.9)] border border-black overflow-hidden relative">
                <div class="absolute inset-0 bg-[radial-gradient(120%_100%_at_50%_0%,rgba(255,255,255,0.08)_0%,transparent_50%)] pointer-events-none z-10"></div>
                <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0)_50%,rgba(0,0,0,0.3)_50%)] bg-size-[100%_4px] pointer-events-none z-10 opacity-60"></div>
              </div>
            </div>

            <div class="relative w-full shadow-[0_4px_10px_rgba(0,0,0,0.5)] rounded">
              <select id="track-selector" class="w-full bg-[#0a0c0f] border-t border-l border-t-black border-l-black border-b border-r border-b-[#252c36] border-r-[#252c36] text-[#10b981] px-5 py-4 rounded text-[11px] font-bold uppercase tracking-widest cursor-pointer outline-none shadow-[inset_0_5px_15px_rgba(0,0,0,1)] appearance-none">
                <option value="/audio/Wanna Feel.mp3">Track 01: Wanna Feel // Mix/Master</option>
                <option value="/audio/BE OK.mp3">Track 02: BE OK // FULL PRODUCTION</option>
                <option value="/audio/Sure Thing.mp3">Track 03: SURE THING // MASTER</option>
                <option value="/audio/2HOT.mp3">Track 04: 2HOT // MASTER</option>
                <option value="/audio/wet-morry.mp3">Track 05: WET // MASTER</option>
                <option value="/audio/tellmehowtorave-casmalia.mp3">Track 06: TELL ME HOW TO RAVE // Mix/Master</option>
              </select>
              <div class="absolute right-5 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-[#10b981] shadow-[0_0_8px_rgba(16,185,129,0.9),inset_0_1px_1px_rgba(255,255,255,0.6)] pointer-events-none border border-[#022c22]"></div>
            </div>
          </div>

          <div class="flex flex-col items-center justify-center gap-10 bg-[#171c22] p-8 rounded-xl border-t border-l border-t-[#2d3642] border-l-[#2d3642] border-b-2 border-r-2 border-b-[#090b0d] border-r-[#090b0d] shadow-[0_12px_25px_rgba(0,0,0,0.55)] w-full md:w-auto relative isolate">

            <div class="absolute top-4 left-4 w-2 h-2 rounded-full bg-[#0a0a0a] shadow-[inset_0_1px_2px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.1)]"></div>
            <div class="absolute top-4 right-4 w-2 h-2 rounded-full bg-[#0a0a0a] shadow-[inset_0_1px_2px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.1)]"></div>

            <div class="text-[10px] font-black uppercase tracking-[0.3em] text-[#64748b] bg-[#0d1014] px-4 py-1.5 rounded-sm shadow-[inset_0_1px_3px_rgba(0,0,0,0.9)] border border-[#050608] relative z-10">Master Vol</div>

            <div class="relative flex items-center justify-center w-40 h-40">
              <div id="knob-glow-core" class="absolute w-full h-full rounded-full pointer-events-none opacity-50 mix-blend-screen z-2"></div>

              <div class="absolute w-36 h-36 rounded-full bg-[#090b0d] shadow-[0_10px_18px_rgba(0,0,0,0.6)] z-1"></div>

              <div id="knob-volume" class="w-32 h-32 rounded-full cursor-ns-resize relative z-10 shadow-[inset_0_2px_2px_rgba(255,255,255,0.2),inset_0_-5px_15px_rgba(0,0,0,0.9)] border border-[#0a0a0a]" style="background: radial-gradient(circle at 50% 10%, #2a313c, #0a0c0f 80%);">

                <div class="knob-knurl absolute inset-0 rounded-full opacity-25 mix-blend-overlay"></div>

                <div class="absolute inset-4 rounded-full bg-linear-to-b from-[#1c222b] to-[#0a0c0f] shadow-[inset_0_1px_2px_rgba(255,255,255,0.1)] border border-[#050505]"></div>

                <div class="knob-rotation-wrapper w-full h-full absolute top-0 left-0 pointer-events-none rounded-full">
                  <div class="knob-indicator w-1.5 h-10 mx-auto mt-2 rounded-full bg-linear-to-b from-[#f1f5f9] to-[#94a3b8] shadow-[inset_0_1px_2px_rgba(255,255,255,1),inset_0_-1px_2px_rgba(0,0,0,0.5)]"></div>
                </div>

                <div id="knob-hit-area" class="absolute inset-0 z-20 rounded-full cursor-grab active:cursor-grabbing"></div>
              </div>
            </div>

            <button id="play-btn" class="w-full px-8 py-3 bg-linear-to-b from-[#94a3b8] to-[#64748b] text-[#0f172a] font-black text-[12px] uppercase tracking-[0.25em] rounded-sm border-t border-l border-t-[#cbd5e1] border-l-[#cbd5e1] border-b-[3px] border-r-[3px] border-b-[#334155] border-r-[#334155] shadow-[0_4px_8px_rgba(0,0,0,0.45)] active:translate-y-0.5 active:translate-x-0.5 active:shadow-[0_2px_4px_rgba(0,0,0,0.8),inset_0_4px_8px_rgba(0,0,0,0.6)] transition-all duration-75 relative z-10">
               <span class="relative z-10" style="text-shadow: 0 1px 0 rgba(255,255,255,0.3);">Play/Pause</span>
            </button>
          </div>
        </div>

        <div class="mt-10 p-3 bg-[#0a0c0f] border-t border-l border-t-black border-l-black border-b border-r border-b-[#252c36] border-r-[#252c36] rounded shadow-[inset_0_8px_15px_rgba(0,0,0,1)] isolate">
          <div id="scrub-container" class="w-full h-3 bg-[#050505] rounded-full cursor-pointer relative overflow-hidden shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)] border border-black">
            <div id="scrub-progress" class="h-full bg-linear-to-b from-[#34d399] via-[#10b981] to-[#059669] w-0 shadow-[0_0_12px_rgba(16,185,129,0.8)] rounded-full relative">
               <div class="absolute top-0 left-0 w-full h-[40%] bg-white opacity-20 rounded-t-full"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="w-full bg-[#0a0c0f] border border-[#14171c] rounded-lg p-6 md:p-8 relative">
        <div class="flex items-center gap-2 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
          <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-[#52555c]">Services</span>
        </div>

        <div id="services" class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <svg id="cable-layer" class="absolute inset-0 w-full h-full pointer-events-none" preserveAspectRatio="none" aria-hidden="true"></svg>
        {[
          { title: 'Production', slug: 'production', detail: 'Ghost Production // Finish your track', color: 'from-[#e0c590] to-[#967a3f]', wire: 'bg-red-500', glow: 'shadow-[0_0_10px_rgba(239,68,68,0.9)]' },
          { title: 'Mixing', slug: 'mixing', detail: 'Balance, Width, Depth and a Pro Master - Full lows and crispy highs', color: 'from-[#e0c590] to-[#967a3f]', wire: 'bg-blue-500', glow: 'shadow-[0_0_10px_rgba(59,130,246,0.9)]' },
          { title: 'Mastering', slug: 'mastering', detail: 'Industry Standard Loudness and depth - Analogue Preamps', color: 'from-[#e0c590] to-[#967a3f]', wire: 'bg-yellow-400', glow: 'shadow-[0_0_10px_rgba(250,204,21,0.9)]' },
          { title: 'Education', slug: 'education', detail: '1-on-1 Ableton Mentoring', color: 'from-[#e0c590] to-[#967a3f]', wire: 'bg-green-500', glow: 'shadow-[0_0_10px_rgba(34,197,94,0.9)]' },
          { title: 'Sound Design', slug: 'sounddesign', detail: 'Custom Patch Creation', color: 'from-[#e0c590] to-[#967a3f]', wire: 'bg-purple-500', glow: 'shadow-[0_0_10px_rgba(168,85,247,0.9)]' },
          { title: 'Consulting', slug: 'consulting', detail: 'Send us your track. We will write a professional analysis and hold a 1-1 video call to discuss', color: 'from-[#e0c590] to-[#967a3f]', wire: 'bg-orange-500', glow: 'shadow-[0_0_10px_rgba(249,115,22,0.9)]' }
        ].map((service) => (
          <div class="service-card group h-72 perspective-distant cursor-pointer isolate">
            <div class="service-card-inner relative w-full h-full transition-transform duration-700 transform-3d">

              <div class={`brushed-metal absolute w-full h-full p-6 flex flex-col justify-center items-center backface-hidden bg-linear-to-b ${service.color} border-t border-l border-t-[#fae8bf] border-l-[#fae8bf] border-b-[3px] border-r-[3px] border-b-[#423216] border-r-[#423216] shadow-[0_10px_18px_rgba(0,0,0,0.5)] rounded-sm overflow-hidden`}>

                <div class="absolute top-[calc(50%-1.5px)] left-0 w-full h-0.75 bg-[#2e230f] border-b border-[#ffffff40] z-0 shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]"></div>

                <div class="absolute top-5 w-full flex justify-center gap-6 z-10">
                  <div class="w-5 h-5 rounded-full bg-[#0a0a0a] border border-[#594827] shadow-[inset_0_3px_5px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.2)] flex items-center justify-center">
                     <div class={`w-2 h-2 rounded-full ${service.wire} ${service.glow}`} data-jack={`card-${service.slug}`}></div>
                  </div>
                  <div class="w-5 h-5 rounded-full bg-[#0a0a0a] border border-[#594827] shadow-[inset_0_3px_5px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.2)]"></div>
                </div>

                <div class="absolute top-2 left-2 w-1.5 h-1.5 rounded-full bg-[#2e230f] shadow-[inset_0_1px_1px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.3)]"></div>
                <div class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-[#2e230f] shadow-[inset_0_1px_1px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.3)]"></div>
                <div class="absolute bottom-2 left-2 w-1.5 h-1.5 rounded-full bg-[#2e230f] shadow-[inset_0_1px_1px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.3)]"></div>
                <div class="absolute bottom-2 right-2 w-1.5 h-1.5 rounded-full bg-[#2e230f] shadow-[inset_0_1px_1px_rgba(0,0,0,1),0_1px_0_rgba(255,255,255,0.3)]"></div>

                <span class="text-[14px] font-black uppercase tracking-[0.25em] text-[#2e230f] relative z-10 bg-[#c7ab71] px-4 py-2 border border-[#856b3c] shadow-[inset_0_1px_1px_rgba(255,255,255,0.4),0_3px_6px_rgba(0,0,0,0.4)]" style="text-shadow: 0 1px 0 rgba(255,255,255,0.3);">{service.title}</span>
              </div>

              <div class="grain-overlay-dark absolute w-full h-full p-6 flex flex-col justify-between items-center backface-hidden transform-[rotateY(180deg)] bg-[#0d1014] border-t border-l border-t-black border-l-black border-b-2 border-r-2 border-b-[#252c36] border-r-[#252c36] shadow-[inset_0_10px_20px_rgba(0,0,0,0.7)] rounded-sm text-[#e0c590] overflow-hidden">
                <div class="absolute inset-0 opacity-15 bg-[linear-gradient(transparent_49%,#e0c590_50%,transparent_51%),linear-gradient(90deg,transparent_49%,#e0c590_50%,transparent_51%)] bg-size-[12px_12px] pointer-events-none"></div>

                <div class="absolute top-0 left-0 w-full h-1/2 bg-[radial-gradient(120%_100%_at_50%_0%,rgba(255,255,255,0.05)_0%,transparent_50%)] pointer-events-none"></div>

                <div class="text-[10px] uppercase font-bold tracking-[0.2em] mb-2 z-10 border-b border-[#594827] pb-2 w-full text-center" style="text-shadow: 0 1px 2px rgba(0,0,0,1);">System Specs</div>
                <span class="text-[11px] uppercase tracking-widest text-center leading-relaxed z-10 font-mono" style="text-shadow: 0 0 5px rgba(224,197,144,0.4);">{service.detail}</span>

                <div class="w-full flex justify-between items-end z-10">
                  <div class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.9),inset_0_1px_2px_rgba(255,255,255,0.4)] animate-pulse border border-[#450a0a]"></div>
                  <div class="text-[9px] uppercase tracking-widest bg-[#e0c590] text-[#111] px-3 py-1 font-bold shadow-[0_2px_5px_rgba(0,0,0,0.6)]">View Prices</div>
                </div>
              </div>
            </div>
          </div>
        ))}
        </div>
      </section>

      <section class="w-full bg-[#0a0c0f] border border-[#14171c] rounded-lg p-6 md:p-8 relative">
        <div class="flex items-center gap-4 mb-8 bg-[#0d1014] w-fit p-3 border border-[#050608] shadow-[inset_0_1px_3px_rgba(0,0,0,0.9)]">
          <div class="w-2.5 h-2.5 rounded-full bg-[#10b981] shadow-[0_0_10px_rgba(16,185,129,0.9),inset_0_1px_1px_rgba(255,255,255,0.5)] border border-[#022c22]"></div>
          <h2 class="text-sm font-black uppercase tracking-[0.3em] text-[#64748b]">Enquire // There is no such thing as a stupid question</h2>
        </div>

        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6 p-8 bg-[#0d1014] border-t border-l border-t-black border-l-black border-b border-r border-b-[#252c36] border-r-[#252c36] rounded shadow-[inset_0_15px_30px_rgba(0,0,0,0.7)] relative isolate overflow-hidden">
           <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(rgba(255,255,255,1)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,1)_1px,transparent_1px)] bg-size-[12px_12px] pointer-events-none"></div>

          <div class="flex flex-col gap-3 relative z-10">
            <label class="text-[9px] font-bold uppercase tracking-widest text-[#64748b] bg-[#050608] w-fit px-2 py-1 border border-[#171c22]">[Name]</label>
            <input type="text" name="name" required class="bg-[#050608] border border-[#171c22] p-4 text-[#10b981] text-xs font-bold tracking-wider rounded-sm outline-none focus:border-[#10b981] focus:shadow-[0_0_12px_rgba(16,185,129,0.2)] shadow-[inset_0_2px_6px_rgba(0,0,0,0.9)]" />
          </div>
          <div class="flex flex-col gap-3 relative z-10">
            <label class="text-[9px] font-bold uppercase tracking-widest text-[#64748b] bg-[#050608] w-fit px-2 py-1 border border-[#171c22]">[Email]</label>
            <input type="email" name="email" required class="bg-[#050608] border border-[#171c22] p-4 text-[#10b981] text-xs font-bold tracking-wider rounded-sm outline-none focus:border-[#10b981] focus:shadow-[0_0_12px_rgba(16,185,129,0.2)] shadow-[inset_0_2px_6px_rgba(0,0,0,0.9)]" />
          </div>
          <div class="col-span-1 md:col-span-2 flex flex-col gap-3 relative z-10">
            <label class="text-[9px] font-bold uppercase tracking-widest text-[#64748b] bg-[#050608] w-fit px-2 py-1 border border-[#171c22]">[Message]</label>
            <textarea name="message" rows="5" required class="bg-[#050608] border border-[#171c22] p-4 text-[#10b981] text-xs font-bold tracking-wider rounded-sm outline-none focus:border-[#10b981] focus:shadow-[0_0_12px_rgba(16,185,129,0.2)] shadow-[inset_0_2px_6px_rgba(0,0,0,0.9)]"></textarea>
          </div>

          <button type="submit" class="col-span-1 md:col-span-2 w-full py-4 mt-4 bg-linear-to-r from-[#2d3642] to-[#1e252e] text-[#10b981] font-black text-[13px] uppercase tracking-[0.3em] rounded-sm border-t border-l border-t-[#475569] border-l-[#475569] border-b-[3px] border-r-[3px] border-b-[#0f172a] border-r-[#0f172a] hover:from-[#3a4454] hover:to-[#252c36] transition-all shadow-[0_4px_8px_rgba(0,0,0,0.4)] active:translate-y-0.5 active:translate-x-0.5 active:shadow-[0_2px_4px_rgba(0,0,0,0.8),inset_0_4px_8px_rgba(0,0,0,0.8)] relative z-10">
            Send
          </button>
        </form>
      </section>

      <section class="w-full flex flex-wrap justify-center items-center gap-10 opacity-40 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-700 p-6 border border-[#14171c] rounded-lg">
        <img src="/logos/3000.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="3000" />
        <img src="/logos/awd.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="AWD" />
        <img src="/logos/ukf.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="UKF" />
        <img src="/logos/gs.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="GS" />
        <img src="/logos/gd.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="GD" />
        <img src="/logos/uv.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="UV" />
        <img src="/logos/motive.jpg" class="h-8 rounded shadow-[0_2px_4px_rgba(0,0,0,0.5)]" alt="Motive" />
      </section>

    </div>
  </main>
</Layout>


<script>
  import { Howl, Howler } from 'howler';
  import * as THREE from 'three';
  import { gsap } from "gsap";
  import { Draggable } from "gsap/Draggable";

  gsap.registerPlugin(Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.service-card').forEach((card) => {
  if (window.matchMedia('(hover: hover)').matches) {
    // Has a real mouse — flip on hover, just like before
    card.addEventListener('mouseenter', () => card.classList.add('is-flipped'));
    card.addEventListener('mouseleave', () => card.classList.remove('is-flipped'));
  } else {
    // Touch device — flip on tap
    card.addEventListener('click', () => card.classList.toggle('is-flipped'));
  }
});
    let sound = new Howl({ src: ['/audio/Wanna Feel.mp3'], html5: false, volume: 0.5 });
    let analyser: AnalyserNode | null = null;
    let dataArray: Uint8Array<ArrayBuffer> | null = null;
    let bassEnvelope = 0; // smoothed low-end energy: fast attack, slow decay — see renderLoop

    const playBtn = document.getElementById('play-btn');
    const scrubContainer = document.getElementById('scrub-container');
    const progressBar = document.getElementById('scrub-progress');
    const trackSelector = document.getElementById('track-selector') as HTMLSelectElement;
    const knobHitArea = document.getElementById('knob-hit-area');
    const wrapper = document.querySelector('.knob-rotation-wrapper');
    const glowCore = document.getElementById('knob-glow-core');

    if (!playBtn || !scrubContainer || !knobHitArea) return;

    const container = document.getElementById('canvas-container');
    if (container) {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, container.clientWidth / 256, 0.1, 1000);
      camera.position.z = 5;
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, 256);
      container.appendChild(renderer.domElement);

      // ---- Particle shapes ------------------------------------------------
      // Every shape below is generated with the exact same point count, in
      // the same index order, so point #412 in the sphere and point #412 in
      // the torus are "the same particle" — that's what lets them slide
      // smoothly from one form into the next instead of popping/scattering.
      const PARTICLE_COUNT = 4200;

      function sphereShape(count: number, radius: number) {
        const pts = new Float32Array(count * 3);
        const goldenAngle = Math.PI * (3 - Math.sqrt(5));
        for (let i = 0; i < count; i++) {
          const y = 1 - (i / (count - 1)) * 2;
          const r = Math.sqrt(Math.max(0, 1 - y * y));
          const theta = goldenAngle * i;
          pts[i * 3] = Math.cos(theta) * r * radius;
          pts[i * 3 + 1] = y * radius;
          pts[i * 3 + 2] = Math.sin(theta) * r * radius;
        }
        return pts;
      }

      // Rotates a point set around the X axis by a fixed angle. Used to tilt
      // shapes (like the torus) that would otherwise sit perfectly aligned
      // with a rotation axis and look like a flat 2D ring/face instead of a
      // tumbling 3D object.
      function tiltX(pts: Float32Array, angle: number) {
        const cos = Math.cos(angle), sin = Math.sin(angle);
        for (let i = 0; i < pts.length; i += 3) {
          const y = pts[i + 1], z = pts[i + 2];
          pts[i + 1] = y * cos - z * sin;
          pts[i + 2] = y * sin + z * cos;
        }
        return pts;
      }

      function torusShape(count: number, R: number, r: number) {
        const pts = new Float32Array(count * 3);
        const a = Math.PI * (3 - Math.sqrt(5));
        const b = Math.PI * 2 * 0.6180339887;
        for (let i = 0; i < count; i++) {
          const u = i * a;
          const v = i * b;
          pts[i * 3] = (R + r * Math.cos(v)) * Math.cos(u);
          pts[i * 3 + 1] = r * Math.sin(v);
          pts[i * 3 + 2] = (R + r * Math.cos(v)) * Math.sin(u);
        }
        return pts;
      }

      function cubeShape(count: number, size: number) {
        const pts = new Float32Array(count * 3);
        for (let i = 0; i < count; i++) {
          const face = i % 6;
          const u = (((i * 12.9898) % 1) * 2 - 1) * size;
          const v = (((i * 78.233) % 1) * 2 - 1) * size;
          let x = 0, y = 0, z = 0;
          if (face === 0) { x = size; y = u; z = v; }
          else if (face === 1) { x = -size; y = u; z = v; }
          else if (face === 2) { y = size; x = u; z = v; }
          else if (face === 3) { y = -size; x = u; z = v; }
          else if (face === 4) { z = size; x = u; y = v; }
          else { z = -size; x = u; y = v; }
          pts[i * 3] = x;
          pts[i * 3 + 1] = y;
          pts[i * 3 + 2] = z;
        }
        return pts;
      }

      function helixShape(count: number, radius: number, turns: number, height: number) {
        const pts = new Float32Array(count * 3);
        const half = Math.floor(count / 2);
        for (let i = 0; i < count; i++) {
          const onSecondStrand = i >= half;
          const idx = onSecondStrand ? i - half : i;
          const n = onSecondStrand ? count - half : half;
          const t = idx / n;
          const angle = t * Math.PI * 2 * turns + (onSecondStrand ? Math.PI : 0);
          pts[i * 3] = Math.cos(angle) * radius;
          pts[i * 3 + 1] = (t - 0.5) * height;
          pts[i * 3 + 2] = Math.sin(angle) * radius;
        }
        return pts;
      }

      const shapePositions = [
        sphereShape(PARTICLE_COUNT, 2),
        tiltX(torusShape(PARTICLE_COUNT, 1.5, 0.6), 0.95),
        tiltX(cubeShape(PARTICLE_COUNT, 1.6), 0.5),
        helixShape(PARTICLE_COUNT, 1.4, 2.5, 3.4),
      ];

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(shapePositions[0].slice(), 3));
      const material = new THREE.PointsMaterial({ size: 0.055, color: 0x10b981, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending });
      const points = new THREE.Points(geometry, material);
      scene.add(points);

      // ---- Particle colour: picked manually, audio reactivity still
      // modulates brightness/hue around whatever base colour is chosen here.
      const colorInput = document.getElementById('particle-color') as HTMLInputElement | null;
      const hslTarget = { h: 0, s: 0, l: 0 };
      new THREE.Color(colorInput?.value || '#10b981').getHSL(hslTarget);
      let baseHue = hslTarget.h;
      let baseSaturation = hslTarget.s;

      colorInput?.addEventListener('input', () => {
        new THREE.Color(colorInput.value).getHSL(hslTarget);
        baseHue = hslTarget.h;
        baseSaturation = hslTarget.s;
      });

      // ---- Morph scheduling ------------------------------------------------
      const HOLD_MS = 5200;     // how long a shape sits still before morphing on
      const MORPH_MS = 2200;    // how long the morph transition itself takes
      let shapeIndex = 0;
      let morphFrom = shapePositions[0];
      let morphTo = shapePositions[0];
      let morphProgress = 1;
      let phase: 'hold' | 'morphing' = 'hold';
      let phaseStart = performance.now();

      function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function startNextMorph(now: number) {
        const nextIndex = (shapeIndex + 1) % shapePositions.length;
        morphFrom = shapePositions[shapeIndex];
        morphTo = shapePositions[nextIndex];
        shapeIndex = nextIndex;
        phaseStart = now;
        morphProgress = 0;
      }

      function renderLoop() {
        requestAnimationFrame(renderLoop);
        const now = performance.now();
        const t = now * 0.001;

        if (phase === 'hold' && now - phaseStart > HOLD_MS) {
          startNextMorph(now);
          phase = 'morphing';
        } else if (phase === 'morphing') {
          morphProgress = Math.min(1, (now - phaseStart) / MORPH_MS);
          if (morphProgress >= 1) {
            phase = 'hold';
            phaseStart = now;
          }
        }
        const eased = easeInOutCubic(morphProgress);

        let vol = 0;
        if (sound.playing() && analyser && dataArray) {
          analyser.getByteFrequencyData(dataArray);
          vol = (dataArray.reduce((a: any, b: any) => a + b, 0) / dataArray.length) / 128;

          // Isolate roughly the bottom ~200Hz as "bass" rather than averaging
          // the whole spectrum together — that's what was drowning it out before.
          const nyquist = (Howler.ctx?.sampleRate || 44100) / 2;
          const binHz = nyquist / dataArray.length;
          const bassBinCount = Math.max(2, Math.round(200 / binHz));
          let bassSum = 0;
          for (let b = 0; b < bassBinCount; b++) bassSum += dataArray[b];
          const bassRaw = (bassSum / bassBinCount) / 255;

          // Fast attack so kicks/bass hits snap in immediately, slower decay
          // so they trail off instead of flickering — a punchier feel than
          // smoothing both directions equally.
          const attack = 0.55, decay = 0.07;
          bassEnvelope += (bassRaw - bassEnvelope) * (bassRaw > bassEnvelope ? attack : decay);
        } else {
          bassEnvelope += (0 - bassEnvelope) * 0.05; // ease back to rest when paused
        }
        const bass = bassEnvelope;

        const positions = geometry.attributes.position.array as Float32Array;
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          const i3 = i * 3;
          const bx = morphFrom[i3] + (morphTo[i3] - morphFrom[i3]) * eased;
          const by = morphFrom[i3 + 1] + (morphTo[i3 + 1] - morphFrom[i3 + 1]) * eased;
          const bz = morphFrom[i3 + 2] + (morphTo[i3 + 2] - morphFrom[i3 + 2]) * eased;

          const dist = Math.sqrt(bx * bx + by * by + bz * bz) || 1;
          const pattern = Math.sin(bx * 3 + t * 1.4) * Math.cos(by * 3 + t * 1.4);
          const ambientDrift = 0.05 * Math.sin(t * 0.8 + i * 0.0015); // keeps things alive even with no audio playing
          const push = pattern * (vol * 0.6 + bass * 1.4) + ambientDrift;

          positions[i3] = bx + (bx / dist) * push;
          positions[i3 + 1] = by + (by / dist) * push;
          positions[i3 + 2] = bz + (bz / dist) * push;
        }
        geometry.attributes.position.needsUpdate = true;

        // Bass pulls the whole cloud slightly tighter (denser-looking) while
        // growing and brightening each point — together it reads as a "thump"
        // rather than a generic wobble.
        points.scale.setScalar(1 - bass * 0.12);
        material.size = 0.05 + bass * 0.09;

        points.rotation.y += 0.0022 + vol * 0.003 + bass * 0.004;
        points.rotation.x += 0.0013 + bass * 0.0018;
        points.rotation.z += 0.0008 + vol * 0.0012;
        points.material.color.setHSL(baseHue, baseSaturation, 0.42 + bass * 0.22 + vol * 0.06);

        renderer.render(scene, camera);
      }
      renderLoop();
    }

    playBtn.addEventListener('click', () => {
      if (!analyser && Howler.ctx) {
        analyser = Howler.ctx.createAnalyser();
        analyser.fftSize = 1024;
        Howler.masterGain.connect(analyser);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
      }
      if (Howler.ctx?.state === 'suspended') Howler.ctx.resume();

      const btnSpan = playBtn.querySelector('span');
      if (sound.playing()) {
        sound.pause();
        if(btnSpan) btnSpan.textContent = 'Play';
      } else {
        sound.play();
        if(btnSpan) btnSpan.textContent = 'Pause';
      }
    });

    scrubContainer.addEventListener('click', (e: any) => {
      const rect = scrubContainer.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      sound.seek(pct * sound.duration());
    });

    setInterval(() => {
      if (sound.playing() && sound.duration() > 0 && progressBar) {
        progressBar.style.width = ((sound.seek() as number) / sound.duration() * 100) + '%';
      }
    }, 100);

    function updateKnobVisual(rotation: number) {
      if (wrapper) {
        (wrapper as HTMLElement).style.transform = `rotate(${rotation - 135}deg)`;
      }
      if (glowCore) {
        (glowCore as HTMLElement).style.background = `conic-gradient(from -135deg, rgba(16,185,129,0.35) 0deg ${rotation}deg, transparent 0deg)`;
      }
    }

    gsap.set(knobHitArea, { rotation: 135 });
    updateKnobVisual(135); // paint the halo/indicator immediately, matching the starting volume

    Draggable.create(knobHitArea, {
      type: "rotation",
      bounds: { minRotation: 0, maxRotation: 270 },
      onDrag: function() {
        updateKnobVisual(this.rotation);
        sound.volume(this.rotation / 270);
      }
    });

    trackSelector?.addEventListener('change', () => {
      sound.unload();
      sound = new Howl({ src: [trackSelector.value], html5: false, volume: sound.volume() });
      sound.play();
      const btnSpan = playBtn.querySelector('span');
      if(btnSpan) btnSpan.textContent = 'Pause';
    });

    // ---- Patch cables: wire the service-card jacks together -------------
    const cableSvg = document.getElementById('cable-layer') as SVGSVGElement | null;
    const cableSection = document.getElementById('services');

    function jackPoint(slug: string, boardRect: DOMRect) {
      const el = document.querySelector(`[data-jack="card-${slug}"]`);
      if (!el) return null;
      const r = el.getBoundingClientRect();
      return { x: r.left + r.width / 2 - boardRect.left, y: r.top + r.height / 2 - boardRect.top };
    }

    function drawCable(d1: { x: number, y: number } | null, d2: { x: number, y: number } | null, colorClass: string) {
      if (!cableSvg || !d1 || !d2) return;
      const sag = Math.min(70, Math.abs(d2.x - d1.x) * 0.3 + 24);
      const path = `M ${d1.x} ${d1.y} C ${d1.x} ${d1.y + sag}, ${d2.x} ${d2.y - sag}, ${d2.x} ${d2.y}`;
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      el.setAttribute('d', path);
      el.setAttribute('class', `cable ${colorClass}`);
      cableSvg.appendChild(el);
    }

    function drawAllCables() {
      if (!cableSvg || !cableSection) return;
      const boardRect = cableSection.getBoundingClientRect();
      cableSvg.setAttribute('width', String(boardRect.width));
      cableSvg.setAttribute('height', String(boardRect.height));
      cableSvg.setAttribute('viewBox', `0 0 ${boardRect.width} ${boardRect.height}`);
      cableSvg.innerHTML = '';

      const pts = {
        production: jackPoint('production', boardRect),
        mixing: jackPoint('mixing', boardRect),
        mastering: jackPoint('mastering', boardRect),
        education: jackPoint('education', boardRect),
        sounddesign: jackPoint('sounddesign', boardRect),
        consulting: jackPoint('consulting', boardRect),
      };

      drawCable(pts.production, pts.mixing, 'cable-red');
      drawCable(pts.mixing, pts.mastering, 'cable-blue');
      drawCable(pts.production, pts.education, 'cable-red');
      drawCable(pts.mixing, pts.sounddesign, 'cable-blue');
      drawCable(pts.mastering, pts.consulting, 'cable-yellow');
      drawCable(pts.education, pts.sounddesign, 'cable-green');
      drawCable(pts.sounddesign, pts.consulting, 'cable-purple');
    }

    // Draw once now, then again on full load and on resize — covers fast
    // paint, late image/font settling, and breakpoint changes.
    drawAllCables();
    window.addEventListener('load', () => setTimeout(drawAllCables, 50));
    let cableResizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(cableResizeTimer);
      cableResizeTimer = setTimeout(drawAllCables, 150);
    });
  });
</script>
<style>
  .service-card {
    -webkit-perspective: 1000px;
    perspective: 1000px;
  }

  .service-card-inner {
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
  }

  .service-card.is-flipped .service-card-inner {
    -webkit-transform: rotateY(180deg) translateZ(0);
    transform: rotateY(180deg) translateZ(0);
  }

  .brushed-metal {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .grain-overlay-dark {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: rotateY(180deg) translateZ(0);
    transform: rotateY(180deg) translateZ(0);
  }
</style>