---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="grow flex flex-col items-center justify-center p-6 md:p-12 w-full max-w-5xl mx-auto">
    
    <div class="w-full text-center mt-4 mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-wood-100 mb-4 tracking-tight">
        Specialist Dance Music Mastering House
      </h1>
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-copper">
        Refining audio from the north
      </p>
    </div>

    <section class="w-full mb-16">
      <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-wood-400 mb-6 text-center md:text-left">
        Services & Engineering
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-wood-800/40 border border-wood-800 p-6 rounded-lg hover:border-copper/40 transition-colors duration-300">
          <span class="text-xs font-mono text-copper tracking-wider block mb-3">01 //</span>
          <h3 class="text-lg font-bold text-wood-100 mb-2">Stereo Mastering</h3>
          <p class="text-sm text-wood-400 leading-relaxed">
            Precision final optimization for club sound systems. Balancing translatability, sub-bass weight, and competitive loudness.
          </p>
        </div>

        <div class="bg-wood-800/40 border border-wood-800 p-6 rounded-lg hover:border-copper/40 transition-colors duration-300">
          <span class="text-xs font-mono text-copper tracking-wider block mb-3">02 //</span>
          <h3 class="text-lg font-bold text-wood-100 mb-2">Stem Mastering & Mixing</h3>
          <p class="text-sm text-wood-400 leading-relaxed">
            Deeper control over critical mix busses. Perfect for ensuring the low-end separation and vocal clarity demand of modern electronic music.
          </p>
        </div>

        <div class="bg-wood-800/40 border border-wood-800 p-6 rounded-lg hover:border-copper/40 transition-colors duration-300">
          <span class="text-xs font-mono text-copper tracking-wider block mb-3">03 //</span>
          <h3 class="text-lg font-bold text-wood-100 mb-2">Production & Mix Finishing</h3>
          <p class="text-sm text-wood-400 leading-relaxed">
            Technical preparation, sample alignment, and pre-master correction to take your project across the creative finish line.
          </p>
        </div>
      </div>
    </section>

    <section class="w-full bg-wood-800/20 border border-wood-800 p-8 rounded-xl backdrop-blur-sm mb-12">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-wood-400 mb-1">
            Showcase Player
          </h2>
          <p class="text-lg font-bold text-wood-100">Before & After A/B Comparisons</p>
        </div>
        <div class="px-3 py-1 bg-wood-800 border border-wood-700 rounded text-xs font-mono text-wood-400">
          44.1kHz // 24-Bit Audio
        </div>
      </div>

      <div class="relative w-full bg-wood-900 border border-wood-800 rounded-lg overflow-hidden flex flex-col items-center justify-center min-h-75">
        
        <div id="three-canvas-container" class="absolute inset-0 w-full h-full opacity-50 pointer-events-none"></div>

        <div class="relative z-10 flex flex-col items-center gap-6">
          <button id="play-btn" class="px-8 py-3 bg-wood-100 text-wood-900 font-bold uppercase tracking-widest text-xs rounded hover:bg-copper hover:text-white transition-colors duration-300">
            Play Test Audio
          </button>
          
          <div class="flex items-center gap-3">
            <span class="text-xs text-wood-400 font-mono tracking-wider">A/B COMPARE</span>
            <div class="w-12 h-6 bg-wood-800 rounded-full border border-wood-700 relative cursor-not-allowed">
              <div class="absolute left-1 top-1 w-4 h-4 bg-wood-400 rounded-full"></div>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>

<script>
  import * as THREE from 'three';
  import { Howl } from 'howler';

  // --- 1. Three.js 3D Cube Setup ---
  const container = document.getElementById('three-canvas-container');
  
  if (container) {
    const scene = new THREE.Scene();
    
    // Adjust camera to fit the specific audio container perfectly
    const camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.z = 4;

    // alpha: true makes the Three.js background transparent
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true }); 
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    // Build the Cube using the Copper accent color
    const geometry = new THREE.BoxGeometry(2, 2, 2);
    const material = new THREE.MeshBasicMaterial({ 
      color: 0xd97736, 
      wireframe: true,
      transparent: true,
      opacity: 0.3
    });
    const cube = new THREE.Mesh(geometry, material);
    scene.add(cube);

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      cube.rotation.x += 0.003;
      cube.rotation.y += 0.005;
      renderer.render(scene, camera);
    }
    animate();

    // Make it responsive if the browser changes size
    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }

  // --- 2. Howler.js Audio Setup ---
  // I kept your alien beacon test audio here so it works instantly. 
  // You can swap this URL out for your local '/audio/master-mix.wav' whenever you are ready.
  const sound = new Howl({
    src: ['[https://actions.google.com/sounds/v1/science_fiction/alien_beacon.ogg](https://actions.google.com/sounds/v1/science_fiction/alien_beacon.ogg)'],
    html5: true,
    volume: 0.5
  });

  const playBtn = document.getElementById('play-btn');
  let isPlaying = false;

  if (playBtn) {
    playBtn.addEventListener('click', () => {
      if (isPlaying) {
        sound.pause();
        playBtn.innerText = 'PLAY TEST AUDIO';
      } else {
        sound.play();
        playBtn.innerText = 'PAUSE';
      }
      isPlaying = !isPlaying;
    });
  }
</script>