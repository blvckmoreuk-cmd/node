---
import Layout from '../layouts/Layout.astro';
import ServiceModal from '../components/ServiceModal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import SuccessPopup from '../components/SuccessPopup.astro';
import EnquiryUpload from '../components/EnquiryUpload.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PriceReadout from '../components/PriceReadout.astro';
import HowItWorks from '../components/HowItWorks.astro';
import StepGrid from '../components/StepGrid.astro';
import { services } from '../data/services';

// Hero price line: four cells, prices match services.ts and the Prices page.
const heroServices = [
  { name: 'Ghost production', price: 'from £250' },
  { name: 'Mixing', price: 'from £50' },
  { name: 'Track finishing', price: 'from £120' },
  { name: 'Mastering', price: '£30 (48h)' },
];

// Artist / label names carousel (fixed order, duplicated for the loop).
const names = [
  'Casmalia', 'Solara', 'Morry', 'Akonite', 'Covert', 'HiFeelings', 'Dankstreet', 'Denno', 'Slinki', 'UKF',
  'Unique Vibes', 'Motive', 'Teks LV', 'Joe Allen', 'TerryBoy', 'Sohl', 'ElTacoFiesta', 'Gold Digger',
  '3000 Bass', 'DMC', 'Mwangi', 'Karellos', 'Wilmore',
  'JayC', 'Evan Plunkett', 'Doozy', 'Dan Toher', 'DJ Bal-T', 'A-Niche', 'Act On', 'Will Paine', 'Noel Da Costa', 'Blvckmore',
];

const trusted = [
  { src: '/logos/3000.jpg', alt: '3000', width: 272, height: 281 },
  { src: '/logos/awd.jpg', alt: 'AWD', width: 348, height: 189 },
  { src: '/logos/ukf.jpg', alt: 'UKF', width: 272, height: 281 },
  { src: '/logos/gs.jpg', alt: 'GS', width: 269, height: 229 },
  { src: '/logos/gd.jpg', alt: 'GD', width: 328, height: 240 },
  { src: '/logos/uv.jpg', alt: 'UV', width: 181, height: 243 },
  { src: '/logos/motive.jpg', alt: 'Motive', width: 423, height: 130 },
];
---

<Layout
  title="Node Production | Electronic Music Mixing & Mastering, Leeds"
  description="Mix, master and ghost production for electronic music. Specialist in House, Techno, Trance, Grime, Garage, Dubstep, DnB, Drill and Trap. Leeds studio working worldwide."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-body relative">

    <div id="home-frame" class="w-full max-w-6xl relative z-10">

      <!-- ===================== MASTHEAD ===================== -->
      <header class="border-b border-line-strong px-4 md:px-8 pt-9 pb-10 md:pt-14 md:pb-14 text-center">
        <h1 class="t-display text-[clamp(2rem,9vw,2.4rem)] md:text-[3.5rem] max-w-[14ch] md:max-w-[26ch] mx-auto md:text-balance">
          Simple, professional audio engineering for dance&nbsp;music.
        </h1>
        <div class="hero-band mt-7 md:mt-9" aria-hidden="true">
          <StepGrid fluid rows={['A...C.....C.C...', '..G...G.G..C..G.']} />
          <div class="hero-playhead-track"><i class="hero-playhead"></i></div>
        </div>
        <ul class="svc-line mt-6 md:mt-8" aria-label="Services and prices">
          {heroServices.map((s) => (
            <li><span class="n">{s.name}</span><span class="p">{s.price}</span></li>
          ))}
        </ul>
        <p class="mt-5 md:mt-6 mx-auto max-w-[34rem] font-body text-base md:text-lg text-fg-dim">
          We ghost produce, mix, finish and master electronic music. Based in Leeds, working worldwide.
        </p>
        <div class="mt-5 md:mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-1">
          <a href="#upload" class="key key-primary">Start a project</a>
          <a href="/prices/" class="font-body font-medium text-fg-muted hover:text-fg underline underline-offset-4 inline-flex items-center min-h-12">Prices</a>
        </div>
      </header>

      <!-- ===================== TRUSTED BY (carousel) ===================== -->
      <div class="logo-marquee" aria-label="Trusted by">
        <span class="logo-marquee-label">Trusted by</span>
        <div class="logo-marquee-viewport">
          <div class="logo-marquee-track">
            {[0, 1].map((copy) => (
              <ul class="logo-marquee-list" data-copy={copy} aria-hidden={copy === 1 ? 'true' : undefined}>
                {trusted.map((logo) => (
                  <li class="logo-marquee-item"><img src={logo.src} alt={copy === 0 ? logo.alt : ''} width={logo.width} height={logo.height} loading="lazy" /></li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>

      <!-- ===================== PLAYER ===================== -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Our work">
          <label slot="meta" class="flex items-center gap-2 cursor-pointer">
            <span class="font-body text-sm text-fg-dim">Particle</span>
            <input id="particle-color" type="color" value="#f2ede3" class="w-6 h-6 bg-transparent cursor-pointer" />
          </label>
        </SectionHeader>

        <div class="p-4 md:p-6 flex flex-col gap-4">

          <!-- Visualiser: full module width, transport controls overlaid on screen -->
          <div id="canvas-container" class="w-full h-72 bg-inset border border-line-strong overflow-hidden relative">

            <!-- Track selector: compact, sits on top of the screen -->
            <div class="absolute top-3 left-3 right-3 sm:left-auto z-20 pointer-events-auto">
              <div class="relative w-full sm:w-80">
                <select id="track-selector" aria-label="Select track" class="w-full bg-ground border border-line-strong text-fg pl-3 pr-8 py-2.5 text-sm font-body font-medium cursor-pointer outline-none appearance-none rounded-none hover:border-fg focus:border-accent">
                  <option value="/audio/Wanna Feel.mp3">Wanna Feel — Mix/Master</option>
                  <option value="/audio/be-as-one.mp3">Be As One — Full Production</option>
                  <option value="/audio/shake it.mp3">Shake It — Mix/Master</option>
                  <option value="/audio/jawani.mp3">Jawani — Full Production</option>
                  <option value="/audio/feelin-kinda-sweaty-evan-plunkett.mp3">Feelin Kinda Sweaty — Mix/Master</option>
                  <option value="/audio/BE OK.mp3">BE OK — Full Production</option>
                  <option value="/audio/wet-morry.mp3">WET — Master</option>
                  <option value="/audio/Sure Thing.mp3">Sure Thing — Master</option>
                  <option value="/audio/2HOT.mp3">2HOT — Master</option>
                  <option value="/audio/backroom.mp3">Backroom — Full Production</option>
                  <option value="/audio/house-demo.mp3">House Demo — Mix/Master</option>
                  <option value="/audio/heads-will-roll.mp3">Heads Will Roll — Master</option>
                  <option value="/audio/tellmehowtorave-casmalia.mp3">Tell Me How To Rave — Mix/Master</option>
                </select>
                <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-fg-dim text-[8px]">&#9660;</div>
              </div>
            </div>

            <!-- Overlay controls: sit on top of the visualiser screen -->
            <div class="absolute bottom-3 left-3 right-3 z-20 flex items-end justify-between gap-3 pointer-events-none">

              <!-- Volume encoder: square hardware knob + 8-step level meter -->
              <div class="flex items-center gap-2 sm:gap-3 bg-ground border border-line-strong px-2 sm:px-3 py-2 pointer-events-auto">
                <span class="font-body text-sm text-fg-dim">Volume</span>
                <div class="relative w-10 h-10 shrink-0">
                  <div id="knob-volume" class="w-full h-full relative border border-fg-dim bg-inset cursor-ns-resize">
                    <div class="knob-rotation-wrapper w-full h-full absolute top-0 left-0 pointer-events-none">
                      <div class="knob-indicator w-0.5 h-3 mx-auto mt-0.5 bg-fg"></div>
                    </div>
                    <div id="knob-hit-area" class="absolute inset-0 z-20 cursor-grab active:cursor-grabbing"></div>
                  </div>
                </div>
                <div id="knob-meter" class="grid grid-cols-4 gap-0.5" aria-hidden="true">
                  {Array.from({ length: 8 }).map(() => <span class="block w-1.5 h-1.5 border border-cell-line"></span>)}
                </div>
              </div>

              <!-- Play / pause -->
              <button id="play-btn" aria-label="Play" class="key pointer-events-auto bg-ground !border-fg !px-4 sm:!px-6 shrink-0">
                <span>Play/Pause</span>
              </button>
            </div>
          </div>

          <!-- Scrub bar: 32 step segments; the filled steps follow playback -->
          <div class="border border-line-strong bg-inset p-2.5">
            <div id="scrub-container" class="w-full h-3 bg-line cursor-pointer relative overflow-hidden">
              <div id="scrub-progress" class="h-full bg-fg w-0 relative"></div>
              <div class="scrub-steps absolute inset-0 pointer-events-none"></div>
            </div>
          </div>

          <p class="font-body text-sm text-fg-dim">
            Real releases we mixed, mastered &amp; produced &mdash; switch tracks to hear more.
          </p>
        </div>
      </section>

      <!-- ===================== CREDITS ===================== -->
      <ul class="credits" aria-label="Key credits">
        <li><span>Releases on UKF, Disciple &amp; <span class="nowrap">All Ways Dance</span></span></li>
        <li><span>Combined 3 million+ streams between our engineers</span></li>
        <li><span>No AI &mdash; real engineers</span></li>
        <li><span>Hybrid analogue / digital signal&nbsp;chain</span></li>
        <li><span>Beatport Minimal No.1</span></li>
      </ul>

      <!-- ===================== ARTIST NAMES (carousel) ===================== -->
      <div class="name-marquee" aria-label="Artists and labels we work with">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <ul class="name-list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {names.map((n) => <li><span class="pip"></span>{n}</li>)}
            </ul>
          ))}
        </div>
      </div>

      <!-- ===================== SERVICES ===================== -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Services" />
        <div id="services" class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4 p-4 md:p-6">
          {services.map((service) => (
            <ServiceCard service={service} />
          ))}
        </div>
      </section>

      <!-- ===================== HOW IT WORKS (once, site-wide) ===================== -->
      <HowItWorks />

      <!-- ===================== UPLOAD ===================== -->
      <section id="upload" class="scroll-mt-4 border-b border-line-strong">
        <SectionHeader label="Upload your track" />

        <form name="enquiry" method="POST" enctype="multipart/form-data" data-netlify="true" data-netlify-honeypot="bot-field" action="/?success=true" class="grid grid-cols-1 md:grid-cols-2 gap-5 p-4 md:p-6">
          <!-- Netlify Forms: hidden name field + honeypot (bots fill it, humans don't) -->
          <input type="hidden" name="form-name" value="enquiry" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div>
            <label for="name" class="field-label">Name or artist</label>
            <input type="text" id="name" name="name" required class="field" />
          </div>
          <div>
            <label for="email" class="field-label">Email</label>
            <input type="email" id="email" name="email" required class="field" />
          </div>
          <div class="md:col-span-2">
            <label for="service" class="field-label">Service</label>
            <select id="service" name="service" required class="field">
              <option value="" disabled selected>Select a service</option>
              <option value="mastering">Mastering</option>
              <option value="mixing-mastering">Mixing &amp; mastering</option>
              <option value="production">Ghost production</option>
              <option value="finishing">Finish your track</option>
              <option value="education">Consultation &amp; education</option>
              <option value="sound-design">Sound design</option>
              <option value="other">Other or not sure</option>
            </select>
          </div>
          <PriceReadout class="md:col-span-2" />
          <div class="md:col-span-2">
            <label for="message" class="field-label">Project details</label>
            <textarea id="message" name="message" rows="5" required class="field"></textarea>
          </div>
          <EnquiryUpload class="md:col-span-2" columns="two" />
          <p class="md:col-span-2 font-body text-base font-medium text-fg">This is an enquiry, not an order. Nothing is booked or charged until we confirm.</p>
          <button type="submit" class="key key-primary md:col-span-2 w-full py-4">
            Send your track
          </button>
        </form>
      </section>

      <!-- ===================== REVIEWS ===================== -->
      <ReviewsCarousel />

    </div>
  </div>

  <ServiceModal />
  <SuccessPopup />
</Layout>


<script>
  import { Howl, Howler } from 'howler';
  import * as THREE from 'three';
  import { gsap } from "gsap";
  import { Draggable } from "gsap/Draggable";

  gsap.registerPlugin(Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    // Service card click-to-open modal is handled by the shared ServiceModal component.

    // preload: false — no mp3 bytes are fetched until the first play() (or track switch).
    let sound = new Howl({ src: ['/audio/Wanna Feel.mp3'], html5: false, preload: false, volume: 0.5 });
    let analyser: AnalyserNode | null = null;
    let dataArray: Uint8Array<ArrayBuffer> | null = null;
    let bassEnvelope = 0; // smoothed low-end energy: fast attack, slow decay — see renderLoop

    const playBtn = document.getElementById('play-btn');
    const scrubContainer = document.getElementById('scrub-container');
    const progressBar = document.getElementById('scrub-progress');
    const trackSelector = document.getElementById('track-selector') as HTMLSelectElement;
    const knobHitArea = document.getElementById('knob-hit-area');
    const wrapper = document.querySelector('.knob-rotation-wrapper');
    const meter = document.getElementById('knob-meter');

    if (!playBtn || !scrubContainer || !knobHitArea) return;

    const container = document.getElementById('canvas-container');
    if (container) {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, container.clientWidth / 288, 0.1, 1000);
      camera.position.z = 6.5; // pulled back so the shape keeps clear of the box edges even on bass peaks
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, 288);
      renderer.domElement.style.display = 'block';
      container.appendChild(renderer.domElement);

      // Keep the canvas locked to the container width so the shape stays
      // horizontally centred and the visualiser reflows with the module.
      const resizeViz = () => {
        const w = container.clientWidth;
        renderer.setSize(w, 288);
        camera.aspect = w / 288;
        camera.updateProjectionMatrix();
      };
      new ResizeObserver(resizeViz).observe(container);

      // ---- Particle shapes ------------------------------------------------
      // Every shape below is generated with the exact same point count, in
      // the same index order, so point #412 in the sphere and point #412 in
      // the torus are "the same particle" — that's what lets them slide
      // smoothly from one form into the next instead of popping/scattering.
      const PARTICLE_COUNT = 4200;

      function sphereShape(count: number, radius: number) {
        const pts = new Float32Array(count * 3);
        const goldenAngle = Math.PI * (3 - Math.sqrt(5));
        for (let i = 0; i < count; i++) {
          const y = 1 - (i / (count - 1)) * 2;
          const r = Math.sqrt(Math.max(0, 1 - y * y));
          const theta = goldenAngle * i;
          pts[i * 3] = Math.cos(theta) * r * radius;
          pts[i * 3 + 1] = y * radius;
          pts[i * 3 + 2] = Math.sin(theta) * r * radius;
        }
        return pts;
      }

      // Rotates a point set around the X axis by a fixed angle. Used to tilt
      // shapes (like the torus) that would otherwise sit perfectly aligned
      // with a rotation axis and look like a flat 2D ring/face instead of a
      // tumbling 3D object.
      function tiltX(pts: Float32Array, angle: number) {
        const cos = Math.cos(angle), sin = Math.sin(angle);
        for (let i = 0; i < pts.length; i += 3) {
          const y = pts[i + 1], z = pts[i + 2];
          pts[i + 1] = y * cos - z * sin;
          pts[i + 2] = y * sin + z * cos;
        }
        return pts;
      }

      function torusShape(count: number, R: number, r: number) {
        const pts = new Float32Array(count * 3);
        const a = Math.PI * (3 - Math.sqrt(5));
        const b = Math.PI * 2 * 0.6180339887;
        for (let i = 0; i < count; i++) {
          const u = i * a;
          const v = i * b;
          pts[i * 3] = (R + r * Math.cos(v)) * Math.cos(u);
          pts[i * 3 + 1] = r * Math.sin(v);
          pts[i * 3 + 2] = (R + r * Math.cos(v)) * Math.sin(u);
        }
        return pts;
      }

      function cubeShape(count: number, size: number) {
        const pts = new Float32Array(count * 3);
        for (let i = 0; i < count; i++) {
          const face = i % 6;
          const u = (((i * 12.9898) % 1) * 2 - 1) * size;
          const v = (((i * 78.233) % 1) * 2 - 1) * size;
          let x = 0, y = 0, z = 0;
          if (face === 0) { x = size; y = u; z = v; }
          else if (face === 1) { x = -size; y = u; z = v; }
          else if (face === 2) { y = size; x = u; z = v; }
          else if (face === 3) { y = -size; x = u; z = v; }
          else if (face === 4) { z = size; x = u; y = v; }
          else { z = -size; x = u; y = v; }
          pts[i * 3] = x;
          pts[i * 3 + 1] = y;
          pts[i * 3 + 2] = z;
        }
        return pts;
      }

      function helixShape(count: number, radius: number, turns: number, height: number) {
        const pts = new Float32Array(count * 3);
        const half = Math.floor(count / 2);
        for (let i = 0; i < count; i++) {
          const onSecondStrand = i >= half;
          const idx = onSecondStrand ? i - half : i;
          const n = onSecondStrand ? count - half : half;
          const t = idx / n;
          const angle = t * Math.PI * 2 * turns + (onSecondStrand ? Math.PI : 0);
          pts[i * 3] = Math.cos(angle) * radius;
          pts[i * 3 + 1] = (t - 0.5) * height;
          pts[i * 3 + 2] = Math.sin(angle) * radius;
        }
        return pts;
      }

      const shapePositions = [
        sphereShape(PARTICLE_COUNT, 2),
        tiltX(torusShape(PARTICLE_COUNT, 1.5, 0.6), 0.95),
        tiltX(cubeShape(PARTICLE_COUNT, 1.6), 0.5),
        helixShape(PARTICLE_COUNT, 1.4, 2.5, 3.4),
      ];

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(shapePositions[0].slice(), 3));
      const material = new THREE.PointsMaterial({ size: 0.055, color: 0xf2ede3, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending });
      const points = new THREE.Points(geometry, material);
      points.position.y = 0; // centred in the screen; transport controls overlay the bottom
      scene.add(points);

      // ---- Particle colour: picked manually, audio reactivity still
      // modulates brightness/hue around whatever base colour is chosen here.
      const colorInput = document.getElementById('particle-color') as HTMLInputElement | null;
      const hslTarget = { h: 0, s: 0, l: 0 };
      new THREE.Color(colorInput?.value || '#f2ede3').getHSL(hslTarget);
      let baseHue = hslTarget.h;
      let baseSaturation = hslTarget.s;

      colorInput?.addEventListener('input', () => {
        new THREE.Color(colorInput.value).getHSL(hslTarget);
        baseHue = hslTarget.h;
        baseSaturation = hslTarget.s;
      });

      // ---- Morph scheduling ------------------------------------------------
      const HOLD_MS = 5200;     // how long a shape sits still before morphing on
      const MORPH_MS = 2200;    // how long the morph transition itself takes
      let shapeIndex = 0;
      let morphFrom = shapePositions[0];
      let morphTo = shapePositions[0];
      let morphProgress = 1;
      let phase: 'hold' | 'morphing' = 'hold';
      let phaseStart = performance.now();

      function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function startNextMorph(now: number) {
        const nextIndex = (shapeIndex + 1) % shapePositions.length;
        morphFrom = shapePositions[shapeIndex];
        morphTo = shapePositions[nextIndex];
        shapeIndex = nextIndex;
        phaseStart = now;
        morphProgress = 0;
      }

      function renderLoop() {
        requestAnimationFrame(renderLoop);
        const now = performance.now();
        const t = now * 0.001;

        if (phase === 'hold' && now - phaseStart > HOLD_MS) {
          startNextMorph(now);
          phase = 'morphing';
        } else if (phase === 'morphing') {
          morphProgress = Math.min(1, (now - phaseStart) / MORPH_MS);
          if (morphProgress >= 1) {
            phase = 'hold';
            phaseStart = now;
          }
        }
        const eased = easeInOutCubic(morphProgress);

        let vol = 0;
        if (sound.playing() && analyser && dataArray) {
          analyser.getByteFrequencyData(dataArray);
          vol = (dataArray.reduce((a: any, b: any) => a + b, 0) / dataArray.length) / 128;

          // Isolate roughly the bottom ~200Hz as "bass" rather than averaging
          // the whole spectrum together — that's what was drowning it out before.
          const nyquist = (Howler.ctx?.sampleRate || 44100) / 2;
          const binHz = nyquist / dataArray.length;
          const bassBinCount = Math.max(2, Math.round(200 / binHz));
          let bassSum = 0;
          for (let b = 0; b < bassBinCount; b++) bassSum += dataArray[b];
          const bassRaw = (bassSum / bassBinCount) / 255;

          // Fast attack so kicks/bass hits snap in immediately, slower decay
          // so they trail off instead of flickering — a punchier feel than
          // smoothing both directions equally.
          const attack = 0.55, decay = 0.07;
          bassEnvelope += (bassRaw - bassEnvelope) * (bassRaw > bassEnvelope ? attack : decay);
        } else {
          bassEnvelope += (0 - bassEnvelope) * 0.05; // ease back to rest when paused
        }
        const bass = bassEnvelope;

        const positions = geometry.attributes.position.array as Float32Array;
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          const i3 = i * 3;
          const bx = morphFrom[i3] + (morphTo[i3] - morphFrom[i3]) * eased;
          const by = morphFrom[i3 + 1] + (morphTo[i3 + 1] - morphFrom[i3 + 1]) * eased;
          const bz = morphFrom[i3 + 2] + (morphTo[i3 + 2] - morphFrom[i3 + 2]) * eased;

          const dist = Math.sqrt(bx * bx + by * by + bz * bz) || 1;
          const pattern = Math.sin(bx * 3 + t * 1.4) * Math.cos(by * 3 + t * 1.4);
          const ambientDrift = 0.05 * Math.sin(t * 0.8 + i * 0.0015); // keeps things alive even with no audio playing
          const push = pattern * (vol * 0.6 + bass * 1.4) + ambientDrift;

          positions[i3] = bx + (bx / dist) * push;
          positions[i3 + 1] = by + (by / dist) * push;
          positions[i3 + 2] = bz + (bz / dist) * push;
        }
        geometry.attributes.position.needsUpdate = true;

        // Bass pulls the whole cloud slightly tighter (denser-looking) while
        // growing and brightening each point — together it reads as a "thump"
        // rather than a generic wobble.
        points.scale.setScalar(1 - bass * 0.12);
        material.size = 0.05 + bass * 0.09;

        points.rotation.y += 0.0022 + vol * 0.003 + bass * 0.004;
        points.rotation.x += 0.0013 + bass * 0.0018;
        points.rotation.z += 0.0008 + vol * 0.0012;
        points.material.color.setHSL(baseHue, baseSaturation, 0.42 + bass * 0.22 + vol * 0.06);

        renderer.render(scene, camera);
      }
      renderLoop();
    }

    // iOS routes Web Audio to the "ambient" session by default, so it obeys the
    // hardware silent switch. Requesting the "playback" session (iOS 16.4+) makes
    // the visualiser audio play through even when the phone is on silent.
    function enablePlaybackAudioSession() {
      try {
        const audioSession = (navigator as any).audioSession;
        if (audioSession) audioSession.type = 'playback';
      } catch { /* unsupported browser: ignore */ }
    }

    playBtn.addEventListener('click', () => {
      enablePlaybackAudioSession();
      if (!analyser && Howler.ctx) {
        analyser = Howler.ctx.createAnalyser();
        analyser.fftSize = 1024;
        Howler.masterGain.connect(analyser);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
      }
      if (Howler.ctx?.state === 'suspended') Howler.ctx.resume();

      const btnSpan = playBtn.querySelector('span');
      if (sound.playing()) {
        sound.pause();
        if(btnSpan) btnSpan.textContent = 'Play';
        playBtn.setAttribute('aria-label', 'Play');
      } else {
        if (sound.state() === 'unloaded') sound.load(); // first interaction: fetch the track now
        sound.play();
        if(btnSpan) btnSpan.textContent = 'Pause';
        playBtn.setAttribute('aria-label', 'Pause');
      }
    });

    scrubContainer.addEventListener('click', (e: any) => {
      if (!(sound.duration() > 0)) return; // nothing loaded yet (lazy) — nothing to seek
      const rect = scrubContainer.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      sound.seek(pct * sound.duration());
    });

    setInterval(() => {
      if (sound.playing() && sound.duration() > 0 && progressBar) {
        progressBar.style.width = ((sound.seek() as number) / sound.duration() * 100) + '%';
      }
    }, 100);

    function updateKnobVisual(rotation: number) {
      if (wrapper) {
        (wrapper as HTMLElement).style.transform = `rotate(${rotation - 135}deg)`;
      }
      // 8-step level meter beside the encoder: cells fill as volume rises.
      if (meter) {
        const lit = Math.round((rotation / 270) * 8);
        Array.from(meter.children).forEach((cell, idx) => {
          cell.classList.toggle('bg-fg', idx < lit);
          cell.classList.toggle('border-fg', idx < lit);
          cell.classList.toggle('border-cell-line', idx >= lit);
        });
      }
    }

    gsap.set(knobHitArea, { rotation: 135 });
    updateKnobVisual(135); // paint the halo/indicator immediately, matching the starting volume

    Draggable.create(knobHitArea, {
      type: "rotation",
      bounds: { minRotation: 0, maxRotation: 270 },
      onDrag: function() {
        updateKnobVisual(this.rotation);
        sound.volume(this.rotation / 270);
      }
    });

    trackSelector?.addEventListener('change', () => {
      sound.unload();
      sound = new Howl({ src: [trackSelector.value], html5: false, volume: sound.volume() });
      sound.play();
      const btnSpan = playBtn.querySelector('span');
      if(btnSpan) btnSpan.textContent = 'Pause';
      playBtn.setAttribute('aria-label', 'Pause');
    });
  });
</script>
