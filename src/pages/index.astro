---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="w-full min-h-screen bg-[#f1f3f4] flex flex-col items-center px-4 py-8 md:py-16 font-mono">
    
    <div class="max-w-4xl w-full bg-[#ffffff] border border-[#e2e8f0] shadow-[0_20px_50px_rgba(0,0,0,0.08)] rounded-3xl relative p-8 md:p-12">
      
      <header class="w-full flex justify-between items-end mb-12">
        <div class="flex flex-col">
          <h1 class="text-3xl md:text-5xl font-black tracking-tighter text-[#475569] uppercase">Node<span class="text-[#a78bfa]">.</span></h1>
          <span class="text-[9px] tracking-[0.4em] text-[#94a3b8] uppercase font-bold mt-1">Dance Music</span>
        </div>
      </header>

      <section class="w-full mb-12">
        <div class="flex flex-col md:flex-row gap-8 items-start justify-between">
          <div class="flex-1 w-full">
            <div id="canvas-container" class="w-full h-64 bg-[#cbd5e1] rounded-2xl shadow-[inset_0_4px_6px_rgba(0,0,0,0.1)] border-4 border-[#f1f5f9] overflow-hidden"></div>
            <select id="track-selector" class="w-full mt-4 bg-white border border-[#e2e8f0] text-[#475569] px-4 py-2 rounded-lg text-[10px] font-bold uppercase tracking-widest cursor-pointer outline-none">
              <option value="/audio/BE OK.mp3">SRC 1: BE OK</option>
              <option value="/audio/Sure Thing.mp3">SRC 2: SURE THING</option>
            </select>
          </div>

          <div class="flex flex-col items-center justify-center gap-6">
            <div class="relative flex items-center justify-center w-40 h-40">
              <div id="knob-glow-core" class="absolute w-full h-full rounded-full pointer-events-none" style="z-index: 1;"></div>
              <div id="knob-volume" class="w-32 h-32 rounded-full cursor-ns-resize relative z-10 bg-[#f1f5f9] shadow-[6px_6px_12px_rgba(0,0,0,0.05),-6px_-6px_12px_rgba(255,255,255,0.8)] border border-[#e2e8f0]">
                <div class="knob-rotation-wrapper w-full h-full absolute top-0 left-0 pointer-events-none rounded-full">
                  <div class="knob-indicator w-1 h-10 mx-auto mt-2 rounded-full bg-[#a78bfa] shadow-sm"></div>
                </div>
              </div>
            </div>
            <button id="play-btn" class="w-full px-8 py-3 bg-[#1e293b] text-white font-black text-[10px] uppercase tracking-[0.2em] rounded-xl hover:bg-[#334155] transition-all shadow-lg">Play</button>
          </div>
        </div>

        <div class="mt-8 p-3 bg-white border border-[#e2e8f0] rounded-xl">
          <div id="scrub-container" class="w-full h-2 bg-[#e2e8f0] rounded-full cursor-pointer relative overflow-hidden">
            <div id="scrub-progress" class="h-full bg-[#a78bfa] w-0"></div>
          </div>
        </div>
      </section>

      <section id="services" class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        {[
          { title: 'Production', detail: 'Composition & Arrangement', color: 'bg-[#fce7f3]' },
          { title: 'Mixing', detail: 'Balance & Sonic Clarity', color: 'bg-[#dcfce7]' },
          { title: 'Mastering', detail: 'Industry Standard Loudness', color: 'bg-[#fef9c3]' },
          { title: 'Education', detail: '1-on-1 Ableton Mentoring', color: 'bg-[#dbeafe]' },
          { title: 'Sound Design', detail: 'Custom Patch Creation', color: 'bg-[#f3e8ff]' },
          { title: 'Consulting', detail: 'Career Strategy', color: 'bg-[#ffedd5]' }
        ].map((service) => (
          <div class="service-card group h-96 perspective-[1000px] cursor-pointer">
            <div class={`relative w-full h-full transition-transform duration-500 transform-3d group-hover:transform-[rotateY(180deg)] border border-[#e2e8f0] ${service.color} rounded-xl shadow-sm`}>
              <div class="absolute w-full h-full p-6 flex flex-col justify-center items-center backface-hidden">
                <span class="text-[12px] font-black uppercase tracking-tighter text-[#475569]">{service.title}</span>
              </div>
              <div class="absolute w-full h-full p-6 flex flex-col justify-between backface-hidden transform-[rotateY(180deg)] bg-[#1e293b] text-white rounded-xl">
                <span class="text-[10px] uppercase tracking-widest text-center leading-relaxed">{service.detail}</span>
                <div class="text-[10px] uppercase opacity-50 text-center">View Pricing</div>
              </div>
            </div>
          </div>
        ))}
      </section>

      <section id="enquiry" class="mt-16 pt-12 border-t-2 border-[#e2e8f0]">
        <h2 class="text-sm font-black uppercase tracking-[0.2em] mb-8 text-[#475569]">Start a Project</h2>
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label class="text-[9px] font-bold uppercase tracking-widest text-[#94a3b8]">Name</label>
            <input type="text" name="name" required class="bg-[#f8fafc] border border-[#e2e8f0] p-3 rounded-lg outline-none focus:border-[#a78bfa]" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-[9px] font-bold uppercase tracking-widest text-[#94a3b8]">Email</label>
            <input type="email" name="email" required class="bg-[#f8fafc] border border-[#e2e8f0] p-3 rounded-lg outline-none focus:border-[#a78bfa]" />
          </div>
          <div class="col-span-1 md:col-span-2 flex flex-col gap-2">
            <label class="text-[9px] font-bold uppercase tracking-widest text-[#94a3b8]">Message</label>
            <textarea name="message" rows="4" required class="bg-[#f8fafc] border border-[#e2e8f0] p-3 rounded-lg outline-none focus:border-[#a78bfa]"></textarea>
          </div>
          <button type="submit" class="col-span-1 md:col-span-2 w-full py-4 bg-[#1e293b] text-white font-black text-[10px] uppercase tracking-[0.2em] rounded-xl hover:bg-[#334155] transition-all">Send Enquiry</button>
        </form>
      </section>

      <section class="mt-16 flex justify-center items-center gap-10 opacity-40 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500">
        <img src="/logos/3000.jpg" class="h-10 rounded-lg" alt="3000" />
        <img src="/logos/awd.jpg" class="h-10 rounded-lg" alt="AWD" />
        <img src="/logos/ukf.jpg" class="h-10 rounded-lg" alt="UKF" />
        <img src="/logos/gs.jpg" class="h-10 rounded-lg" alt="GS" />
        <img src="/logos/gd.jpg" class="h-10 rounded-lg" alt="GD" />
        <img src="/logos/uv.jpg" class="h-10 rounded-lg" alt="UV" />
        <img src="/logos/motive.jpg" class="h-10 rounded-lg" alt="Motive" />
      </section>
      
    </div>
  </main>
</Layout>

<script>
  import { Howl, Howler } from 'howler';
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    let sound = new Howl({ src: ['/audio/BE OK.mp3'], html5: false, volume: 0.5 });
    let analyser: AnalyserNode | null = null;
    let dataArray: Uint8Array<ArrayBuffer> | null = null;

    const playBtn = document.getElementById('play-btn');
    const scrubContainer = document.getElementById('scrub-container');
    const progressBar = document.getElementById('scrub-progress');
    const trackSelector = document.getElementById('track-selector') as HTMLSelectElement;
    const knob = document.getElementById('knob-volume');
    const wrapper = knob?.querySelector('.knob-rotation-wrapper');
    const glowCore = document.getElementById('knob-glow-core');

    if (!playBtn || !scrubContainer || !knob) return;

    // --- THREE.JS ---
    const container = document.getElementById('canvas-container');
    if (container) {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, container.clientWidth / 256, 0.1, 1000);
      camera.position.z = 5;
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, 256);
      container.appendChild(renderer.domElement);

      const geometry = new THREE.IcosahedronGeometry(2, 6);
      const material = new THREE.PointsMaterial({ size: 0.05, color: 0xa78bfa, transparent: true, blending: THREE.AdditiveBlending });
      const points = new THREE.Points(geometry, material);
      scene.add(points);
      const basePositions = geometry.attributes.position.array.slice();

      function renderLoop() {
        requestAnimationFrame(renderLoop);
        if (sound.playing() && analyser && dataArray) {
          analyser.getByteFrequencyData(dataArray);
          const vol = (dataArray.reduce((a: any, b: any) => a + b) / dataArray.length) / 128;
          const time = Date.now() * 0.001;
          const positions = geometry.attributes.position.array;
          for (let i = 0; i < positions.length; i += 3) {
            const x = basePositions[i], y = basePositions[i+1], z = basePositions[i+2];
            const dist = Math.sqrt(x*x + y*y + z*z);
            const pattern = Math.sin(x * 4 + time) * Math.cos(y * 4 + time);
            positions[i] = x + (x / dist) * pattern * (vol * 2);
            positions[i+1] = y + (y / dist) * pattern * (vol * 2);
            positions[i+2] = z + (z / dist) * pattern * (vol * 2);
          }
          geometry.attributes.position.needsUpdate = true;
          points.material.color.setHSL(0.6 - (vol * 0.5), 0.8, 0.5);
        }
        renderer.render(scene, camera);
      }
      renderLoop();
    }

    playBtn.addEventListener('click', () => {
      if (!analyser && Howler.ctx) {
        analyser = Howler.ctx.createAnalyser();
        analyser.fftSize = 256;
        Howler.masterGain.connect(analyser);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
      }
      if (Howler.ctx?.state === 'suspended') Howler.ctx.resume();
      if (sound.playing()) { sound.pause(); playBtn.textContent = 'Play'; }
      else { sound.play(); playBtn.textContent = 'Pause'; }
    });

    scrubContainer.addEventListener('click', (e: any) => {
      const rect = scrubContainer.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      sound.seek(pct * sound.duration());
    });

    setInterval(() => {
      if (sound.playing() && sound.duration() > 0 && progressBar) {
        progressBar.style.width = ((sound.seek() as number) / sound.duration() * 100) + '%';
      }
    }, 100);

    let isKnobDragging = false;
    let currentRotation = 135;

    knob.addEventListener('mousedown', () => { isKnobDragging = true; });
    window.addEventListener('mousemove', (e: any) => {
      if (!isKnobDragging) return;
      currentRotation = Math.max(0, Math.min(270, currentRotation - e.movementY * 1.5));
      if(wrapper) (wrapper as HTMLElement).style.transform = `rotate(${-135 + currentRotation}deg)`;
      if(glowCore) (glowCore as HTMLElement).style.background = `conic-gradient(from -135deg, #a78bfa 0deg ${currentRotation}deg, transparent 0deg)`;
      sound.volume(currentRotation / 270);
    });
    window.addEventListener('mouseup', () => { isKnobDragging = false; });

    trackSelector?.addEventListener('change', () => {
      sound.unload();
      sound = new Howl({ src: [trackSelector.value], html5: false, volume: sound.volume() });
      sound.play();
      playBtn.textContent = 'Pause';
    });
  });
</script>