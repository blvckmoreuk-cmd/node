---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';

const works = [
  { title: 'Wanna Feel', artist: 'Node', credit: 'Mix / Master', wire: 'bg-red-500' },
  { title: 'BE OK', artist: 'Node', credit: 'Full Production', wire: 'bg-blue-500' },
  { title: 'Sure Thing', artist: 'Node', credit: 'Master', wire: 'bg-yellow-400' },
  { title: '2HOT', artist: 'Node', credit: 'Master', wire: 'bg-green-500' },
  { title: 'Wet', artist: 'Morry', credit: 'Master', wire: 'bg-purple-500' },
  { title: 'Tell Me How To Rave', artist: 'Casmalia', credit: 'Mix / Master', wire: 'bg-orange-500' },
];

// Deterministic-looking waveform bars per tile so each reads as its own record.
const bars = [3, 6, 4, 8, 5, 7, 4, 9, 6, 3, 7, 5, 8, 4, 6, 5, 7, 3];
---

<Layout>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame max="max-w-4xl">

      <!-- Masthead -->
      <header class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line">
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Portfolio</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Selected 24-bit</span>
        </div>
        <div class="px-4 md:px-8 py-8 md:py-11">
          <h1 class="font-display font-bold uppercase leading-[0.9] tracking-tight text-fg text-[11vw] md:text-[3.75rem]">
            Selected<br /><span class="text-accent">works.</span>
          </h1>
          <p class="mt-5 font-body text-sm text-fg-muted max-w-lg leading-relaxed">
            A curated set of mixes and masters. Previous engineering spans major and independent
            electronic labels, including releases across Sony, Crucast and UKF.
          </p>
        </div>
      </header>

      <!-- Works grid -->
      <section class="border-b border-line-strong">
        <SectionHeader num="01" label="Catalogue / Recent Cuts" />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line-strong">
          {works.map((work) => (
            <div class="group bg-panel p-5 flex flex-col justify-between gap-6 min-h-52">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">{work.credit}</span>
                <span class={`w-2 h-2 rounded-full ${work.wire} shadow-[0_0_8px_rgba(255,255,255,0.15)]`}></span>
              </div>
              <div>
                <h2 class="font-display text-lg font-bold uppercase tracking-tight text-fg leading-none group-hover:text-accent transition-colors">{work.title}</h2>
                <p class="mt-1.5 font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">{work.artist}</p>
              </div>
              <div class="flex items-end gap-1 h-6 opacity-40 group-hover:opacity-90 transition-opacity">
                {bars.map((h) => (
                  <span class="flex-1 rounded-sm bg-accent" style={`height:${h * 10}%`}></span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section>
        <a href="/contact" class="block text-center px-6 py-5 bg-accent text-base font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-accent-bright transition-colors">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>
</Layout>
