---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="max-w-4xl w-full px-6 py-20">
    <h1 class="text-4xl font-bold mb-4 tracking-tight">Selected Works</h1>
    <p class="text-neutral-400 max-w-2xl mb-16 leading-relaxed">
      A curated selection of mixes and masters. Previous engineering work includes releases across major and independent electronic labels including Sony, Crucast, and UKF.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <div class="group relative aspect-video bg-black border border-neutral-800 rounded-lg overflow-hidden flex items-center justify-center">
        <span class="text-neutral-600 text-sm tracking-widest group-hover:text-white transition duration-300">AUDIO PLAYER 01</span>
      </div>

      <div class="group relative aspect-video bg-black border border-neutral-800 rounded-lg overflow-hidden flex items-center justify-center">
        <span class="text-neutral-600 text-sm tracking-widest group-hover:text-white transition duration-300">AUDIO PLAYER 02</span>
      </div>

    </div>
  </div>
</Layout>
