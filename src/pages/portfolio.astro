---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';

const works = [
  { title: 'Wanna Feel', artist: 'Node', credit: 'Mix / Master', ch: 'var(--color-ch-mastering)' },
  { title: 'BE OK', artist: 'Node', credit: 'Full Production', ch: 'var(--color-ch-mixing)' },
  { title: 'Sure Thing', artist: 'Node', credit: 'Master', ch: 'var(--color-ch-production)' },
  { title: '2HOT', artist: 'Node', credit: 'Master', ch: 'var(--color-ch-education)' },
  { title: 'Wet', artist: 'Morry', credit: 'Master', ch: 'var(--color-ch-tools)' },
  { title: 'Tell Me How To Rave', artist: 'Casmalia', credit: 'Mix / Master', ch: 'var(--color-ch-analysis)' },
];
---

<Layout
  title="Portfolio | Selected Mixes & Masters — Node Production"
  description="Selected mixes and masters by Node Production, spanning major and independent dance music releases."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-body">
    <SectionFrame>

      <PageHero>
        <Fragment slot="title">Selected<br />works.</Fragment>
        A curated set of mixes and masters. Previous engineering spans major and independent
        electronic labels, including releases across UKF, Gold Digger, Motive and All Ways Dance.
      </PageHero>

      <!-- Spotify credits playlist -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Selected credits" />
        <div class="p-4 md:p-6 flex flex-col gap-4">
          <p class="font-body text-sm text-fg-muted max-w-lg leading-relaxed">
            A curated selection of recent releases. Hit play or open it in Spotify.
          </p>
          <iframe
            title="Node Production — selected credits"
            style="border-radius:0"
            src="https://open.spotify.com/embed/playlist/2GYiWsreoEEDMsLh5LOprH?utm_source=generator&theme=0"
            width="100%"
            height="420"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
          ></iframe>
        </div>
      </section>

      <!-- Works grid -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Recent releases" />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line-strong">
          {works.map((work) => (
            <div class="group bg-ground hover:bg-panel p-6 flex flex-col justify-between gap-8 min-h-44 relative" style={`--ch:${work.ch}`}>
              <div class="flex items-center justify-between">
                <span class="font-body text-sm text-fg-dim">{work.credit}</span>
                <span class="block w-3 h-3 border group-hover:bg-(--ch)" style="border-color: var(--ch)" aria-hidden="true"></span>
              </div>
              <div>
                <h2 class="t-h3">{work.title}</h2>
                <p class="mt-2 font-body text-sm text-fg-dim">{work.artist}</p>
              </div>
              <span class="absolute left-0 right-0 bottom-0 h-0.5 scale-x-0 group-hover:scale-x-100 origin-left" style="background: var(--ch)" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </section>

      <!-- Reviews -->
      <ReviewsCarousel />

      <!-- CTA -->
      <section>
        <a href="/contact/" class="key key-primary w-full py-5">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>
</Layout>
