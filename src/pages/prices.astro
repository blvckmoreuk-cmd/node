---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';

const masteringRows = [
  { label: 'Per Track', value: '£30' },
  { label: 'Additional Version', value: '£10', muted: true },
  { label: 'EP (2+ Tracks)', value: '£20/tr' },
  { label: 'Additional Version', value: '£5/tr', muted: true },
];
const mixingRows = [
  { label: '10 Stems', value: '£50' },
  { label: '20 Stems', value: '£85' },
  { label: '30 Stems', value: '£100' },
  { label: 'Extra Stems', value: '£2/ea', muted: true },
];
const educationRows = [
  { label: '1:1 Tech Analysis / Call', value: '£40' },
  { label: 'Ableton Tutoring (p/h)', value: '£25' },
];
const toolRows = [
  { label: 'Nodegen VST', value: '£15' },
  { label: 'Sample Packs', value: '£15' },
  { label: 'Stock FX Racks', value: '£5' },
  { label: 'Visualiser', value: '£5' },
];

// Structured pricing so search engines can surface rate-rich results. Prices
// are the from/entry point of each rate group above.
const priceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Audio mixing and mastering',
  provider: { '@type': 'MusicGroup', name: 'Node Production' },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Rates',
    itemListElement: [
      { name: 'Mastering (per track)', price: '30.00' },
      { name: 'Mixing (10 stems)', price: '50.00' },
      { name: '1:1 Tech Analysis / Call', price: '40.00' },
      { name: 'Ableton Tutoring (per hour)', price: '25.00' },
    ].map((o) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: o.name },
      price: o.price,
      priceCurrency: 'GBP',
    })),
  },
};
---
<Layout
  title="Rates | Mixing & Mastering Prices — Node Production"
  description="Transparent rates for electronic music producers. Mastering from £30, mixing from £50. A 50% deposit books the work."
>
  <script type="application/ld+json" set:html={JSON.stringify(priceJsonLd)} is:inline />
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame>

      <PageHero left="Node // Rate Card" right="GBP">
        <Fragment slot="title">Rates &amp;<br />services.</Fragment>
        Transparent pricing for electronic music producers. A 50% deposit books the work.
      </PageHero>

      <!-- Rate card -->
      <section class="border-b border-line-strong">
        <SectionHeader num="01" label="Price List" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-line-strong">

          <!-- Mastering -->
          <div class="bg-ground p-6 md:p-8" style="--ch: var(--color-ch-mastering)">
            <h3 class="rate-head"><span class="rate-chip"></span>Mastering</h3>
            <ul>
              {masteringRows.map((row) => (
                <li class={`rate-row ${row.muted ? 'is-muted' : ''}`}>
                  <span>{row.label}</span><span class="rate-val">{row.value}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Mixing & Mastering -->
          <div class="bg-ground p-6 md:p-8" style="--ch: var(--color-ch-mixing)">
            <h3 class="rate-head"><span class="rate-chip"></span>Mixing &amp; Mastering</h3>
            <ul>
              {mixingRows.map((row) => (
                <li class={`rate-row ${row.muted ? 'is-muted' : ''}`}>
                  <span>{row.label}</span><span class="rate-val">{row.value}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Production & Finishing (wide) -->
          <div class="md:col-span-2 bg-ground p-6 md:p-8" style="--ch: var(--color-ch-production)">
            <h3 class="rate-head"><span class="rate-chip"></span>Production &amp; Finishing</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10">
              <div class="rate-row">
                <span>Ghost Production, exclusive &amp; royalty-free</span>
                <span class="rate-val">£250</span>
              </div>
              <div class="rate-row">
                <span>Finish Your Track, analysis included</span>
                <span class="rate-val whitespace-nowrap">£120-200</span>
              </div>
            </div>
            <p class="mt-5 font-body text-[12px] italic text-fg-dim">Price varies with complexity. Enquire for a custom quote.</p>
          </div>

          <!-- Consultation & Education -->
          <div class="bg-ground p-6 md:p-8" style="--ch: var(--color-ch-education)">
            <h3 class="rate-head"><span class="rate-chip"></span>Consultation &amp; Education</h3>
            <ul>
              {educationRows.map((row) => (
                <li class="rate-row">
                  <span>{row.label}</span><span class="rate-val">{row.value}</span>
                </li>
              ))}
            </ul>
            <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-dim">Hosted on Muse or Discord</p>
          </div>

          <!-- Digital Tools (links to the shop) -->
          <a href="/shop" class="group bg-ground p-6 md:p-8 block hover:bg-panel no-underline" style="--ch: var(--color-ch-tools)">
            <h3 class="rate-head justify-between">
              <span class="flex items-center gap-3"><span class="rate-chip"></span>Digital Tools</span>
              <span class="font-mono text-[10px] tracking-[0.18em] text-fg-dim group-hover:text-fg">Shop &rarr;</span>
            </h3>
            <ul>
              {toolRows.map((row) => (
                <li class="rate-row">
                  <span>{row.label}</span><span class="rate-val">{row.value}</span>
                </li>
              ))}
            </ul>
          </a>

        </div>
      </section>

      <!-- CTA -->
      <section>
        <a href="/contact" class="key key-primary w-full py-5">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>
</Layout>

<style is:global>
  .rate-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-fg);
  }
  .rate-chip {
    display: block;
    width: 10px;
    height: 10px;
    border: 1px solid var(--ch);
    background: var(--ch);
    flex-shrink: 0;
  }
  .rate-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
  }
  /* prices are cream (never orange) */
  .rate-val {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-fg);
  }
  .rate-row.is-muted { color: var(--color-fg-faint); }
  .rate-row.is-muted .rate-val { color: var(--color-fg-dim); font-size: 1.1rem; }
</style>
