---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';

const masteringRows = [
  { label: 'Per Track', value: '£30' },
  { label: 'Additional Version', value: '£10', muted: true },
  { label: 'EP (2+ Tracks)', value: '£20/tr' },
  { label: 'Additional Version', value: '£5/tr', muted: true },
];
const mixingRows = [
  { label: '10 Stems', value: '£50' },
  { label: '20 Stems', value: '£85' },
  { label: '30 Stems', value: '£100' },
  { label: 'Extra Stems', value: '£2/ea', muted: true },
];
const educationRows = [
  { label: '1:1 Tech Analysis / Call', value: '£40' },
  { label: 'Ableton Tutoring (p/h)', value: '£25' },
];
const toolRows = [
  { label: 'Nodegen VST', value: '£15' },
  { label: 'Sample Packs', value: '£15' },
  { label: 'Stock FX Racks', value: '£5' },
  { label: 'Visualiser', value: '£5' },
];
---

<Layout>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame max="max-w-4xl">

      <!-- Masthead -->
      <header class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line">
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Rate Card</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">GBP</span>
        </div>
        <div class="px-4 md:px-8 py-8 md:py-11">
          <h1 class="font-display font-bold uppercase leading-[0.9] tracking-tight text-fg text-[11vw] md:text-[3.75rem]">
            Rates &<br /><span class="text-accent">services.</span>
          </h1>
          <p class="mt-5 font-body text-sm text-fg-muted max-w-md leading-relaxed">
            Transparent pricing for electronic music producers. A 50% deposit books the work.
          </p>
        </div>
      </header>

      <!-- Rate card -->
      <section class="border-b border-line-strong">
        <SectionHeader num="01" label="Price List" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-line-strong">

          <!-- Mastering -->
          <div class="bg-panel p-6">
            <h3 class="font-display text-[13px] font-bold uppercase tracking-[0.15em] text-accent mb-4 border-b border-line pb-3">Mastering</h3>
            <ul class="space-y-3">
              {masteringRows.map((row) => (
                <li class={`flex justify-between text-[11px] uppercase tracking-wide ${row.muted ? 'text-fg-faint' : 'text-fg-muted'}`}>
                  <span>{row.label}</span><span class="font-bold">{row.value}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Mixing & Mastering -->
          <div class="bg-panel p-6">
            <h3 class="font-display text-[13px] font-bold uppercase tracking-[0.15em] text-accent mb-4 border-b border-line pb-3">Mixing & Mastering</h3>
            <ul class="space-y-3">
              {mixingRows.map((row) => (
                <li class={`flex justify-between text-[11px] uppercase tracking-wide ${row.muted ? 'text-fg-faint' : 'text-fg-muted'}`}>
                  <span>{row.label}</span><span class="font-bold">{row.value}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Production & Finishing (wide) -->
          <div class="md:col-span-2 bg-base p-6">
            <h3 class="font-display text-[13px] font-bold uppercase tracking-[0.15em] text-accent mb-4 border-b border-line pb-3">Production & Finishing</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-[11px] uppercase font-bold text-fg-muted">Ghost Production, exclusive &amp; royalty-free</span>
                <span class="font-display text-lg font-bold text-accent leading-none">£250</span>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-[11px] uppercase font-bold text-fg-muted">Finish Your Track, analysis included</span>
                <span class="font-display text-lg font-bold text-accent leading-none whitespace-nowrap">£120-200</span>
              </div>
            </div>
            <p class="mt-4 font-body text-[11px] italic text-fg-faint">Price varies with complexity. Enquire for a custom quote.</p>
          </div>

          <!-- Consultation & Education -->
          <div class="bg-panel p-6">
            <h3 class="font-display text-[13px] font-bold uppercase tracking-[0.15em] text-accent mb-4 border-b border-line pb-3">Consultation & Education</h3>
            <ul class="space-y-3">
              {educationRows.map((row) => (
                <li class="flex justify-between text-[11px] uppercase tracking-wide text-fg-muted">
                  <span>{row.label}</span><span class="font-bold">{row.value}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">Hosted on Muse or Discord</p>
          </div>

          <!-- Digital Tools -->
          <div class="bg-panel p-6">
            <h3 class="font-display text-[13px] font-bold uppercase tracking-[0.15em] text-accent mb-4 border-b border-line pb-3">Digital Tools</h3>
            <ul class="space-y-3">
              {toolRows.map((row) => (
                <li class="flex justify-between text-[11px] uppercase tracking-wide text-fg-muted">
                  <span>{row.label}</span><span class="font-bold">{row.value}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </section>

      <!-- CTA -->
      <section>
        <a href="/contact" class="block text-center px-6 py-5 bg-accent-dim text-white font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-accent transition-colors">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>
</Layout>
