---
import Layout from '../../layouts/Layout.astro';
import { listPending, listApproved } from '../../lib/reviews';

export const prerender = false;

// Gate on the admin token. Different secret from the public review link.
const { token } = Astro.params;
const adminToken = process.env.REVIEW_ADMIN_TOKEN;
if (!adminToken || token !== adminToken) {
  return new Response('Not found', { status: 404 });
}

const pending = await listPending();
const approvedCount = (await listApproved()).length;
---

<Layout title="Review Moderation | Node" description="Moderate submitted reviews." noindex={true}>
  <div class="w-full min-h-[70vh] flex flex-col items-center px-3 md:px-4 py-10 md:py-14 font-mono">
    <div class="w-full max-w-2xl border border-line-strong bg-ground crop-marks">
      <div class="flex items-center justify-between gap-3 px-4 md:px-6 py-3 border-b border-line-strong bg-panel">
        <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-fg-dim">Node // Moderation</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-fg-faint">{approvedCount} live · {pending.length} pending</span>
      </div>

      <div class="px-4 md:px-8 py-8 md:py-10" data-token={token}>
        <h1 class="t-display text-[1.6875rem] md:text-[2.0625rem] leading-[1.05] tracking-[-0.025em]">Pending reviews</h1>

        {pending.length === 0 && (
          <p class="mt-6 font-body text-sm text-fg-muted">Nothing waiting. New submissions show up here.</p>
        )}

        <ul class="mt-8 flex flex-col gap-4">
          {pending.map((r) => (
            <li class="review-row border border-line-strong p-5 flex flex-col gap-4" data-id={r.id}>
              <div class="flex items-center justify-between gap-3">
                <span class="flex gap-1" role="img" aria-label={`${r.rating} out of 5`}>
                  {Array.from({ length: 5 }).map((_, s) => (
                    <span class={`block w-3 h-3 border ${s < r.rating ? 'bg-fg border-fg' : 'border-cell-line'}`}></span>
                  ))}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-fg-faint">{new Date(r.createdAt).toLocaleDateString()}</span>
              </div>
              <blockquote class="font-body text-sm text-fg leading-relaxed">&ldquo;{r.quote}&rdquo;</blockquote>
              <figcaption class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-dim">
                {r.author} <span class="text-fg-faint">· via {r.source}</span>
              </figcaption>
              <div class="flex gap-2 pt-1">
                <button data-action="approve" class="key key-primary flex-1 py-3 disabled:opacity-40">Approve</button>
                <button data-action="reject" class="key flex-1 py-3 hover:!text-ch-production hover:!border-ch-production disabled:opacity-40">Reject</button>
              </div>
              <p class="row-msg hidden font-mono text-[11px] text-fg-dim"></p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Layout>

<script>
  const scope = document.querySelector<HTMLElement>('[data-token]');
  const token = scope?.dataset.token || '';

  document.querySelectorAll<HTMLElement>('.review-row').forEach((row) => {
    const id = row.dataset.id || '';
    const msg = row.querySelector<HTMLElement>('.row-msg');
    row.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.dataset.action;
        row.querySelectorAll('button').forEach((b) => (b.disabled = true));
        try {
          const res = await fetch('/api/moderate-review', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token, id, action }),
          });
          if (!res.ok) throw new Error();
          row.style.transition = 'opacity 0.3s';
          row.style.opacity = '0.35';
          if (msg) {
            msg.textContent = action === 'approve' ? 'Approved — now live.' : 'Rejected — removed.';
            msg.classList.remove('hidden');
          }
        } catch {
          row.querySelectorAll('button').forEach((b) => (b.disabled = false));
          if (msg) {
            msg.textContent = 'Failed. Try again.';
            msg.classList.remove('hidden');
          }
        }
      });
    });
  });
</script>
