---
import Layout from '../../layouts/Layout.astro';
import StepGrid from '../../components/StepGrid.astro';

export const prerender = false;

// Gate: the token in the URL must match the secret link token. Anything else
// 404s, so the page only exists for people holding the link you send out.
const { token } = Astro.params;
const linkToken = process.env.REVIEW_LINK_TOKEN;
if (!linkToken || token !== linkToken) {
  return new Response('Not found', { status: 404 });
}
---

<Layout
  title="Leave a Review | Node Production"
  description="Share your experience working with Node Production."
  noindex={true}
>
  <div class="w-full min-h-[70vh] flex flex-col items-center px-3 md:px-4 py-10 md:py-16 font-mono">
    <div class="w-full max-w-xl border border-line-strong bg-ground crop-marks">
      <div class="flex items-center justify-between px-4 md:px-6 py-3 border-b border-line-strong bg-panel">
        <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-fg-dim">Node // Feedback</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-fg-faint">Private</span>
      </div>

      <div class="px-4 md:px-8 py-8 md:py-10">
        <h1 class="t-display text-2xl md:text-3xl leading-tight tracking-[-0.02em]">
          Leave a<br />Review.
        </h1>
        <StepGrid fluid class="mt-6 max-w-xs" rows={['A...C.......C...']} />
        <p class="mt-6 font-body text-sm text-fg-muted leading-relaxed">
          Thanks for working with Node. A couple of lines on how it went means a lot &mdash; it goes live on the site once approved.
        </p>

        <form id="review-form" class="mt-8 flex flex-col gap-5" data-token={token}>
          <!-- Rating: five step cells -->
          <div>
            <span class="field-label">Rating</span>
            <div id="stars" class="flex gap-2" role="radiogroup" aria-label="Rating out of 5">
              {[1, 2, 3, 4, 5].map((v) => (
                <button type="button" data-star={v} aria-label={`${v} star${v > 1 ? 's' : ''}`}
                  class="star w-8 h-8 border border-cell-line"></button>
              ))}
            </div>
            <input type="hidden" name="rating" id="rating" value="5" />
          </div>

          <!-- Name -->
          <div>
            <label for="author" class="field-label">Name / Artist</label>
            <input id="author" name="author" type="text" maxlength="80" required class="field" />
          </div>

          <!-- Source -->
          <div>
            <label for="source" class="field-label">Where from (optional)</label>
            <input id="source" name="source" type="text" maxlength="40" placeholder="Direct" class="field" />
          </div>

          <!-- Review -->
          <div>
            <label for="quote" class="field-label">Your review</label>
            <textarea id="quote" name="quote" rows="5" maxlength="600" required class="field resize-y"></textarea>
          </div>

          <p id="review-error" class="hidden font-mono text-[11px] text-ch-production leading-relaxed"></p>

          <button type="submit" id="review-submit" class="key key-primary w-full py-4 text-[12px]">
            Submit Review
          </button>
        </form>

        <div id="review-success" class="hidden mt-8 flex-col items-start gap-4 py-6">
          <StepGrid rows={['ACCCCCCC']} arm />
          <p class="font-display text-xl font-extrabold uppercase tracking-[-0.02em] text-fg leading-tight">Thank you.</p>
          <p class="font-body text-sm text-fg-muted leading-relaxed max-w-xs">
            Your review has been sent. It will appear on the site once it&rsquo;s approved.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  if (form) {
    const token = form.dataset.token || '';
    const ratingInput = document.getElementById('rating') as HTMLInputElement;
    const stars = Array.from(document.querySelectorAll<HTMLElement>('.star'));
    const errorEl = document.getElementById('review-error') as HTMLElement;
    const submitBtn = document.getElementById('review-submit') as HTMLButtonElement;
    const successEl = document.getElementById('review-success') as HTMLElement;

    // Rating cells fill cream up to the chosen value.
    function paint(value: number) {
      stars.forEach((s, idx) => {
        const on = idx < value;
        s.classList.toggle('bg-fg', on);
        s.classList.toggle('border-fg', on);
        s.classList.toggle('border-cell-line', !on);
      });
    }
    stars.forEach((s) => {
      const v = Number(s.dataset.star);
      s.addEventListener('mouseenter', () => paint(v));
      s.addEventListener('click', () => { ratingInput.value = String(v); paint(v); });
    });
    document.getElementById('stars')?.addEventListener('mouseleave', () => paint(Number(ratingInput.value)));
    paint(Number(ratingInput.value));

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const data = new FormData(form);
      try {
        const res = await fetch('/api/submit-review', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            token,
            author: String(data.get('author') || ''),
            source: String(data.get('source') || ''),
            quote: String(data.get('quote') || ''),
            rating: Number(data.get('rating') || 0),
          }),
        });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok) {
          showError(payload.error || 'Something went wrong. Please try again.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Review';
          return;
        }
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
        successEl.classList.add('flex');
      } catch {
        showError('Network error. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Review';
      }
    });
  }
</script>
