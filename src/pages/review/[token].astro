---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Gate: the token in the URL must match the secret link token. Anything else
// 404s, so the page only exists for people holding the link you send out.
const { token } = Astro.params;
const linkToken = process.env.REVIEW_LINK_TOKEN;
if (!linkToken || token !== linkToken) {
  return new Response('Not found', { status: 404 });
}
---

<Layout
  title="Leave a Review | Node Production"
  description="Share your experience working with Node Production."
  noindex={true}
>
  <div class="w-full min-h-[70vh] flex flex-col items-center px-3 md:px-4 py-10 md:py-16 font-mono">
    <div class="w-full max-w-lg border border-line-strong bg-base">
      <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line-strong bg-panel">
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Feedback</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Private</span>
      </div>

      <div class="px-4 md:px-8 py-7 md:py-9">
        <h1 class="font-display font-bold uppercase leading-[0.95] tracking-tight text-fg text-[9vw] md:text-4xl">
          Leave a<br /><span class="text-accent">Review.</span>
        </h1>
        <p class="mt-4 font-body text-sm text-fg-muted leading-relaxed">
          Thanks for working with Node. A couple of lines on how it went means a lot &mdash; it goes live on the site once approved.
        </p>

        <form id="review-form" class="mt-7 flex flex-col gap-5" data-token={token}>
          <!-- Rating -->
          <div class="flex flex-col gap-2">
            <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Rating</span>
            <div id="stars" class="flex gap-1.5 text-2xl" role="radiogroup" aria-label="Rating out of 5">
              {[1, 2, 3, 4, 5].map((v) => (
                <button type="button" data-star={v} aria-label={`${v} star${v > 1 ? 's' : ''}`}
                  class="star text-fg-faint/40 hover:text-accent transition-colors outline-none focus-visible:ring-1 focus-visible:ring-accent leading-none">&#9733;</button>
              ))}
            </div>
            <input type="hidden" name="rating" id="rating" value="5" />
          </div>

          <!-- Name -->
          <div class="flex flex-col gap-2">
            <label for="author" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Name / Artist</label>
            <input id="author" name="author" type="text" maxlength="80" required
              class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors" />
          </div>

          <!-- Source -->
          <div class="flex flex-col gap-2">
            <label for="source" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Where from (optional)</label>
            <input id="source" name="source" type="text" maxlength="40" placeholder="Direct"
              class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors" />
          </div>

          <!-- Review -->
          <div class="flex flex-col gap-2">
            <label for="quote" class="font-mono text-[9px] uppercase tracking-[0.25em] text-fg-faint">Your review</label>
            <textarea id="quote" name="quote" rows="5" maxlength="600" required
              class="w-full bg-base border border-line-strong px-4 py-3 text-accent font-mono text-xs tracking-wider outline-none focus:border-accent transition-colors resize-y"></textarea>
          </div>

          <p id="review-error" class="hidden font-mono text-[10px] text-red-400 leading-relaxed"></p>

          <button type="submit" id="review-submit"
            class="w-full py-4 bg-accent-dim text-white font-mono font-black text-[12px] uppercase tracking-[0.3em] hover:bg-accent active:translate-y-px transition-all disabled:opacity-50 disabled:cursor-not-allowed">
            Submit Review
          </button>
        </form>

        <div id="review-success" class="hidden mt-7 flex-col items-center text-center gap-3 py-6">
          <div class="text-4xl text-accent leading-none">&#10003;</div>
          <p class="font-display text-xl font-bold text-fg">Thank you.</p>
          <p class="font-body text-sm text-fg-muted leading-relaxed max-w-xs">
            Your review has been sent. It will appear on the site once it&rsquo;s approved.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  if (form) {
    const token = form.dataset.token || '';
    const ratingInput = document.getElementById('rating') as HTMLInputElement;
    const stars = Array.from(document.querySelectorAll<HTMLElement>('.star'));
    const errorEl = document.getElementById('review-error') as HTMLElement;
    const submitBtn = document.getElementById('review-submit') as HTMLButtonElement;
    const successEl = document.getElementById('review-success') as HTMLElement;

    function paint(value: number) {
      stars.forEach((s, idx) => {
        s.classList.toggle('text-accent', idx < value);
        s.classList.toggle('text-fg-faint/40', idx >= value);
      });
    }
    stars.forEach((s) => {
      const v = Number(s.dataset.star);
      s.addEventListener('mouseenter', () => paint(v));
      s.addEventListener('click', () => { ratingInput.value = String(v); paint(v); });
    });
    document.getElementById('stars')?.addEventListener('mouseleave', () => paint(Number(ratingInput.value)));
    paint(Number(ratingInput.value));

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const data = new FormData(form);
      try {
        const res = await fetch('/api/submit-review', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            token,
            author: String(data.get('author') || ''),
            source: String(data.get('source') || ''),
            quote: String(data.get('quote') || ''),
            rating: Number(data.get('rating') || 0),
          }),
        });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok) {
          showError(payload.error || 'Something went wrong. Please try again.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Review';
          return;
        }
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
        successEl.classList.add('flex');
      } catch {
        showError('Network error. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Review';
      }
    });
  }
</script>
