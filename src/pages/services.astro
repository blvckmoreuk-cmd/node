---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Production',
    tagline: 'Composition & Arrangement',
    wire: 'bg-red-500',
    glow: 'shadow-[0_0_8px_rgba(239,68,68,0.9)]',
    description: 'Bring a half-finished idea or a blank session. We handle composition, arrangement and sound selection to get it to a mix-ready stage — from a Finish Your Track service up to a fully exclusive, royalty-free Ghost Production.',
    fromLabel: 'From',
    price: '£120',
    note: 'Ghost Production from £250',
  },
  {
    title: 'Mixing',
    tagline: 'Balance & Sonic Clarity',
    wire: 'bg-blue-500',
    glow: 'shadow-[0_0_8px_rgba(59,130,246,0.9)]',
    description: 'Stems mixed and balanced into a cohesive, club-ready record — gain staging, EQ, dynamics and spatial placement, mastered to finish. Priced by stem count.',
    fromLabel: 'From',
    price: '£50',
    note: '10 stems · scales up to 30+',
  },
  {
    title: 'Mastering',
    tagline: 'Industry Standard Loudness',
    wire: 'bg-yellow-400',
    glow: 'shadow-[0_0_8px_rgba(250,204,21,0.9)]',
    description: 'A final master on an already-mixed track: loudness, tonal balance and translation across systems, brought up to commercial release standard. Discounted per-track rate for EPs.',
    fromLabel: 'From',
    price: '£20',
    note: 'per track (EP rate) · £30 single track',
  },
  {
    title: 'Education',
    tagline: '1-on-1 Ableton Mentoring',
    wire: 'bg-green-500',
    glow: 'shadow-[0_0_8px_rgba(34,197,94,0.9)]',
    description: 'One-to-one sessions covering Ableton workflow, sound design fundamentals, or a technical breakdown of your own session. Book a single call or an ongoing run of lessons.',
    fromLabel: 'From',
    price: '£25',
    note: 'per hour · technical analysis call from £40',
  },
  {
    title: 'Sound Design',
    tagline: 'Custom Patch Creation',
    wire: 'bg-purple-500',
    glow: 'shadow-[0_0_8px_rgba(168,85,247,0.9)]',
    description: 'Bespoke patches, racks and one-shots built around your reference. Looking for something off-the-shelf instead? Sample packs, stock FX racks and clutter-free VST presets are available as fixed-price tools.',
    fromLabel: '',
    price: 'Enquire',
    note: 'tools from £5',
  },
  {
    title: 'Consulting',
    tagline: 'Career Strategy',
    wire: 'bg-orange-500',
    glow: 'shadow-[0_0_8px_rgba(249,115,22,0.9)]',
    description: 'A focused session to talk through release strategy, label targeting, or your next move. Bring questions, leave with a plan.',
    fromLabel: 'From',
    price: '£40',
    note: 'per session',
  },
];
---

<Layout>
  <main class="w-full min-h-screen bg-[#050608] flex flex-col items-center px-4 py-16 font-mono text-[#94a3b8]">

    <div class="w-full max-w-4xl">

      <a href="/" class="text-[9px] uppercase tracking-[0.2em] text-[#52555c] hover:text-[#10b981] mb-12 block transition-colors">
        &larr; Back to Home
      </a>

      <div class="mb-14 text-center">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
          <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-[#52555c]">Services</span>
        </div>
        <h1 class="text-xl font-black uppercase tracking-[0.3em] text-[#10b981] mb-2">What We Offer</h1>
        <p class="text-[10px] uppercase tracking-widest text-[#52555c] max-w-md mx-auto">
          Six disciplines, one studio. Pick a service below, or send a track and we'll point you to the right one.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        {services.map((service) => (
          <div class="bg-[#0a0c0f] border border-[#14171c] rounded-lg p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-5 md:gap-8">

            <div class="flex items-center gap-4 md:w-60 shrink-0">
              <div class="w-9 h-9 rounded-full bg-[#0d1014] border border-[#171c22] shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)] flex items-center justify-center shrink-0">
                <div class={`w-2 h-2 rounded-full ${service.wire} ${service.glow}`}></div>
              </div>
              <div>
                <h2 class="text-[12px] font-black uppercase tracking-[0.2em] text-[#e7e7ea]">{service.title}</h2>
                <p class="text-[9px] uppercase tracking-widest text-[#52555c] mt-0.5">{service.tagline}</p>
              </div>
            </div>

            <p class="flex-1 text-[13px] leading-relaxed text-[#94a3b8]">{service.description}</p>

            <div class="flex flex-row md:flex-col items-baseline md:items-end justify-between md:justify-start gap-1 md:w-36 shrink-0 md:text-right border-t md:border-t-0 border-[#14171c] pt-4 md:pt-0">
              <div>
                {service.fromLabel && (
                  <span class="text-[9px] uppercase tracking-widest text-[#52555c] mr-1.5">{service.fromLabel}</span>
                )}
                <span class="text-base font-black text-[#10b981]">{service.price}</span>
                <p class="text-[8px] uppercase tracking-widest text-[#52555c] mt-0.5">{service.note}</p>
              </div>
            </div>

          </div>
        ))}
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-4 border-t border-[#14171c] pt-12">
        <a href="/prices"
           class="px-8 py-3 bg-[#171c22] border border-[#252c36] text-[#64748b] font-black text-[10px] uppercase tracking-[0.25em] rounded-sm hover:border-[#10b981] hover:text-[#10b981] transition-all">
          Full Price List
        </a>
        <a href="/contact"
           class="px-8 py-3 bg-[#10b981] text-[#050608] font-black text-[10px] uppercase tracking-[0.25em] rounded-sm border border-[#064e3b] shadow-[0_4px_12px_rgba(16,185,129,0.3)] hover:bg-[#059669] transition-all">
          Get Started
        </a>
      </div>

    </div>
  </main>
</Layout>