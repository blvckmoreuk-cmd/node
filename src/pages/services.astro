---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceModal from '../components/ServiceModal.astro';
import { services } from '../data/services';
---

<Layout>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-mono">
    <SectionFrame max="max-w-4xl">

      <!-- Masthead -->
      <header class="border-b border-line-strong">
        <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-line">
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Node // Services</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-fg-faint">Six disciplines</span>
        </div>
        <div class="px-4 md:px-8 py-8 md:py-11">
          <h1 class="font-display font-bold uppercase leading-[0.9] tracking-tight text-fg text-[11vw] md:text-[3.75rem]">
            What we<br /><span class="text-accent">offer.</span>
          </h1>
          <p class="mt-5 font-body text-sm text-fg-muted max-w-md leading-relaxed">
            Six disciplines, one studio. Tap a service for the full brief, or send a track and we will point you to the right one.
          </p>
        </div>
      </header>

      <!-- Signal chain -->
      <section class="border-b border-line-strong">
        <SectionHeader num="02" label="Services / Signal Chain">
          <span slot="meta" class="text-fg-faint font-mono text-[9px] uppercase tracking-[0.2em]">Tap a card</span>
        </SectionHeader>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-line-strong">
          {services.map((service) => (
            <button
              type="button"
              class="service-card group bg-panel p-6 flex flex-col gap-4 text-left cursor-pointer outline-none focus-visible:ring-1 focus-visible:ring-accent hover:bg-inset transition-colors"
              data-num={service.num}
              data-title={service.title}
              data-tagline={service.tagline}
              data-detail={service.detail}
              data-price={service.price}
              data-note={service.note}
              data-revisions={service.revisions}
              data-hex={service.hex}
              data-reqs={JSON.stringify(service.reqs)}
              aria-haspopup="dialog"
            >
              <div class="flex items-start justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-black border border-line-strong shadow-[inset_0_2px_4px_rgba(0,0,0,0.9)] flex items-center justify-center shrink-0">
                    <div class={`w-2 h-2 rounded-full ${service.wire} ${service.glow}`}></div>
                  </div>
                  <div>
                    <h2 class="font-display text-base font-bold uppercase tracking-tight text-fg leading-none">{service.title}</h2>
                    <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint">{service.tagline}</p>
                  </div>
                </div>
                <span class="font-display text-lg font-bold text-fg-faint/30 leading-none">{service.num}</span>
              </div>
              <p class="font-body text-[13px] leading-relaxed text-fg-muted flex-1">{service.detail}</p>
              {service.revisions && (
                <p class="font-mono text-[9px] uppercase tracking-[0.15em] text-accent">&#8635; {service.revisions}</p>
              )}
              <div class="flex items-end justify-between border-t border-line pt-3">
                <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-fg-faint group-hover:text-accent transition-colors">Details &rarr;</span>
                <span class="font-display text-xl font-bold text-accent leading-none">{service.price}</span>
              </div>
            </button>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="flex flex-col sm:flex-row items-stretch">
        <a href="/prices" class="flex-1 text-center px-6 py-5 bg-panel border-b sm:border-b-0 sm:border-r border-line-strong text-fg-muted font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:text-accent hover:border-accent transition-colors">
          Full Price List
        </a>
        <a href="/contact" class="flex-1 text-center px-6 py-5 bg-accent text-base font-mono font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-accent-bright transition-colors">
          Start a Project
        </a>
      </section>

    </SectionFrame>
  </div>

  <ServiceModal />
</Layout>
