---
import Layout from '../layouts/Layout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import ProductModal from '../components/ProductModal.astro';
import { products, categories } from '../data/products';

const catById = Object.fromEntries(categories.map((c) => [c.id, c]));
const tabs = [{ id: 'all', label: 'All' }, ...categories.map((c) => ({ id: c.id, label: c.label }))];
---

<Layout
  title="Shop | VSTs, Sample Packs & Racks — Node Production"
  description="Digital goods from the Node Production studio: VSTs, FX racks, Ableton templates and sample packs for dance music producers."
>
  <div class="w-full flex flex-col items-center px-3 md:px-4 py-6 md:py-12 font-body">
    <SectionFrame>

      <PageHero>
        <Fragment slot="title">The<br />store.</Fragment>
        VSTs, racks, templates and sample packs from the studio. Instant downloads coming soon &mdash; browse the shelf below.
      </PageHero>

      <!-- Filter tabs: a row of step keys. The selected filter is the armed step. -->
      <div class="flex flex-wrap gap-px bg-line-strong border-b border-line-strong" role="group" aria-label="Filter products">
        {tabs.map((tab, i) => (
          <button
            type="button"
            class={`shop-tab flex-1 min-w-[33%] sm:min-w-0 px-4 py-3.5 font-body text-base font-medium hover:text-fg ${i === 0 ? 'bg-fg text-accent-ink hover:text-accent-ink' : 'bg-ground text-fg-dim hover:bg-panel'}`}
            data-tab={tab.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Product grid -->
      <section class="border-b border-line-strong">
        <SectionHeader label="Products" />
        <div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 gap-px bg-line-strong">
          {products.map((product) => {
            const cat = catById[product.category];
            return (
              <button
                type="button"
                class="product-card group bg-ground p-6 md:p-7 flex flex-col gap-5 text-left cursor-pointer outline-none focus-visible:outline-accent hover:bg-panel relative"
                style={`--ch:${cat?.hex}`}
                data-category={product.category}
                data-num={product.num}
                data-title={product.title}
                data-tagline={product.tagline}
                data-detail={product.detail}
                data-price={product.price}
                data-note={product.priceNote}
                data-hex={cat?.hex}
                data-image={product.image}
                data-preview={product.preview}
                data-features={JSON.stringify(product.features)}
                data-meta={JSON.stringify(product.meta)}
                aria-haspopup="dialog"
              >
                <div class="aspect-[16/10] w-full bg-inset border border-cell-line relative overflow-hidden flex items-center justify-center">
                  {product.image
                    ? <img src={product.image} alt={product.title} class="w-full h-full object-contain" loading="lazy" />
                    : <span class="font-body text-sm text-fg-faint">Cover art</span>}
                </div>
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-3">
                    <span class="block w-3 h-3 mt-1 shrink-0 border group-hover:bg-(--ch)" style="border-color: var(--ch)" aria-hidden="true"></span>
                    <div>
                      <h2 class="t-h3">{product.title}</h2>
                      <p class="mt-2 font-body text-sm text-fg-dim">{product.tagline}</p>
                    </div>
                  </div>
                  {product.badge && <span class="font-body text-sm font-medium text-fg border border-fg-dim px-2 py-1 leading-none shrink-0">{product.badge}</span>}
                </div>
                <p class="font-body text-base leading-relaxed text-fg-muted flex-1">{product.detail}</p>
                <p class="t-note">{cat?.label}</p>
                <div class="flex items-end justify-between border-t border-line pt-4">
                  <span class="font-body text-sm text-fg-dim group-hover:text-fg group-hover:underline group-focus-visible:underline underline-offset-4">View</span>
                  <span class="font-display text-[1.375rem] font-bold tracking-[-0.02em] text-fg leading-none">{product.price}</span>
                </div>
              </button>
            );
          })}
        </div>
        <!-- Empty state: shown when a filter matches no products -->
        <div id="shop-empty" class="hidden bg-ground px-6 py-14 text-center">
          <p class="font-body text-base text-fg-dim">Nothing here yet &mdash; more coming soon.</p>
        </div>
      </section>

      <!-- CTA -->
      <section class="flex flex-col sm:flex-row items-stretch gap-px bg-line-strong">
        <a href="/services/" class="key flex-1 py-5 !border-0 bg-ground hover:bg-panel">
          Studio services
        </a>
        <a href="/contact/"class="key key-primary flex-1 py-5 !border-0">
          Custom request
        </a>
      </section>

    </SectionFrame>
  </div>

  <ProductModal />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLElement>('.shop-tab');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    const empty = document.getElementById('shop-empty');

    function applyFilter(id: string) {
      let visible = 0;
      cards.forEach((card) => {
        const show = id === 'all' || card.dataset.category === id;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-pressed', active ? 'true' : 'false');
          t.classList.toggle('bg-fg', active);
          t.classList.toggle('text-accent-ink', active);
          t.classList.toggle('hover:text-accent-ink', active);
          t.classList.toggle('bg-ground', !active);
          t.classList.toggle('text-fg-dim', !active);
          t.classList.toggle('hover:bg-panel', !active);
        });
        applyFilter(tab.dataset.tab || 'all');
      });
    });
  });
</script>
